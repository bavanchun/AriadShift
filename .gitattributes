* text=auto eol=lf
# Generated by cargo-about; some upstream license texts use CRLF, and
# licenses-check compares the bytes exactly.
THIRD_PARTY_LICENSES -text
fixtures/** -text
fixtures/gen/**/*.py text eol=lf
fixtures/gen/**/*.md text eol=lf
fixtures/gen/**/*.toml text eol=lf
fixtures/manifest.toml text eol=lf
*.snap text eol=lf
*.docx binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.djvu binary
*.ttf binary
*.otf binary
*.woff2 binary

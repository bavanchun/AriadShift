              "description": "Top-to-bottom, left-to-right column-major order.",
              "type": "string"
            }
          ]
        },
        "MarginSides": {
          "additionalProperties": false,
          "description": "Explicit per-side margins in PDF points (`top`, `right`, `bottom`, `left`).",
          "properties": {
            "bottom": {
              "description": "Bottom margin in PDF points (`>= 0`).",
              "format": "double",
              "maximum": 100000.0,
              "minimum": 0.0,
              "type": "number"
            },
            "left": {
              "description": "Left margin in PDF points (`>= 0`).",
              "format": "double",
              "maximum": 100000.0,

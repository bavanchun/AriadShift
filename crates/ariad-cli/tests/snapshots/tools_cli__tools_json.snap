  {
    "engine": "ariad-pdf",
    "group": "security",
    "id": "pdf.sanitize",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "SanitizeForms": {
          "description": "Form handling when sanitizing a document.",
          "oneOf": [
            {
              "const": "keep",
              "description": "Preserve forms.",
              "type": "string"
            },
            {
              "const": "flatten",
              "description": "Flatten forms into page content.",
              "type": "string"
            },
            {
              "const": "remove",
              "description": "Remove forms.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.sanitize`.",
      "properties": {
        "annotations_of_type": {
          "default": [],
          "description": "Annotation subtype names, without a slash and containing ASCII letters only.",
          "items": {
            "pattern": "^[A-Za-z]+$",
            "type": "string"
          },
          "type": "array"
        },
        "embedded_files": {
          "default": true,
          "description": "Remove embedded files.",
          "type": "boolean"

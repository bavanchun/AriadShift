---
source: crates/ariad-cli/tests/tools_cli.rs
expression: tools_json
---
[
  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.info",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "json",
    "params_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.info`.\n\n`pdf.info` takes no parameters (`{}`) and rejects any unknown fields.",
      "title": "InfoParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Inspect PDF version, page count, encryption status, geometry, metadata, and structural features.",
    "tier": "free",
    "version": "1"
  },
  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.merge",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "many",
      "max": 500,
      "min": 2
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "MergeOutlineMode": {
          "description": "Outline (bookmark) handling strategy when merging multiple PDFs (`pdf.merge`).",
          "oneOf": [
            {
              "const": "keep",
              "description": "Preserve existing bookmark trees from each input file with updated destination offsets.",
              "type": "string"
            },
            {
              "const": "per-file",
              "description": "Create one top-level bookmark entry per input file titled with the input file stem.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Omit outlines from the merged document.",
              "type": "string"
            }
          ]
        },
        "MergePageLabelsMode": {
          "description": "Page label handling strategy when merging multiple PDFs (`pdf.merge`).",
          "oneOf": [
            {
              "const": "keep",
              "description": "Preserve per-document `/PageLabels` number trees at each input file's starting page offset.",
              "type": "string"
            },
            {
              "const": "renumber",
              "description": "Renumber pages sequentially from `1` across the merged document.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.merge`.",
      "properties": {
        "outline": {
          "$ref": "#/$defs/MergeOutlineMode",
          "default": "per-file",
          "description": "How bookmarks (`/Outlines`) from the input files are combined (`\"per-file\"` by default)."
        },
        "page_labels": {
          "$ref": "#/$defs/MergePageLabelsMode",
          "default": "renumber",
          "description": "How `/PageLabels` are combined across inputs (`\"renumber\"` by default)."
        }
      },
      "title": "MergeParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Merge two or more PDF documents into a single PDF.",
    "tier": "free",
    "version": "1"
  },
  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.split",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "SplitDetectMode": {
          "description": "Blank-separator detection strategy for `pdf.split` when `mode == \"blank-separator\"`.",
          "oneOf": [
            {
              "const": "content",
              "description": "In-process structural content-stream inspection (`ariad-pdf`).",
              "type": "string"
            },
            {
              "const": "pixel",
              "description": "Out-of-process grayscale raster white-ratio detection (`pdfium` engine).",
              "type": "string"
            }
          ]
        },
        "SplitMode": {
          "description": "Splitting strategy for `pdf.split`.",
          "oneOf": [
            {
              "const": "ranges",
              "description": "Split into one output PDF per page range in `ranges`.",
              "type": "string"
            },
            {
              "const": "every",
              "description": "Split into chunks of `every` consecutive pages.",
              "type": "string"
            },
            {
              "const": "bookmarks",
              "description": "Split at top-level or `level`-depth bookmark (`/Outlines`) boundaries.",
              "type": "string"
            },
            {
              "const": "size",
              "description": "Split so each output chunk stays at or below `max_bytes`.",
              "type": "string"
            },
            {
              "const": "blank-separator",
              "description": "Split on blank separator pages.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.split`.",
      "properties": {
        "blank_threshold": {
          "description": "Optional content-emptiness threshold (`0.0..=1.0`) when `mode == \"blank-separator\"`.",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "detect": {
          "$ref": "#/$defs/SplitDetectMode",
          "default": "content",
          "description": "Blank-separator detection strategy (`\"content\"` in-process or `\"pixel\"` via `pdfium`)."
        },
        "dpi": {
          "description": "Optional raster DPI (`36..=600`) when `detect == \"pixel\"`.",
          "format": "uint32",
          "maximum": 600,
          "minimum": 36,
          "type": [
            "integer",
            "null"
          ]
        },
        "every": {
          "description": "Number of pages per output chunk when `mode == \"every\"` (`>= 1`).",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "level": {
          "description": "Outline hierarchy depth (`>= 1`) when `mode == \"bookmarks\"`.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_bytes": {
          "description": "Target maximum byte size per output part when `mode == \"size\"` (`>= 1`).",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/SplitMode",
          "default": "ranges",
          "description": "Splitting mode (`\"ranges\"`, `\"every\"`, `\"bookmarks\"`, `\"size\"`, or `\"blank-separator\"`)."
        },
        "ranges": {
          "description": "Explicit 1-based page ranges when `mode == \"ranges\"`.",
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "threshold": {
          "description": "Optional white-pixel ratio threshold in `(0.0, 1.0]` when `detect == \"pixel\"`.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "title": "SplitParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Split a PDF document into multiple part PDFs by page ranges, interval, bookmarks, size, or blank separators.",
    "tier": "free",
    "version": "1"
  },

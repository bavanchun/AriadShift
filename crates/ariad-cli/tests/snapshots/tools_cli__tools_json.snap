          "default": "row",
          "description": "Grid cell filling order (`\"row\"` by default, or `\"column\"`)."
        },
        "per_sheet": {
          "default": 2,
          "description": "Number of input pages placed on each output sheet (`2` by default; `2 | 4 | 6 | 8 | 9 | 16`).",
          "enum": [

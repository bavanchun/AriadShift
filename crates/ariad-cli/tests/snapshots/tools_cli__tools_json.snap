  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.insert_blank",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "BlankPageSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/SamePageSize",
              "description": "Match the dimensions of the page after which the blank page is inserted."
            },
            {
              "$ref": "#/$defs/PaperSize",
              "description": "Explicit standard or custom paper dimensions."
            }
          ],
          "description": "Blank page size specification for `pdf.insert_blank`: `\"same\"` or a [`PaperSize`]."
        },
        "CustomPaperSize": {
          "additionalProperties": false,
          "description": "Custom paper size specified as `{ w, h }` in PDF points (`1 pt = 1/72 inch`).",
          "properties": {
            "h": {
              "description": "Page height in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            },
            "w": {
              "description": "Page width in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            }
          },
          "required": [
            "w",
            "h"
          ],
          "type": "object"
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "PaperSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardPaper",
              "description": "Named standard paper size (`\"A0\"`..`\"A6\"`, `\"Letter\"`, `\"Legal\"`, `\"Tabloid\"`, `\"Ledger\"`)."
            },
            {
              "$ref": "#/$defs/CustomPaperSize",
              "description": "Custom paper dimensions `{ w, h }` in PDF points."
            }
          ],
          "description": "Paper size specification: either a named standard paper (`\"A4\"`, `\"Letter\"`, etc.) or custom\n`{ w, h }` dimensions in PDF points."
        },
        "SamePageSize": {
          "description": "Marker variant for matching the adjacent page's size (`\"same\"`).",
          "oneOf": [
            {
              "const": "same",
              "description": "Match the width and height of the reference page.",
              "type": "string"
            }
          ]
        },
        "StandardPaper": {
          "description": "Named ISO and North American standard paper sizes (`docs/tools.md`).",
          "oneOf": [
            {
              "const": "A0",
              "description": "ISO A0 (`2383.94 × 3370.39 pt`, `841 × 1189 mm`).",
              "type": "string"
            },
            {
              "const": "A1",
              "description": "ISO A1 (`1683.78 × 2383.94 pt`, `594 × 841 mm`).",
              "type": "string"
            },
            {
              "const": "A2",
              "description": "ISO A2 (`1190.55 × 1683.78 pt`, `420 × 594 mm`).",
              "type": "string"
            },
            {
              "const": "A3",
              "description": "ISO A3 (`841.89 × 1190.55 pt`, `297 × 420 mm`).",
              "type": "string"
            },
            {
              "const": "A4",
              "description": "ISO A4 (`595.28 × 841.89 pt`, `210 × 297 mm`).",
              "type": "string"
            },
            {
              "const": "A5",
              "description": "ISO A5 (`419.53 × 595.28 pt`, `148 × 210 mm`).",
              "type": "string"
            },
            {
              "const": "A6",
              "description": "ISO A6 (`297.64 × 419.53 pt`, `105 × 148 mm`).",
              "type": "string"
            },
            {
              "const": "Letter",
              "description": "US Letter (`612.0 × 792.0 pt`, `8.5 × 11 in`).",
              "type": "string"
            },
            {
              "const": "Legal",
              "description": "US Legal (`612.0 × 1008.0 pt`, `8.5 × 14 in`).",
              "type": "string"
            },
            {
              "const": "Tabloid",
              "description": "US Tabloid (`792.0 × 1224.0 pt`, `11 × 17 in` portrait).",
              "type": "string"
            },
            {
              "const": "Ledger",
              "description": "US Ledger (`1224.0 × 792.0 pt`, `17 × 11 in` landscape).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.insert_blank`.",
      "properties": {
        "after": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages after which to insert blank pages (`\"all\"` by default)."
        },
        "count": {
          "default": 1,
          "description": "Number of blank pages to insert at each selected position (`1` by default, `>= 1`).",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/BlankPageSize",
          "default": "same",
          "description": "Blank page dimensions (`\"same\"` by default, or a named/custom paper size)."
        }
      },
      "title": "InsertBlankParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Insert blank pages of matching or specified paper size after selected PDF pages.",
    "tier": "free",
    "version": "1"
  },

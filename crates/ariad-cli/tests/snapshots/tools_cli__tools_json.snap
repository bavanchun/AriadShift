    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "ViewerPageLayout": {
          "description": "Catalog `/PageLayout` setting for `pdf.viewer_prefs`.",
          "oneOf": [
            {
              "const": "single-page",
              "description": "Display one page at a time (`/SinglePage`).",
              "type": "string"
            },
            {
              "const": "one-column",
              "description": "Display the pages in one continuous column (`/OneColumn`).",
              "type": "string"
            },
            {
              "const": "two-column-left",
              "description": "Display the pages in two columns, with odd-numbered pages on the left (`/TwoColumnLeft`).",
              "type": "string"
            },
            {
              "const": "two-column-right",
              "description": "Display the pages in two columns, with odd-numbered pages on the right (`/TwoColumnRight`).",
              "type": "string"
            },
            {
              "const": "two-page-left",
              "description": "Display two pages at a time, with odd-numbered pages on the left (`/TwoPageLeft`).",
              "type": "string"
            },
            {
              "const": "two-page-right",
              "description": "Display two pages at a time, with odd-numbered pages on the right (`/TwoPageRight`).",
              "type": "string"
            }
          ]
        },
        "ViewerPageMode": {
          "description": "Catalog `/PageMode` setting for `pdf.viewer_prefs`.",
          "oneOf": [
            {
              "const": "use-none",
              "description": "Neither document outline nor thumbnail images visible (`/UseNone`).",
              "type": "string"
            },
            {
              "const": "use-outlines",
              "description": "Document outline (bookmarks) visible (`/UseOutlines`).",
              "type": "string"
            },
            {
              "const": "use-thumbs",
              "description": "Thumbnail images visible (`/UseThumbs`).",
              "type": "string"
            },
            {
              "const": "full-screen",
              "description": "Full-screen mode (`/FullScreen`).",
              "type": "string"
            },
            {
              "const": "use-oc",
              "description": "Optional content group (layers) panel visible (`/UseOC`).",
              "type": "string"
            },
            {
              "const": "use-attachments",
              "description": "Attachments panel visible (`/UseAttachments`).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.viewer_prefs`.",
      "properties": {
        "display_doc_title": {
          "description": "Whether the window title bar should display the document `/Title` (`/ViewerPreferences /DisplayDocTitle`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fit_window": {
          "description": "Whether to resize the document window to fit the first page (`/ViewerPreferences /FitWindow`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "hide_toolbar": {
          "description": "Whether to hide the viewer application's toolbars (`/ViewerPreferences /HideToolbar`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "open_page": {
          "description": "1-based page number to open initially (`/OpenAction` destination, `>= 1`).",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "page_layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewerPageLayout"
            },
            {
              "type": "null"
            }
          ],
          "description": "Initial page layout (`/PageLayout` on the Catalog)."
        },
        "page_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewerPageMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Initial navigation panel mode (`/PageMode` on the Catalog)."

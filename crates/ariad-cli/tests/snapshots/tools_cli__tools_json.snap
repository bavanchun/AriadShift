    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.rotate_content`.",
      "properties": {
        "angle_deg": {
          "description": "Arbitrary rotation angle in degrees (`-360.0..=360.0`).",
          "format": "float",
          "maximum": 360.0,
          "minimum": -360.0,
          "type": "number"
        },
        "expand": {
          "default": true,
          "description": "Whether to expand the page `/MediaBox` so rotated corners are not clipped (`true` by default).",
          "type": "boolean"
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages whose content streams should be rotated (`\"all\"` by default)."
        }
      },
      "required": [
        "angle_deg"
      ],
      "title": "RotateContentParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Rotate PDF page content by an arbitrary angle using a Form XObject and transform matrix.",
    "tier": "free",
    "version": "1"
  },
  {
    "engine": "ariad-pdf",
    "group": "optimize",
    "id": "pdf.decompress",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "ObjectStreamsMode": {
          "description": "How compressed object streams (`/Type /ObjStm`) are handled by `pdf.decompress`.",
          "oneOf": [
            {
              "const": "keep",
              "description": "Keep object stream grouping if present.",
              "type": "string"
            },
            {
              "const": "expand",
              "description": "Expand all compressed object streams into top-level indirect objects (`\"expand\"`, default).",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.decompress`.",
      "properties": {
        "object_streams": {
          "$ref": "#/$defs/ObjectStreamsMode",
          "default": "expand",
          "description": "Whether to expand `/ObjStm` object streams (`\"expand\"` by default)."
        },
        "pages": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional 1-based page selection whose streams should be decompressed (all streams when omitted)."
        }
      },
      "title": "DecompressParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Decompress PDF streams and expand object streams within decoded-size limits.",
    "tier": "free",
    "version": "1"
  },

  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.crop",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "CropAutoMode": {
          "description": "Deferred whitespace auto-crop preset (`\"trim-whitespace-later\"`).",
          "oneOf": [
            {
              "const": "trim-whitespace-later",
              "description": "Placeholder marker for rendering-based whitespace auto-crop.",
              "type": "string"
            }
          ]
        },
        "CropBoxSpec": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropRect",
              "description": "Explicit rectangle `{ left, bottom, right, top }` in PDF points."
            },
            {
              "$ref": "#/$defs/CropAutoMode",
              "description": "Rendering-dependent auto-crop preset (`\"trim-whitespace-later\"`)."
            }
          ],
          "description": "Crop box specification for `pdf.crop`: explicit `{ left, bottom, right, top }` or\n`\"trim-whitespace-later\"`."
        },
        "CropRect": {
          "additionalProperties": false,
          "description": "Explicit crop rectangle coordinates `{ left, bottom, right, top }` in PDF points.",
          "properties": {
            "bottom": {
              "description": "Bottom coordinate (`lly`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "left": {
              "description": "Left coordinate (`llx`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "right": {
              "description": "Right coordinate (`urx`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "top": {
              "description": "Top coordinate (`ury`) in PDF points.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "left",
            "bottom",
            "right",
            "top"
          ],
          "type": "object"
        },
        "CropTarget": {
          "description": "Target PDF page box updated by `pdf.crop`.",
          "oneOf": [
            {
              "const": "crop",
              "description": "Update `/CropBox` (`\"crop\"`, default).",
              "type": "string"
            },
            {
              "const": "media",
              "description": "Update `/MediaBox` (and clamp `/CropBox` to match).",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.crop`.",
      "properties": {
        "box": {
          "$ref": "#/$defs/CropBoxSpec",
          "description": "Crop box coordinates in PDF points or `\"trim-whitespace-later\"`."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to crop (`\"all\"` by default)."
        },
        "target": {
          "$ref": "#/$defs/CropTarget",
          "default": "crop",
          "description": "Target page box to set (`\"crop\"` by default, or `\"media\"`)."
        }
      },
      "required": [
        "box"
      ],
      "title": "CropParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Set the CropBox or MediaBox of selected PDF pages in points.",
    "tier": "free",
    "version": "1"
  },

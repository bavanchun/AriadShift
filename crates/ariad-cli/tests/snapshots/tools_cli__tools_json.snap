            "copy": true,
            "extract_accessibility": true,
            "fill_forms": true,
            "modify": true,
            "print": true,
            "print_high": true
          },
          "description": "Permissions granted to the user."
        },
        "user_password": {
          "default": null,
          "description": "Optional password needed to open the document.",

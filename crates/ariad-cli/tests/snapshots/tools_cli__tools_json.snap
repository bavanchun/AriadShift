      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.rotate`.",
      "properties": {
        "angle": {
          "description": "Clockwise rotation delta in degrees (`90`, `180`, `270`, or `-90`).",
          "enum": [
            90,
            180,
            270,
            -90
          ],
          "type": "integer"
        },
        "pages": {
          "$ref": "#/$defs/PageRange",

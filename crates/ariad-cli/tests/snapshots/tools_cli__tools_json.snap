      "description": "Parameters for `pdf.alternate_mix`.",
      "properties": {
        "reverse_second": {
          "default": false,
          "description": "Whether pages from the second input PDF should be taken in reverse order (`false` by default).",
          "type": "boolean"
        }
      },
      "title": "AlternateMixParams",
      "type": "object"
    },
    "runtimes": [

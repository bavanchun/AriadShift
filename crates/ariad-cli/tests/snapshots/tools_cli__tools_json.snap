  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.reorder",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "ReorderPreset": {
          "description": "Named page-reordering preset for `pdf.reorder`.",
          "oneOf": [
            {
              "const": "reverse",
              "description": "Reverse the document page order (`last..=1`).",
              "type": "string"
            },
            {
              "const": "duplex-interleave",
              "description": "Interleave front and back duplex scan stacks (`1, N, 2, N-1, ...`).",
              "type": "string"
            },
            {
              "const": "odd-then-even",
              "description": "Place all odd-numbered pages first followed by all even-numbered pages.",
              "type": "string"
            }
          ]
        },
        "ReorderSpec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReorderPreset",
              "description": "Named reordering preset."
            },
            {
              "$ref": "#/$defs/PageRange",
              "description": "Explicit 1-based page range or sequence (duplicates allowed and kept in order)."
            }
          ],
          "description": "Reorder specification: either a named preset (`\"reverse\"`, `\"duplex-interleave\"`,\n`\"odd-then-even\"`) or an explicit 1-based [`PageRange`] sequence."
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.reorder`.",
      "properties": {
        "order": {
          "$ref": "#/$defs/ReorderSpec",
          "description": "Target page order specification."
        }
      },
      "required": [
        "order"
      ],
      "title": "ReorderParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Reorder PDF pages using an explicit page range sequence or a named preset (reverse, duplex-interleave, odd-then-even).",
    "tier": "free",
    "version": "1"
  },
  {

              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "title": {
              "description": "Visible bookmark title string.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "page"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.outline`.",
      "properties": {
        "action": {
          "$ref": "#/$defs/OutlineAction",
          "description": "Outline operation (`\"export\"`, `\"import\"`, `\"clear\"`, or `\"from_headings\"`)."
        },
        "json": {
          "description": "Bookmark tree to import when `action == \"import\"`.",
          "items": {
            "$ref": "#/$defs/OutlineNode"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "OutlineParams",
      "type": "object"
    },
    "runtimes": [

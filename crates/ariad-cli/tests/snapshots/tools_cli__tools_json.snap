  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.overlay",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "many",
      "max": 2,
      "min": 2
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "OverlayPagesMode": {
          "description": "How pages from the second (overlay) PDF are paired with target pages in the base PDF.",
          "oneOf": [
            {
              "const": "first",
              "description": "Apply page 1 of the overlay PDF to every selected base page (`\"first\"`, default).",
              "type": "string"
            },
            {
              "const": "cycle",
              "description": "Cycle through the overlay PDF's pages repeatedly across the selected base pages.",
              "type": "string"
            },
            {
              "const": "matching",
              "description": "Pair page `k` of the overlay PDF with page `k` of the base PDF (when present).",
              "type": "string"
            }
          ]
        },
        "OverlayPosition": {
          "description": "Z-order placement of the overlay relative to the base page content.",
          "oneOf": [
            {
              "const": "over",
              "description": "Paint the overlay above the base page content (`\"over\"`, default).",
              "type": "string"
            },
            {
              "const": "under",
              "description": "Paint the overlay beneath the base page content (`\"under\"`).",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.overlay`.",
      "properties": {
        "overlay_pages": {
          "$ref": "#/$defs/OverlayPagesMode",
          "default": "first",
          "description": "Overlay page pairing mode (`\"first\"` by default, `\"cycle\"`, or `\"matching\"`)."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based base pages to apply the overlay onto (`\"all\"` by default)."
        },
        "position": {
          "$ref": "#/$defs/OverlayPosition",
          "default": "over",
          "description": "Layer ordering relative to the base page (`\"over\"` by default, or `\"under\"`)."

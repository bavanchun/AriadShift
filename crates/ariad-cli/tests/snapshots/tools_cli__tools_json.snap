              "type": "boolean"
            },
            "assemble": {
              "default": true,
              "description": "Permit assemble.",
              "type": "boolean"
            },
            "copy": {
              "default": true,
              "description": "Permit copy.",
              "type": "boolean"
            },
            "extract_accessibility": {
              "default": true,
              "description": "Permit extract accessibility.",
              "type": "boolean"
            },
            "fill_forms": {
              "default": true,
              "description": "Permit fill forms.",
              "type": "boolean"
            },
            "modify": {
              "default": true,
              "description": "Permit modify.",
              "type": "boolean"
            },
            "print": {
              "default": true,
              "description": "Permit print.",
              "type": "boolean"
            },
            "print_high": {

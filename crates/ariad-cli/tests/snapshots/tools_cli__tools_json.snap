    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.delete_pages`.",
      "properties": {
        "pages": {
          "$ref": "#/$defs/PageRange",
          "description": "1-based page range selection to delete (must leave at least 1 page in the document)."
        }
      },
      "required": [
        "pages"
      ],
      "title": "DeletePagesParams",
      "type": "object"
    },

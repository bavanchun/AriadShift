  {
    "engine": "pdfium",
    "group": "convert",
    "id": "pdf.render",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "png",
    "output_formats": [
      "png",
      "jpeg",
      "webp",
      "bmp",
      "tiff",
      "zip"
    ],
    "params_schema": {
      "$defs": {
        "Background": {
          "description": "Page background painted before the page content.",
          "oneOf": [
            {
              "const": "white",
              "description": "Opaque white.",
              "type": "string"
            },
            {
              "const": "transparent",
              "description": "Fully transparent; rejected for formats without alpha.",
              "type": "string"
            }
          ]
        },
        "Combine": {
          "description": "Whether the rendered pages stay separate images or become one tall image.",
          "oneOf": [
            {
              "const": "none",
              "description": "One image per page.",
              "type": "string"
            },
            {
              "const": "vertical",
              "description": "All selected pages stacked vertically into a single image.",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "RasterFormat": {
          "description": "Image encoding of a rendered page.",
          "oneOf": [
            {
              "const": "png",
              "description": "Lossless PNG.",
              "type": "string"
            },
            {
              "const": "jpeg",
              "description": "Lossy JPEG; has no alpha channel.",
              "type": "string"
            },
            {
              "const": "webp",
              "description": "WebP.",
              "type": "string"
            },
            {
              "const": "bmp",
              "description": "Uncompressed BMP.",
              "type": "string"
            },
            {
              "const": "tiff",
              "description": "TIFF.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.render`.",
      "properties": {
        "annotations": {
          "default": true,
          "description": "Whether annotations and form widgets are drawn.",
          "type": "boolean"
        },
        "background": {
          "$ref": "#/$defs/Background",
          "default": "white",
          "description": "Page background; `transparent` is rejected for `jpeg`."
        },
        "combine": {
          "$ref": "#/$defs/Combine",
          "default": "none",
          "description": "`vertical` stacks every selected page into one tall image."
        },
        "dpi": {
          "default": 150,
          "description": "Render resolution in dots per inch.",
          "format": "uint32",
          "maximum": 600,
          "minimum": 36,
          "type": "integer"
        },
        "format": {
          "$ref": "#/$defs/RasterFormat",
          "default": "png",
          "description": "Output image encoding."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "Pages to render (1-based selector)."
        },
        "quality": {
          "description": "Encoder quality for `jpeg` and `webp` (1 to 100); the encoder default applies when\nabsent. Rejected for lossless formats.",
          "format": "uint8",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "RenderParams",
      "type": "object"
    },
    "runtimes": [
      "local"
    ],
    "secret_params": [],
    "summary": "Render PDF pages to PNG, JPEG, WebP, BMP or TIFF images at a chosen resolution.",
    "tier": "free",
    "version": "1"
  },

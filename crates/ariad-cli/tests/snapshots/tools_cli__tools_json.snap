    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "GridOrder": {
          "description": "Grid cell ordering for multi-cell layout tools (`pdf.nup`, `pdf.divide_pages`).",
          "oneOf": [
            {
              "const": "row",
              "description": "Left-to-right, top-to-bottom row-major order.",
              "type": "string"
            },
            {
              "const": "column",
              "description": "Top-to-bottom, left-to-right column-major order.",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.divide_pages`.",
      "properties": {
        "cols": {
          "default": 2,
          "description": "Number of horizontal columns to divide each page into (`1..=8`, `2` by default).",
          "format": "uint8",

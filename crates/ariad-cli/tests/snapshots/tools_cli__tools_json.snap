              "description": "Middle right.",
              "type": "string"
            },
            {
              "const": "bottom-left",
              "description": "Lower left.",
              "type": "string"
            },
            {
              "const": "bottom-center",
              "description": "Lower centre.",
              "type": "string"
            },
            {
              "const": "bottom-right",

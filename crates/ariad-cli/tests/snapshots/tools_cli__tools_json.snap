  {
    "engine": "ariad-pdf",
    "group": "forms",
    "id": "pdf.forms_create",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "ChoiceOption": {
          "additionalProperties": false,
          "description": "The stored and displayed values of a choice field option.",
          "properties": {
            "display": {
              "type": "string"
            },
            "export": {
              "type": "string"
            }
          },
          "required": [
            "export",
            "display"
          ],
          "type": "object"
        },
        "FieldType": {
          "description": "PDF form field types exposed by the tool API.",
          "enum": [
            "text",
            "checkbox",
            "radio",
            "combo",
            "list",
            "button",
            "signature"
          ],
          "type": "string"
        },
        "FormValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "A form value; null requests that the existing value be cleared."
        },
        "NewField": {
          "additionalProperties": false,
          "description": "A new field or radio-group widget, in PDF page coordinates.",
          "properties": {
            "default": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FormValue"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "export_value": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "font_size": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "max_length": {
              "default": null,
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "multiline": {
              "default": false,
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "default": null,
              "items": {
                "$ref": "#/$defs/ChoiceOption"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "read_only": {
              "default": false,
              "type": "boolean"
            },
            "rect": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "required": {
              "default": false,
              "type": "boolean"
            },
            "tab_order": {
              "default": null,
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tooltip": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "$ref": "#/$defs/FieldType"
            }
          },
          "required": [
            "type",
            "name",
            "page",
            "rect"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Fields to add to an AcroForm.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/NewField"
          },
          "type": "array"
        },
        "replace_existing": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "fields"
      ],
      "title": "FormsCreateParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Create fillable PDF form fields.",
    "tier": "free",
    "version": "1"

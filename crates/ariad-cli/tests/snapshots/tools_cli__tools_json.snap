              "description": "Centre of the page.",
              "type": "string"
            },
            {
              "const": "middle-right",
              "description": "Middle right.",
              "type": "string"
            },
            {
              "const": "bottom-left",
              "description": "Lower left.",
              "type": "string"
            },
            {
              "const": "bottom-center",
              "description": "Lower centre.",
              "type": "string"
            },
            {
              "const": "bottom-right",
              "description": "Lower right.",
              "type": "string"
            }
          ]
        },
        "AutoSize": {
          "description": "Automatic font sizing.",
          "oneOf": [
            {
              "const": "auto",
              "description": "Fit to the requested layout.",
              "type": "string"
            }
          ]
        },
        "FontFace": {
          "description": "Bundled font face.",
          "oneOf": [
            {
              "const": "serif",
              "description": "Regular Libertinus Serif.",
              "type": "string"
            },
            {
              "const": "serif-bold",
              "description": "Bold Libertinus Serif.",
              "type": "string"
            }
          ]
        },
        "HexColor": {
          "description": "An RGB colour expressed as `#RRGGBB`.",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "MarkLayer": {
          "description": "Place drawing before or after the existing page content.",
          "oneOf": [
            {
              "const": "over",
              "description": "Draw after the existing page content.",
              "type": "string"
            },
            {
              "const": "under",
              "description": "Draw before the existing page content.",
              "type": "string"
            }
          ]
        },
        "Opacity": {
          "description": "Opacity in the inclusive range from zero to one.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "WatermarkFontSize": {
          "anyOf": [
            {
              "description": "Size in points.",
              "format": "double",
              "type": "number"
            },
            {
              "$ref": "#/$defs/AutoSize",
              "description": "Automatic sizing, represented by the string `auto`."
            }
          ],
          "description": "A font size in points or the automatic sizing rule."
        },
        "WatermarkKind": {
          "description": "Content of a watermark.",
          "oneOf": [
            {
              "const": "text",
              "description": "Draw supplied text.",
              "type": "string"
            },
            {
              "const": "image",
              "description": "Draw a second image input.",
              "type": "string"
            }
          ]
        },
        "WatermarkLayout": {
          "description": "Watermark repetition and orientation.",
          "oneOf": [
            {
              "const": "single",
              "description": "One mark at its anchor.",
              "type": "string"
            },
            {
              "const": "tiled",
              "description": "Repeat marks across the page.",
              "type": "string"
            },
            {
              "const": "diagonal",
              "description": "One mark following the page diagonal.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Text or image watermark appearance and placement.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor",
          "default": "center",
          "description": "Anchor used for omitted coordinates."
        },
        "color": {
          "$ref": "#/$defs/HexColor",
          "default": "#808080",
          "description": "Text colour in RGB hexadecimal form."
        },
        "font": {
          "$ref": "#/$defs/FontFace",
          "default": "serif-bold",
          "description": "Bundled font face."
        },
        "font_size_pt": {
          "$ref": "#/$defs/WatermarkFontSize",
          "default": "auto",
          "description": "Point size or `auto`."
        },
        "image_width_pt": {
          "default": null,
          "description": "Display width in points for image watermarks.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/WatermarkKind",
          "default": "text",
          "description": "Text or image watermark."
        },
        "layer": {
          "$ref": "#/$defs/MarkLayer",
          "default": "over",
          "description": "Draw over or under the page content."
        },
        "layout": {
          "$ref": "#/$defs/WatermarkLayout",
          "default": "diagonal",
          "description": "Single, tiled or diagonal placement."
        },
        "margin_pt": {
          "default": 36.0,
          "description": "Distance from the page edge in points.",
          "format": "double",
          "type": "number"
        },
        "offset_x_pt": {
          "default": 0.0,
          "description": "Horizontal adjustment in points.",
          "format": "double",
          "type": "number"
        },
        "offset_y_pt": {
          "default": 0.0,
          "description": "Vertical adjustment in points.",
          "format": "double",
          "type": "number"
        },
        "opacity": {
          "$ref": "#/$defs/Opacity",
          "default": 0.3,
          "description": "Watermark opacity."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "Selected 1-based pages."
        },
        "rotation_deg": {
          "default": 45.0,
          "description": "Counterclockwise rotation, except diagonal layout follows the page diagonal.",
          "format": "double",
          "type": "number"
        },
        "text": {
          "default": null,
          "description": "Required nonempty text for a text watermark.",
          "type": [
            "string",
            "null"
          ]
        },
        "tile_gap_pt": {
          "default": 72.0,
          "description": "Spacing between tiles in points.",
          "format": "double",
          "type": "number"
        },
        "x_pt": {
          "default": null,
          "description": "Explicit horizontal box position in points.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "y_pt": {
          "default": null,
          "description": "Explicit vertical box position in points.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "title": "WatermarkParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Add a removable text or image watermark.",
    "tier": "free",
    "version": "1"
  },

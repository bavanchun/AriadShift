    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "PageLabelRange": {
          "additionalProperties": false,
          "description": "A single page-label numbering range starting at 1-based page `from`.",
          "properties": {
            "from": {
              "description": "1-based first page index where this numbering range begins (`>= 1`).",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "prefix": {
              "description": "Optional label prefix prepended before the numeric portion (PDF `/P`).",
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "description": "Starting numeric value for this range (`1` by default, `>= 1`; PDF `/St`).",
              "format": "uint32",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "style": {
              "$ref": "#/$defs/PageLabelStyle",
              "default": "decimal",
              "description": "Numbering style (`\"decimal\"`, `\"roman-upper\"`, `\"roman-lower\"`, `\"alpha-upper\"`, `\"alpha-lower\"`, `\"none\"`)."
            }
          },
          "required": [
            "from"
          ],
          "type": "object"
        },
        "PageLabelStyle": {
          "description": "Numbering style for a `/PageLabels` range (`pdf.page_labels`).",
          "oneOf": [
            {
              "const": "decimal",
              "description": "Decimal Arabic numerals (`1, 2, 3, ...`; PDF `/S /D`).",
              "type": "string"
            },
            {
              "const": "roman-upper",
              "description": "Uppercase Roman numerals (`I, II, III, ...`; PDF `/S /R`).",
              "type": "string"
            },
            {
              "const": "roman-lower",
              "description": "Lowercase Roman numerals (`i, ii, iii, ...`; PDF `/S /r`).",
              "type": "string"
            },
            {
              "const": "alpha-upper",
              "description": "Uppercase letters (`A, B, C, ...`; PDF `/S /A`).",
              "type": "string"
            },
            {
              "const": "alpha-lower",
              "description": "Lowercase letters (`a, b, c, ...`; PDF `/S /a`).",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Prefix only with no numeric portion (PDF `/S` omitted).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.page_labels`.",
      "properties": {
        "ranges": {

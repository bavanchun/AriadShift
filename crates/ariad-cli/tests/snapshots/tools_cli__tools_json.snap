            },
            {
              "const": "a3",
              "description": "ISO A3.",
              "type": "string"
            },
            {
              "const": "a4",
              "description": "ISO A4.",
              "type": "string"
            },
            {
              "const": "a5",
              "description": "ISO A5.",
              "type": "string"
            },
            {
              "const": "letter",
              "description": "US Letter.",
              "type": "string"
            },
            {
              "const": "legal",
              "description": "US Legal.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `image.to_pdf`.",
      "properties": {
        "margin_pt": {
          "default": 0.0,
          "description": "Margin around the image in points.",
          "format": "double",
          "maximum": 144.0,
          "minimum": 0.0,
          "type": "number"
        },
        "orientation": {
          "$ref": "#/$defs/Orientation",
          "default": "auto",
          "description": "Page orientation for paper sizes."
        },
        "page": {
          "$ref": "#/$defs/PageSize",
          "default": "fit-image",
          "description": "Page size: the image size (`fit-image`) or a paper size."
        }
      },
      "title": "ImageToPdfParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"

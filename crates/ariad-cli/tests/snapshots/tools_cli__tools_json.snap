          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "font": {
          "$ref": "#/$defs/FontFace",
          "default": "serif",
          "description": "Bundled font face."
        },
        "font_size_pt": {
          "default": 9.0,
          "description": "Font size in points.",
          "format": "double",
          "type": "number"
        },
        "margin_pt": {
          "default": 18.0,
          "description": "Page-edge margin in points.",
          "format": "double",
          "type": "number"
        },
        "offset_x_pt": {
          "default": 0.0,
          "description": "Horizontal adjustment in points.",
          "format": "double",
          "type": "number"
        },
        "offset_y_pt": {
          "default": 0.0,
          "description": "Vertical adjustment in points.",
          "format": "double",
          "type": "number"
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "Selected 1-based pages."
        },
        "prefix": {
          "default": "",
          "description": "Text before each number.",
          "type": "string"
        },
        "start": {
          "default": 1,
          "description": "First value in the sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "suffix": {
          "default": "",
          "description": "Text after each number.",
          "type": "string"
        }
      },
      "title": "BatesParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Add a Bates sequence.",
    "tier": "free",
    "version": "1"

    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "CustomPaperSize": {
          "additionalProperties": false,
          "description": "Custom paper size specified as `{ w, h }` in PDF points (`1 pt = 1/72 inch`).",
          "properties": {
            "h": {
              "description": "Page height in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            },
            "w": {
              "description": "Page width in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            }
          },
          "required": [
            "w",
            "h"
          ],
          "type": "object"
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "PaperSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardPaper",
              "description": "Named standard paper size (`\"A0\"`..`\"A6\"`, `\"Letter\"`, `\"Legal\"`, `\"Tabloid\"`, `\"Ledger\"`)."
            },
            {
              "$ref": "#/$defs/CustomPaperSize",
              "description": "Custom paper dimensions `{ w, h }` in PDF points."
            }
          ],
          "description": "Paper size specification: either a named standard paper (`\"A4\"`, `\"Letter\"`, etc.) or custom\n`{ w, h }` dimensions in PDF points."
        },
        "PosterizeTiles": {
          "additionalProperties": false,
          "description": "Explicit tile grid dimensions `{ cols, rows }` for `pdf.posterize`.",
          "properties": {
            "cols": {
              "description": "Number of horizontal tile columns (`>= 1`).",
              "format": "uint8",
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            "rows": {
              "description": "Number of vertical tile rows (`>= 1`).",
              "format": "uint8",
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "cols",
            "rows"
          ],
          "type": "object"
        },
        "StandardPaper": {
          "description": "Named ISO and North American standard paper sizes (`docs/tools.md`).",
          "oneOf": [
            {
              "const": "A0",
              "description": "ISO A0 (`2383.94 × 3370.39 pt`, `841 × 1189 mm`).",
              "type": "string"
            },
            {
              "const": "A1",
              "description": "ISO A1 (`1683.78 × 2383.94 pt`, `594 × 841 mm`).",
              "type": "string"
            },
            {
              "const": "A2",
              "description": "ISO A2 (`1190.55 × 1683.78 pt`, `420 × 594 mm`).",
              "type": "string"
            },
            {
              "const": "A3",
              "description": "ISO A3 (`841.89 × 1190.55 pt`, `297 × 420 mm`).",
              "type": "string"
            },
            {
              "const": "A4",
              "description": "ISO A4 (`595.28 × 841.89 pt`, `210 × 297 mm`).",
              "type": "string"
            },
            {
              "const": "A5",
              "description": "ISO A5 (`419.53 × 595.28 pt`, `148 × 210 mm`).",
              "type": "string"
            },
            {
              "const": "A6",
              "description": "ISO A6 (`297.64 × 419.53 pt`, `105 × 148 mm`).",
              "type": "string"
            },
            {
              "const": "Letter",
              "description": "US Letter (`612.0 × 792.0 pt`, `8.5 × 11 in`).",
              "type": "string"
            },
            {
              "const": "Legal",
              "description": "US Legal (`612.0 × 1008.0 pt`, `8.5 × 14 in`).",
              "type": "string"
            },
            {
              "const": "Tabloid",
              "description": "US Tabloid (`792.0 × 1224.0 pt`, `11 × 17 in` portrait).",
              "type": "string"
            },
            {
              "const": "Ledger",
              "description": "US Ledger (`1224.0 × 792.0 pt`, `17 × 11 in` landscape).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.posterize`.",
      "properties": {
        "crop_marks": {
          "default": true,
          "description": "Whether to draw corner crop marks on each tile sheet (`true` by default).",
          "type": "boolean"
        },
        "overlap_mm": {
          "default": 10.0,
          "description": "Tile overlap margin in millimetres (`10.0` by default, `>= 0.0`).",
          "format": "float",
          "maximum": 200.0,
          "minimum": 0.0,
          "type": "number"
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to posterize (`\"all\"` by default)."
        },
        "scale": {
          "description": "Enlargement scale factor (`> 1.0`, mutually optional with `tiles`).",
          "exclusiveMinimum": 1.0,
          "format": "float",
          "maximum": 64.0,
          "type": [
            "number",
            "null"
          ]
        },
        "sheet": {
          "$ref": "#/$defs/PaperSize",
          "default": "A4",
          "description": "Output tile sheet paper size (`\"A4\"` by default)."
        },
        "tiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/PosterizeTiles"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit tile grid `{ cols, rows }` across which each page is enlarged."
        }
      },
      "title": "PosterizeParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Enlarge selected PDF pages across multiple tiled output sheets with overlap and crop marks.",
    "tier": "free",
    "version": "1"
  },

    "tier": "free",
    "version": "1"
  },
  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.crop",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "CropAutoMode": {
          "description": "Deferred whitespace auto-crop preset (`\"trim-whitespace-later\"`).",
          "oneOf": [
            {
              "const": "trim-whitespace-later",
              "description": "Placeholder marker for rendering-based whitespace auto-crop.",
              "type": "string"
            }
          ]
        },
        "CropBoxSpec": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropRect",
              "description": "Explicit rectangle `{ left, bottom, right, top }` in PDF points."
            },
            {
              "$ref": "#/$defs/CropAutoMode",
              "description": "Rendering-dependent auto-crop preset (`\"trim-whitespace-later\"`)."
            }
          ],
          "description": "Crop box specification for `pdf.crop`: explicit `{ left, bottom, right, top }` or\n`\"trim-whitespace-later\"`."
        },
        "CropRect": {
          "additionalProperties": false,
          "description": "Explicit crop rectangle coordinates `{ left, bottom, right, top }` in PDF points.",
          "properties": {
            "bottom": {
              "description": "Bottom coordinate (`lly`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "left": {
              "description": "Left coordinate (`llx`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "right": {
              "description": "Right coordinate (`urx`) in PDF points.",
              "format": "double",
              "type": "number"
            },
            "top": {
              "description": "Top coordinate (`ury`) in PDF points.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "left",
            "bottom",
            "right",
            "top"
          ],
          "type": "object"
        },
        "CropTarget": {
          "description": "Target PDF page box updated by `pdf.crop`.",
          "oneOf": [
            {
              "const": "crop",
              "description": "Update `/CropBox` (`\"crop\"`, default).",
              "type": "string"
            },
            {
              "const": "media",
              "description": "Update `/MediaBox` (and clamp `/CropBox` to match).",
              "type": "string"
            }
          ]
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.crop`.",
      "properties": {
        "box": {
          "$ref": "#/$defs/CropBoxSpec",
          "description": "Crop box coordinates in PDF points or `\"trim-whitespace-later\"`."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to crop (`\"all\"` by default)."
        },
        "target": {
          "$ref": "#/$defs/CropTarget",
          "default": "crop",
          "description": "Target page box to set (`\"crop\"` by default, or `\"media\"`)."
        }
      },
      "required": [
        "box"
      ],
      "title": "CropParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Set the CropBox or MediaBox of selected PDF pages in points.",
    "tier": "free",
    "version": "1"
  },
  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.scale",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "CustomPaperSize": {
          "additionalProperties": false,
          "description": "Custom paper size specified as `{ w, h }` in PDF points (`1 pt = 1/72 inch`).",
          "properties": {
            "h": {
              "description": "Page height in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            },
            "w": {
              "description": "Page width in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            }
          },
          "required": [
            "w",
            "h"
          ],
          "type": "object"
        },
        "PageRange": {
          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        },
        "PaperSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardPaper",
              "description": "Named standard paper size (`\"A0\"`..`\"A6\"`, `\"Letter\"`, `\"Legal\"`, `\"Tabloid\"`, `\"Ledger\"`)."
            },
            {
              "$ref": "#/$defs/CustomPaperSize",
              "description": "Custom paper dimensions `{ w, h }` in PDF points."
            }
          ],
          "description": "Paper size specification: either a named standard paper (`\"A4\"`, `\"Letter\"`, etc.) or custom\n`{ w, h }` dimensions in PDF points."
        },
        "ScaleFit": {
          "description": "Aspect-ratio fitting mode for `pdf.scale`.",
          "oneOf": [
            {
              "const": "contain",
              "description": "Uniformly scale content to fit inside the target sheet while preserving aspect ratio.",
              "type": "string"
            },
            {
              "const": "cover",
              "description": "Uniformly scale content to cover the entire target sheet while preserving aspect ratio.",
              "type": "string"
            },
            {
              "const": "stretch",
              "description": "Non-uniformly stretch content horizontally and vertically to fill the target sheet.",
              "type": "string"
            }
          ]
        },
        "StandardPaper": {
          "description": "Named ISO and North American standard paper sizes (`docs/tools.md`).",
          "oneOf": [
            {
              "const": "A0",
              "description": "ISO A0 (`2383.94 × 3370.39 pt`, `841 × 1189 mm`).",
              "type": "string"
            },
            {
              "const": "A1",
              "description": "ISO A1 (`1683.78 × 2383.94 pt`, `594 × 841 mm`).",
              "type": "string"
            },
            {
              "const": "A2",
              "description": "ISO A2 (`1190.55 × 1683.78 pt`, `420 × 594 mm`).",
              "type": "string"
            },
            {
              "const": "A3",
              "description": "ISO A3 (`841.89 × 1190.55 pt`, `297 × 420 mm`).",
              "type": "string"
            },
            {
              "const": "A4",
              "description": "ISO A4 (`595.28 × 841.89 pt`, `210 × 297 mm`).",
              "type": "string"
            },
            {
              "const": "A5",
              "description": "ISO A5 (`419.53 × 595.28 pt`, `148 × 210 mm`).",
              "type": "string"
            },
            {
              "const": "A6",
              "description": "ISO A6 (`297.64 × 419.53 pt`, `105 × 148 mm`).",
              "type": "string"
            },
            {
              "const": "Letter",
              "description": "US Letter (`612.0 × 792.0 pt`, `8.5 × 11 in`).",
              "type": "string"
            },
            {
              "const": "Legal",
              "description": "US Legal (`612.0 × 1008.0 pt`, `8.5 × 14 in`).",
              "type": "string"
            },
            {
              "const": "Tabloid",
              "description": "US Tabloid (`792.0 × 1224.0 pt`, `11 × 17 in` portrait).",
              "type": "string"
            },
            {
              "const": "Ledger",
              "description": "US Ledger (`1224.0 × 792.0 pt`, `17 × 11 in` landscape).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.scale`.",
      "properties": {
        "fit": {
          "$ref": "#/$defs/ScaleFit",
          "default": "contain",
          "description": "Fitting mode (`\"contain\"` by default, `\"cover\"`, or `\"stretch\"`)."
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to scale (`\"all\"` by default)."
        },
        "to": {
          "$ref": "#/$defs/PaperSize",
          "default": "A4",
          "description": "Target paper size (`\"A4\"` by default, or `\"Letter\"`, `\"Legal\"`, `\"A3\"`, `\"A5\"`, `{w, h}`)."
        }
      },
      "title": "ScaleParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Scale selected PDF pages to a target paper size using Form XObjects.",
    "tier": "free",
    "version": "1"
  },

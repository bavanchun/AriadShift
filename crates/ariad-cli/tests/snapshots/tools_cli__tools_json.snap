          "description": "1-based page range selector (`all`, `even`, `odd`, `N`, `N-M`, `N-`, `-M`, `last`, `last-K`).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.rotate`.",
      "properties": {
        "angle": {
          "description": "Clockwise rotation delta in degrees (`90`, `180`, `270`, or `-90`).",
          "enum": [
            90,
            180,
            270,
            -90
          ],
          "type": "integer"
        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to rotate (`\"all\"` by default; duplicate pages are rejected)."
        }
      },
      "required": [
        "angle"
      ],
      "title": "RotateParams",
      "type": "object"
    },
    "runtimes": [

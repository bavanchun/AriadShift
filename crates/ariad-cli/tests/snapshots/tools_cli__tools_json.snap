        },
        "pages": {
          "$ref": "#/$defs/PageRange",
          "default": "all",
          "description": "1-based pages to subdivide (`\"all\"` by default)."
        },
        "rows": {
          "default": 2,
          "description": "Number of vertical rows to divide each page into (`1..=8`, `2` by default).",
          "format": "uint8",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        }

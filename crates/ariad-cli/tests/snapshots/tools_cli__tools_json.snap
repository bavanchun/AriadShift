    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "CustomPaperSize": {
          "additionalProperties": false,
          "description": "Custom paper size specified as `{ w, h }` in PDF points (`1 pt = 1/72 inch`).",
          "properties": {
            "h": {
              "description": "Page height in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            },
            "w": {
              "description": "Page width in PDF points (`> 0`).",
              "exclusiveMinimum": 0.0,
              "format": "double",
              "maximum": 1000000.0,
              "type": "number"
            }
          },
          "required": [
            "w",
            "h"
          ],
          "type": "object"
        },
        "FontFace": {
          "description": "Bundled font face.",
          "oneOf": [
            {
              "const": "serif",
              "description": "Regular Libertinus Serif.",
              "type": "string"
            },
            {
              "const": "serif-bold",
              "description": "Bold Libertinus Serif.",
              "type": "string"
            }
          ]
        },
        "PaperSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardPaper",
              "description": "Named standard paper size (`\"A0\"`..`\"A6\"`, `\"Letter\"`, `\"Legal\"`, `\"Tabloid\"`, `\"Ledger\"`)."
            },
            {
              "$ref": "#/$defs/CustomPaperSize",
              "description": "Custom paper dimensions `{ w, h }` in PDF points."
            }
          ],
          "description": "Paper size specification: either a named standard paper (`\"A4\"`, `\"Letter\"`, etc.) or custom\n`{ w, h }` dimensions in PDF points."
        },
        "SamePage": {
          "description": "Inherit the first page's dimensions.",
          "oneOf": [
            {
              "const": "same-as-first",
              "description": "Use the first page dimensions.",
              "type": "string"
            }
          ]
        },
        "StandardPaper": {
          "description": "Named ISO and North American standard paper sizes (`docs/tools.md`).",
          "oneOf": [
            {
              "const": "A0",
              "description": "ISO A0 (`2383.94 × 3370.39 pt`, `841 × 1189 mm`).",
              "type": "string"
            },
            {
              "const": "A1",
              "description": "ISO A1 (`1683.78 × 2383.94 pt`, `594 × 841 mm`).",
              "type": "string"
            },
            {
              "const": "A2",
              "description": "ISO A2 (`1190.55 × 1683.78 pt`, `420 × 594 mm`).",
              "type": "string"
            },
            {
              "const": "A3",
              "description": "ISO A3 (`841.89 × 1190.55 pt`, `297 × 420 mm`).",
              "type": "string"
            },
            {
              "const": "A4",
              "description": "ISO A4 (`595.28 × 841.89 pt`, `210 × 297 mm`).",
              "type": "string"
            },
            {
              "const": "A5",
              "description": "ISO A5 (`419.53 × 595.28 pt`, `148 × 210 mm`).",
              "type": "string"
            },
            {
              "const": "A6",
              "description": "ISO A6 (`297.64 × 419.53 pt`, `105 × 148 mm`).",
              "type": "string"
            },
            {
              "const": "Letter",
              "description": "US Letter (`612.0 × 792.0 pt`, `8.5 × 11 in`).",
              "type": "string"
            },
            {
              "const": "Legal",
              "description": "US Legal (`612.0 × 1008.0 pt`, `8.5 × 14 in`).",
              "type": "string"
            },
            {
              "const": "Tabloid",
              "description": "US Tabloid (`792.0 × 1224.0 pt`, `11 × 17 in` portrait).",
              "type": "string"
            },
            {
              "const": "Ledger",
              "description": "US Ledger (`1224.0 × 792.0 pt`, `17 × 11 in` landscape).",
              "type": "string"
            }
          ]
        },
        "TocPageSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/SamePage",
              "description": "Inherit the first page size."
            },
            {
              "$ref": "#/$defs/PaperSize",
              "description": "Use a named or custom paper size."
            }
          ],
          "description": "Use the first page's dimensions or a specified paper size."
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Layout of a generated contents page.",
      "properties": {
        "dot_leaders": {
          "default": true,
          "description": "Include dot leaders between labels and page numbers.",
          "type": "boolean"
        },
        "font": {
          "$ref": "#/$defs/FontFace",
          "default": "serif",
          "description": "Bundled font face."
        },
        "font_size_pt": {
          "default": 11.0,
          "description": "Font size in points.",
          "format": "double",
          "type": "number"
        },
        "links": {
          "default": true,
          "description": "Add clickable links to outline targets.",
          "type": "boolean"
        },
        "max_depth": {
          "default": 3,
          "description": "Deepest outline level to include.",
          "format": "uint8",
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "$ref": "#/$defs/TocPageSize",
          "default": "same-as-first",
          "description": "Page size for inserted contents pages."
        },
        "title": {
          "default": "Contents",
          "description": "Contents-page title.",
          "type": "string"
        }
      },
      "title": "TocPageParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Insert linked contents pages from the outline.",
    "tier": "free",
    "version": "1"
  },

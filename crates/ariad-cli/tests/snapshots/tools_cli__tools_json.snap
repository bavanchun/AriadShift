  {
    "engine": "ariad-pdf",
    "group": "organize",
    "id": "pdf.outline",
    "input_formats": [
      "pdf"
    ],
    "inputs": {
      "arity": "one"
    },
    "output_format": "pdf",
    "params_schema": {
      "$defs": {
        "OutlineAction": {
          "description": "Action performed by `pdf.outline`.",
          "oneOf": [
            {
              "const": "export",
              "description": "Export the document's bookmark tree (`/Outlines`) as a JSON artifact.",
              "type": "string"
            },
            {
              "const": "import",
              "description": "Replace the document's `/Outlines` hierarchy with the tree in `json`.",
              "type": "string"
            },
            {
              "const": "clear",
              "description": "Remove `/Outlines` from the document catalog.",
              "type": "string"
            },
            {
              "const": "from_headings",
              "description": "Generate a bookmark hierarchy automatically from detected document headings.",
              "type": "string"
            }
          ]
        },
        "OutlineNode": {
          "additionalProperties": false,
          "description": "A single bookmark node in a `pdf.outline` hierarchy.",
          "properties": {
            "children": {
              "description": "Nested child bookmarks under this node.",
              "items": {
                "$ref": "#/$defs/OutlineNode"
              },
              "type": "array"
            },
            "page": {
              "description": "1-based destination page number (`>= 1`).",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "title": {
              "description": "Visible bookmark title string.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "page"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameters for `pdf.outline`.",
      "properties": {
        "action": {
          "$ref": "#/$defs/OutlineAction",
          "description": "Outline operation (`\"export\"`, `\"import\"`, `\"clear\"`, or `\"from_headings\"`)."
        },
        "json": {
          "description": "Bookmark tree to import when `action == \"import\"`.",
          "items": {
            "$ref": "#/$defs/OutlineNode"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "OutlineParams",
      "type": "object"
    },
    "runtimes": [
      "wasm",
      "local"
    ],
    "secret_params": [],
    "summary": "Export, import, clear, or generate PDF outline bookmarks from headings.",
    "tier": "free",
    "version": "1"
  },

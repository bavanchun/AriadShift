{
  "checks": [
    {
      "id": "pandoc_version",
      "ok": true,
      "required": true,
      "message": "Pandoc [VERSION] found in >= 3.12, < 4",
      "hint": ""
    },
    {
      "id": "workspace",
      "ok": true,
      "required": true,
      "message": "temp directory is writable and workspace can be created and removed",
      "hint": ""
    },
    {
      "id": "engine_describe",
      "ok": true,
      "required": true,
      "message": "engine 'pandoc' passes describe round trip",
      "hint": ""
    },
    {
      "id": "data_dir",
      "ok": true,
      "required": false,
      "message": "engine pack directory is writable",
      "hint": ""
    },
    {
      "id": "pack_keys",
      "ok": false,
      "required": false,
      "message": "no engine pack signing keys are built into this ashift",
      "hint": "this build cannot install engine packs; use an official release build"
    },
    {
      "id": "docling_engine",
      "ok": false,
      "required": false,
      "message": "docling engine is not installed; PDF, PPTX, XLSX and image routes need it",
      "hint": "run 'ashift engines install docling', or set ASHIFT_DOCLING_ENGINE to a development engine"
    }
  ],
  "stale_workspaces": 0
}

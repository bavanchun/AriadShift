  "components": {
    "schemas": {
      "Capabilities": {
        "type": "object",
        "required": [
          "version",
          "generated_at",
          "packs",
          "formats",
          "edges"
        ],
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityEdge"
            },
            "description": "Edges the deployment can run."
          },
          "formats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormatInfo"
            }
          },
          "generated_at": {
            "type": "string"
          },
          "packs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pack"
            },
            "description": "Packs with workers on this deployment."
          },
          "version": {
            "type": "string",
            "description": "Version of the capabilities registry, for example `ariad-capabilities/0`."
          }
        }
      },
      "CapabilityEdge": {
        "type": "object",
        "description": "One conversion edge an engine provides.",
        "required": [
          "from",
          "to",
          "engine",
          "pack",
          "license"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "metrics": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EdgeMetrics",
                "description": "`null` until the benchmark measures the edge."
              },
              {
                "type": "null"
              }
            ]
          },
          "pack": {
            "$ref": "#/components/schemas/Pack"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "description": "Creates a conversion job.",
        "required": [
          "upload_id",
          "to"
        ],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "to": {
            "type": "string",
            "description": "Target format id or extension.",
            "example": "docx"
          },
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "description": "A completed upload."
          }
        },
        "additionalProperties": false
      },
      "CreateUploadRequest": {
        "type": "object",
        "description": "Starts an upload.",
        "required": [
          "filename",
          "size",
          "sha256"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Original file name. Used for the output name and title fallback; never logged.",
            "example": "report.docx",
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the file, lowercase hex.",
            "example": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Exact size in bytes.",
            "example": 48213,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "EdgeMetrics": {
        "type": "object",
        "description": "Benchmark measurements of one conversion edge.",
        "required": [
          "fidelity",
          "editability",
          "p50_ms",
          "peak_mem_mb",
          "samples"
        ],
        "properties": {
          "editability": {
            "type": "number",
            "format": "double"
          },
          "fidelity": {
            "type": "number",
            "format": "double"
          },
          "p50_ms": {
            "type": "number",
            "format": "double"
          },
          "peak_mem_mb": {
            "type": "number",
            "format": "double"
          },
          "samples": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, for example `not_found` or `limit_exceeded`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. Never contains document content."
          }
        }
      },
      "FormatInfo": {
        "type": "object",
        "description": "A format the service knows.",
        "required": [
          "id",
          "extensions",
          "media_type"
        ],
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "example": "markdown"
          },
          "media_type": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "upload_id",
          "from",
          "to",
          "profile",
          "pack",
          "route",
          "warnings",
          "attempts",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "description": "Worker attempts so far.",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail",
                "description": "Set when the job failed."
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When inputs and outputs are deleted."
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "from": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "pack": {
            "$ref": "#/components/schemas/Pack"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteStep"
            },
            "description": "Planned route; replaced by the executed route when the job succeeds."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "to": {
            "type": "string"
          },
          "upload_id": {
            "type": "string",
            "format": "uuid"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobWarning"
            },
            "maxItems": 64
          }
        }
      },
      "JobEvent": {
        "type": "object",
        "description": "One entry of a job's event stream (the `data` of an SSE message).",
        "required": [
          "id",
          "job_id",
          "kind",
          "data",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "description": "Kind-specific details, for example `{\"stage\": \"write\"}`."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Monotonic event id; also the SSE `id`, usable as `Last-Event-ID`."
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "description": "`queued`, `started`, `progress`, `warning`, `retrying`, `succeeded`, `failed`, `canceled` or `expired`.",
            "example": "progress"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "description": "Lifecycle of a job: `queued → running → succeeded | failed | canceled → expired`.",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled",
          "expired"
        ]
      },
      "JobWarning": {
        "type": "object",
        "description": "A warning reported by the conversion.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "OutputFile": {
        "type": "object",
        "description": "A produced file.",
        "required": [
          "id",
          "filename",
          "format",
          "media_type",
          "size",
          "sha256",
          "url",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "The URL stops working at this time (five minutes after issue)."
          },
          "filename": {
            "type": "string",
            "example": "report.docx"
          },
          "format": {
            "type": "string",
            "example": "docx"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "description": "Presigned download URL."
          }
        }
      },
      "Outputs": {
        "type": "object",
        "required": [
          "job_id",
          "outputs"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutputFile"
            }
          }
        }
      },
      "Pack": {
        "type": "string",
        "description": "A worker image class. Each pack consumes its own queue.",
        "enum": [
          "core",
          "office",
          "docling"
        ]
      },
      "PlanAlternative": {
        "type": "object",
        "required": [
          "route",
          "score",
          "measured",
          "pack"
        ],
        "properties": {
          "measured": {
            "type": "boolean"
          },
          "pack": {
            "$ref": "#/components/schemas/Pack"
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteStep"
            }
          },
          "score": {
            "$ref": "#/components/schemas/RouteScore"
          }
        }
      },
      "PlanRequest": {
        "type": "object",
        "description": "Plans a route without converting.",
        "required": [
          "to"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source format id or extension (`markdown`, `md`, `docx`). Required unless `upload_id` is given.",
            "example": "md"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "to": {
            "type": "string",
            "description": "Target format id or extension.",
            "example": "docx"
          },
          "upload_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "A completed upload whose detected format is the source."
          }
        },
        "additionalProperties": false
      },
      "PlanResponse": {
        "type": "object",
        "required": [
          "from",
          "to",
          "profile",
          "pack",
          "route",
          "score",
          "measured",
          "alternatives"
        ],
        "properties": {
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanAlternative"
            }
          },
          "from": {
            "type": "string"
          },
          "measured": {
            "type": "boolean",
            "description": "Whether every step has benchmark measurements."
          },
          "pack": {
            "$ref": "#/components/schemas/Pack",
            "description": "Worker pack that runs the route."
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteStep"
            }
          },
          "score": {
            "$ref": "#/components/schemas/RouteScore"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "PresignedRequest": {
        "type": "object",
        "description": "The single request that transfers a file to or from storage.",
        "required": [
          "method",
          "url",
          "headers",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "headers": {
            "type": "object",
            "description": "Headers to send unchanged.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "method": {
            "type": "string",
            "description": "HTTP method, `PUT` for uploads.",
            "example": "PUT"
          },
          "url": {
            "type": "string",
            "description": "Presigned URL."
          }
        }
      },
      "Profile": {
        "type": "string",
        "description": "Route selection priorities.",
        "enum": [
          "editable",
          "faithful",
          "fast"
        ]
      },
      "RouteScore": {
        "type": "object",
        "description": "Benchmark-derived scores of a route; `null` where unmeasured.",
        "properties": {
          "editability": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "estimated_duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "fidelity": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "RouteStep": {
        "type": "object",
        "description": "One conversion step.",
        "required": [
          "from",
          "to",
          "engine"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "example": "ariad-core"
          },
          "from": {
            "type": "string",
            "example": "markdown"
          },
          "to": {
            "type": "string",
            "example": "ariad-ir+json"
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "id",
          "status",
          "filename",
          "size",
          "sha256",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the stored file is deleted."
          },
          "filename": {
            "type": "string"
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Detected format registry id, once the upload is complete."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "upload": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PresignedRequest",
                "description": "Present while the upload is pending."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "UploadStatus": {
        "type": "string",
        "description": "Lifecycle of an upload.",
        "enum": [
          "pending",
          "completed",
          "deleted",
          "expired"
        ]
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "A Better Auth API key."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Better Auth JWT (JWT plugin, 15-minute lifetime)."
      }
    }
  },
  "tags": [
    {
      "name": "uploads",
      "description": "Send input files"
    },
    {
      "name": "jobs",
      "description": "Run and follow conversions"
    },
    {
      "name": "planning",
      "description": "Routes and capabilities"
    },
    {
      "name": "health",
      "description": "Liveness and readiness"
    }
  ]
}

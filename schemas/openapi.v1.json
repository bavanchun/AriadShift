        ],
        "summary": "Plan a conversion without running it.",
        "description": "Returns the route the planner picks for the deployment's worker packs, its\nbenchmark scores, and up to two alternatives.",
        "operationId": "plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The planned route",

{
  "name": "@ariadshift/web",
  "private": true,
  "type": "module",
  "description": "AriadShift website and in-browser converter.",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "generate-sdk": "pnpm --filter @ariadshift/sdk generate",
    "dev": "pnpm run generate-sdk && node scripts/sync-brand.mjs && node scripts/sync-pandoc.mjs && node scripts/sync-pdfium.mjs && node scripts/sync-notices.mjs && node scripts/write-service-worker.mjs --dev && next dev --port 3200",
    "build": "pnpm run generate-sdk && node scripts/sync-brand.mjs && node scripts/sync-pandoc.mjs && node scripts/sync-pdfium.mjs && node scripts/sync-notices.mjs && next build --analyze && node scripts/write-service-worker.mjs && node scripts/sync-notices.mjs --check",
    "export": "pnpm run generate-sdk && node scripts/sync-brand.mjs && node scripts/sync-pandoc.mjs && node scripts/sync-pdfium.mjs && node scripts/sync-notices.mjs && node scripts/export.mjs && node scripts/sync-notices.mjs --check",
    "start": "next start --port 3100",
    "typecheck": "pnpm run generate-sdk && node scripts/sync-brand.mjs && next typegen && tsc --noEmit -p .",
    "test": "pnpm run generate-sdk && vitest run",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@ariadshift/ariad-typst": "workspace:*",
    "@ariadshift/ariad-wasm": "workspace:*",
    "@ariadshift/sdk": "workspace:*",
    "@ariadshift/ui": "workspace:*",
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@better-auth/api-key": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@bjorn3/browser_wasi_shim": "catalog:",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-thumbnail": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@tanstack/react-virtual": "3.14.26",
    "@uppy/aws-s3": "6.3.1",
    "@uppy/core": "6.3.1",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@ariadshift/config": "workspace:*",
    "@fontsource/plus-jakarta-sans": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "chrome-launcher": "catalog:",
    "jsdom": "catalog:",
    "lighthouse": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

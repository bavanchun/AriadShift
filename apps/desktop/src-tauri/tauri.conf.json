{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AriadShift",
  "version": "0.2.0",
  "identifier": "com.ariadnev.ariadshift",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3210",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AriadShift",
        "width": 1120,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../../../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES",
      "../THIRD_PARTY_JS_LICENSES": "THIRD_PARTY_JS_LICENSES",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ariadshift"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERUJGMEJFODZBNUQyQTUKUldTbDBxV0d2dkRyelU1MGdTcHFoKy9RYlkxYVlZS1BmNGJNU3NVSDdtY3EzMnRJWGJ2L1NlU2sK",
      "endpoints": ["https://github.com/bavanchun/AriadShift/releases/latest/download/latest.json"]
    }
  }
}

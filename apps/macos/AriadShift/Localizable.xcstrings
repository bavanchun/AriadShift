    "legal.privacy.deleting_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Start over and delete files” removes the input and output from the private storage at once. Files of a tab you close without starting over stay in that storage until you next open the converter, which deletes them on start. Clearing this site's data in your browser settings removes them as well."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bắt đầu lại và xóa tệp” xóa ngay tệp đầu vào và đầu ra khỏi vùng lưu trữ riêng. Tệp của một thẻ mà bạn đóng mà không bắt đầu lại sẽ ở lại trong vùng lưu trữ đó cho đến lần tiếp theo bạn mở trình chuyển đổi, khi đó trình chuyển đổi sẽ xóa chúng lúc khởi động. Xóa dữ liệu của trang web này trong cài đặt trình duyệt cũng sẽ xóa chúng."
          }
        }
      }
    },
    "legal.privacy.deleting_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your files"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tệp của bạn"
          }
        }
      }
    },
    "legal.privacy.documents_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your documents stay on your device"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài liệu của bạn ở lại trên thiết bị của bạn"
          }
        }
      }
    },
    "legal.privacy.documents_memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your browser cannot provide that storage, the files are held in the worker's memory instead and disappear when you close the tab."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu trình duyệt của bạn không thể cung cấp vùng lưu trữ đó, các tệp sẽ được giữ trong bộ nhớ của worker và biến mất khi bạn đóng thẻ."
          }
        }
      }
    },
    "legal.privacy.documents_storage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you choose a file, the browser copies it into its origin private file system, a storage area that only this website can read and that is not part of your regular files. The conversion runs in a background worker using WebAssembly. The file is never sent to a server, and the converted file is written to the same private storage, from which you download it. Each open tab keeps its files in its own folder there."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn chọn một tệp, trình duyệt sao chép tệp đó vào hệ thống tệp riêng theo nguồn gốc (origin private file system) của nó, một vùng lưu trữ mà chỉ trang web này mới đọc được và không thuộc các tệp thông thường của bạn. Việc chuyển đổi chạy trong một worker nền bằng WebAssembly. Tệp không bao giờ được gửi đến máy chủ, và tệp đã chuyển đổi được ghi vào chính vùng lưu trữ riêng đó, từ đó bạn tải xuống. Mỗi thẻ đang mở giữ các tệp của mình trong một thư mục riêng tại đó."
          }
        }
      }
    },
    "legal.privacy.hosting_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like any website, the server that delivers these pages may keep standard access logs (IP address, time, requested URL). Those requests never include your documents."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống mọi trang web, máy chủ phân phối các trang này có thể giữ nhật ký truy cập tiêu chuẩn (địa chỉ IP, thời gian, URL được yêu cầu). Các yêu cầu đó không bao giờ chứa tài liệu của bạn."
          }
        }
      }
    },
    "legal.privacy.hosting_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosting"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu trữ web"
          }
        }
      }
    },
    "legal.privacy.lede" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The converter on this website runs entirely in your browser. This page explains what that means in practice."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình chuyển đổi trên trang web này chạy hoàn toàn trong trình duyệt của bạn. Trang này giải thích điều đó có nghĩa là gì trong thực tế."
          }
        }
      }
    },
    "legal.privacy.meta_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the AriadShift website does with your documents: nothing leaves your device."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trang web AriadShift làm gì với tài liệu của bạn: không có gì rời khỏi thiết bị của bạn."
          }
        }
      }
    },
    "legal.privacy.meta_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {

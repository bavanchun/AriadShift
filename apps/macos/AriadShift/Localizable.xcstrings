    "legal.privacy.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền riêng tư"
          }
        }
      }
    },
    "legal.privacy.tracking_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The website sets no cookies, loads no analytics or advertising scripts and makes no requests to other sites. A service worker caches the converter so it keeps working offline; it stores only the website's own code. Your theme choice is kept in local storage."
          }
        },
        "vi" : {

    "common.format.pdf.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُقرأ نص ملفات PDF الرقمية على هذا الجهاز. ويستخدم إخراج PDF محرك Typst وخطوطًا مضمّنة. أما الصفحات الممسوحة ضوئيًا فتحتاج إلى OCR في تطبيق سطح المكتب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rəqəmsal PDF mətni bu cihazda oxunur. PDF çıxışı Typst və daxil edilmiş şriftlərdən istifadə edir. Skan edilmiş səhifələr üçün masaüstü tətbiqində OCR lazımdır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Текстът на цифровите PDF файлове се чете на това устройство. Изходният PDF използва Typst и вградени шрифтове. Сканираните страници изискват OCR в настолното приложение."
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ཨང་ཀིའི་ PDF ཡིག་འབྲུ་ཡོ་བྱད་འདི་ཉིད་ནས་ཀློག་གི་ཡོད། PDF ཕྱིར་འདོན་ལ་ Typst དང་ནང་འཇུག་བྱས་པའི་ཡིག་གཟུགས་སྤྱོད། པར་བཤུས་བྱས་པའི་ཤོག་ངོས་ལ་ཅོག་ཙེའི་ཉེར་སྤྱོད་ནང་ OCR དགོས།"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El text dels PDF digitals es llegeix en aquest dispositiu. La sortida PDF utilitza Typst i tipus de lletra incrustats. Les pàgines escanejades necessiten OCR a l’aplicació d’escriptori."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Text digitálních PDF se čte na tomto zařízení. Výstup PDF využívá Typst a vložená písma. Naskenované stránky vyžadují OCR v desktopové aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekst i digitale PDF-filer læses på denne enhed. PDF-output bruger Typst og indlejrede skrifttyper. Scannede sider kræver OCR i desktop-appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Text digitaler PDFs wird auf diesem Gerät gelesen. Die PDF-Ausgabe nutzt Typst und eingebettete Schriften. Gescannte Seiten benötigen OCR in der Desktop-App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το κείμενο ψηφιακών PDF διαβάζεται σε αυτή τη συσκευή. Η έξοδος PDF χρησιμοποιεί Typst και ενσωματωμένες γραμματοσειρές. Οι σαρωμένες σελίδες χρειάζονται OCR στην εφαρμογή για υπολογιστή."
          }
        },
        "en" : {

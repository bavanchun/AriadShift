    "mac.onboarding.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح مستندات PDF وافحصها وعالجها بالمحرك نفسه الذي يعمل به سطر أوامر AriadShift. حوّل Markdown وHTML وWord وEPUB والصور إلى PDF عبر ملف > استيراد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF sənədlərini AriadShift əmr sətri ilə eyni mühərrikdən istifadə edərək açın, yoxlayın və işləyin. Fayl > İdxal et vasitəsilə Markdown, HTML, Word, EPUB və şəkilləri PDF formatına çevirin."
          }

\par \pard\plain \s0\nowidctlpar\hyphpar0\ltrpar\rtlch\alang1081\ltrch\hich\afs24\alang1033\dbch\langfe2052\loch\fs24\lang1033{\listtext\pard\plain  \u-3947\'3f\tab}\ilvl0\ls2 \fi-360\li720\lin720\ltrpar{

            "t": 579.8823500000001,
            "r": 534.8493885299999,
            "b": 540.3367055704698,
            "coord_origin": "BOTTOMLEFT"
          },
          "charspan": [
            0,
            243
          ]
        }
      ],
      "orig": "The repair caf\u00e9 opens one Saturday each month in the old tram depot. Neighbors bring lamps, clocks, radios, and small appliances that have stopped working. Volunteers set out screwdrivers and labeled trays so every loose part has a safe place.",
      "text": "The repair caf\u00e9 opens one Saturday each month in the old tram depot. Neighbors bring lamps, clocks, radios, and small appliances that have stopped working. Volunteers set out screwdrivers and labeled trays so every loose part has a safe place."
    },

<section id="a-small-distance-check" class="level1">
<h1>A Small Distance Check</h1>
<div class="sourceCode" id="cb1">
        <pre class="sourceCode python">
          <code class="sourceCode python">
            <span id="cb1-1">
              <a href="#cb1-1" aria-hidden="true" tabindex="-1">
              </a>segments <span class="op">=</span> [<span class="dv">120</span>, <span class="dv">85</span>, <span class="dv">210</span>]</span>
<span id="cb1-2">
              <a href="#cb1-2" aria-hidden="true" tabindex="-1">
              </a>
              <span class="bu">print</span>(<span class="bu">sum</span>(segments))</span>
          </code>
        </pre>
      </div>
<p>The values are metres, not minutes.</p>
</section>
</body>

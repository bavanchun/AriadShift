            {
              "blocks": [
                {
                  "content": [
                    {
                      "text": "Loại sách",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "colspan": 1,
              "rowspan": 1
            },
            {
              "blocks": [
                {
                  "content": [
                    {
                      "text": "Số quyển",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "colspan": 1,
              "rowspan": 1
            }
          ]
        ],
        "type": "table"
      },
      {
        "content": [
          {
            "text": "Ghi chép",
            "type": "text"
          }
        ],
        "level": 1,
        "type": "heading"
      },
      {
        "items": [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Mỗi sáng thứ bảy, một nhóm hàng xóm tưới cây và đổi sách. Trẻ nhỏ chọn truyện tranh; người lớn mang đến sách nấu ăn, bản đồ cũ và tạp chí khoa học. Những quyển sách được bọc giấy nâu để mưa không làm cong góc.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "checked": null
          }
        ],
        "ordered": false,
        "start": null,

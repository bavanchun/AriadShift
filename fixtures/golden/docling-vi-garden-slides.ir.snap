    "body": [
      {
        "content": [
          {
            "text": "Khu vườn đọc sách",
            "type": "text"
          }
        ],
        "level": 1,
        "type": "heading"
      },
      {
        "content": [
          {
            "text": "Một khoảng sân nhỏ sau thư viện phường",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": [
          {
            "text": "Lịch chăm vườn",
            "type": "text"
          }
        ],
        "level": 1,
        "type": "heading"
      },
      {
        "items": [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Thứ bảy: tưới cây và đổi sách",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "checked": null
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Ngày nắng: học bài dưới giàn hoa giấy",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "checked": null
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Ngày mưa: chuyển vào mái hiên",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "checked": null
          }
        ],
        "ordered": false,
        "start": null,
        "tight": true,
        "type": "list"
      },
      {
        "content": [
          {
            "text": "Sách được đổi trong tháng",
            "type": "text"
          }
        ],
        "level": 1,
        "type": "heading"
      },
      {
        "body": [
          [
            {
              "blocks": [
                {
                  "content": [
                    {
                      "text": "Truyện tranh",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }
              ],
              "colspan": 1,
              "rowspan": 1
            },
            {
              "blocks": [
                {
                  "content": [
                    {
                      "text": "24",
                      "type": "text"
                    }
                  ],
                  "type": "paragraph"
                }

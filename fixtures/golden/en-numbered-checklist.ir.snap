  "body": [
    {
      "content": [
        {
          "text": "Before the café opens",
          "type": "text"
        }
      ],
      "level": 1,
      "type": "heading"
    },
    {
      "content": [
        {
          "text": "The repair café opens one Saturday each month in the old tram depot. Neighbors bring lamps, clocks, radios, and small appliances that have stopped working. Volunteers set out screwdrivers and labeled trays so every loose part has a safe place.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Clear the workbench",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "checked": null
        },
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Check each lamp",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "checked": null
        },
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Label the parts tray",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "checked": null
        }
      ],
      "ordered": true,
      "start": 1,
      "tight": false,
      "type": "list"
    },
    {
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Ask the visitor before replacing a part.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "checked": null
        }
      ],
      "ordered": false,
      "start": null,
      "tight": false,
      "type": "list"
    },
    {
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Record the repair",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "checked": null
        }
      ],
      "ordered": false,
      "start": null,
      "tight": false,
      "type": "list"
    },
    {
      "content": [
        {
          "text": "No one promises a quick fix. The visitor sits beside a volunteer, describes what happened, and learns how to inspect the object. Sometimes a clean contact solves the problem; sometimes the group discovers that a replacement part is no longer made.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    }
  ],

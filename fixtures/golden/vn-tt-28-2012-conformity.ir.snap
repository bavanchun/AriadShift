                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "BẢN CÔNG BỐ HỢP CHUẨN/HỢP QUY",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Số ………………………….",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Tên tổ chức, cá nhân: ……… ……………………………………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Địa chỉ: ……………………………………………………..……………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Điện thoại: …………………………Fax: …………………………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "E-mail: ……………………………………………………..………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "CÔNG BỐ:",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Sản phẩm, hàng hóa, quá trình, dịch vụ, môi trường (",
                    "type": "text"
                  },
                  {
                    "content": [
                      {
                        "text": "tên gọi, kiểu, loại, nhãn hiệu, đặc trưng kỹ thuật,...",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "text": " )",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "…………………………..………………………………………..…………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "……………………………………………………………………..………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Phù hợp với tiêu chuẩn/quy chuẩn kỹ thuật (",
                    "type": "text"
                  },
                  {
                    "content": [
                      {
                        "text": "số hiệu, ký hiệu, tên gọi",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "text": ")",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "…………………………..………………………………………..…………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "……………………………………………………………………..………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "Thông tin bổ sung (",
                    "type": "text"
                  },
                  {
                    "content": [
                      {
                        "text": "căn cứ công bố hợp chuẩn/hợp quy, phương thức đánh giá sự phù hợp...",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "text": "):",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "……………………………………………………..………………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "……………………………………………………..………………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": "……………………………………………………..………………………",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "content": [
                  {
                    "text": ".....(Tên tổ chức, cá nhân) .... cam kết và chịu trách nhiệm về tính phù hợp của …. (sản phẩm, hàng hóa, quá trình, dịch vụ, môi trường)…….. do mình sản xuất, kinh doanh, bảo quản, vận chuyển, sử dụng, khai thác.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 2,
            "header": true,
            "rowspan": 1
          }
        ]
      ],
      "type": "table"
    },
    {
      "content": [
        {
          "content": [
            {
              "type": "line_break"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Mẫu 3. TBTNHS",
              "type": "text"
            },
            {
              "type": "line_break"
            }
          ],
          "type": "strong"
        },
        {
          "text": "28/2012/TT-BKHCN",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "body": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Số: …….../TB-……",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "………, ngày … tháng …. năm …..",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ]
      ],
      "caption": null,
      "columns": [

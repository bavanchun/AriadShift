      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tổng số hồ sơ công bố hợp chuẩn/hợp quy đã tiếp nhận:……………………………………………………………………………………",
                  "type": "text"
                }
              ],
              "type": "strong"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "default"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "text": "Nơi nhận:",
                            "type": "text"
                          },
                          {
                            "type": "line_break"
                          }
                        ],
                        "type": "strong"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "text": "- Tổng cục TC ĐL CL;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Cơ quan chủ quản (để báo cáo);",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Lưu: Cơ quan tiếp nhận hồ sơ.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Đại diện có thẩm quyền của",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "Cơ quan tiếp nhận công bố",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      }
                    ],
                    "type": "strong"
                  },
                  {
                    "content": [
                      {
                        "text": "(ký tên, chức vụ, đóng dấu)",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          }
        ]
      ],
      "type": "table"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Mẫu 5. BCĐG",
              "type": "text"
            },
            {
              "type": "line_break"
            }
          ],
          "type": "strong"
        },
        {
          "text": "28/2012/TT-BKHCN",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "body": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Số: ……...........",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "………, ngày … tháng …. năm …..",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ]
      ],
      "caption": null,
      "columns": [
        {
          "align": "center"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "TÊN CƠ QUAN CHỦ QUẢN ",
                    "type": "text"
                  },
                  {
                    "content": [
                      {
                        "text": "(nếu có)",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "content": [
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "TÊN TỔ CHỨC, CÁ NHÂN",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "--------",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "Độc lập - Tự do - Hạnh phúc",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "----------------",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          }
        ]
      ],
      "type": "table"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "BÁO CÁO",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "ĐÁNH GIÁ HỢP CHUẨN/HỢP QUY",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Ngày đánh giá:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Địa điểm đánh giá:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Tên sản phẩm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "4. Số hiệu tiêu chuẩn /quy chuẩn kỹ thuật áp dụng:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "5. Tên tổ chức thử nghiệm sản phẩm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "6. Đánh giá về kết quả thử nghiệm theo tiêu chuẩn /quy chuẩn kỹ thuật áp dụng và hiệu lực việc áp dụng, thực hiện quy trình sản xuất:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "7. Các nội dung khác (nếu có):",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "8. Kết luận:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": " Sản phẩm phù hợp tiêu chuẩn/quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": " Sản phẩm không phù hợp tiêu chuẩn/quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "center"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Người đánh giá",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      }
                    ],
                    "type": "strong"
                  },
                  {
                    "content": [
                      {
                        "text": "(ký và ghi rõ họ tên)",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Xác nhận của lãnh đạo tổ chức, cá nhân",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      }
                    ],
                    "type": "strong"
                  },
                  {
                    "content": [
                      {
                        "text": "(ký tên, chức vụ, đóng dấu)",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          }
        ]
      ],
      "type": "table"
    }

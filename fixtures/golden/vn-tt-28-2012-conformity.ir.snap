                "content": [
                  {
                    "content": [
                      {
                        "text": "KT. BỘ TRƯỞNG",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "THỨ TRƯỞNG",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "(Đã ký)",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "Trần Việt Thanh",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,

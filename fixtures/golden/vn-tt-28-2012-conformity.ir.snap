  "body": [
    {
      "body": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Số: 28/2012/TT-BKHCN",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Hà Nội, ngày 12 tháng 12 năm 2012",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ]
      ],
      "caption": null,
      "columns": [
        {
          "align": "center"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "BỘ KHOA HỌC VÀ CÔNG NGHỆ",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "--------",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "Độc lập - Tự do - Hạnh phúc",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "----------------",
                        "type": "text"
                      }
                    ],
                    "type": "strong"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          }
        ]
      ],
      "type": "table"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "THÔNG TƯ",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Quy định về công bố hợp chuẩn, công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "_______________________",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Căn cứ Luật Tiêu chuẩn và Quy chuẩn kỹ thuật ngày 29 tháng 6 năm 2006;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Căn cứ Luật Chất lượng sản phẩm, hàng hóa ngày 21 tháng 11 năm 2007;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Căn cứ Nghị định số 127/2007/NĐ-CP ngày 01 tháng 8 năm 2007 của Chính phủ quy định chi tiết thi hành một số điều của Luật Tiêu chuẩn và Quy chuẩn kỹ thuật;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Căn cứ Nghị định số 132/2008/NĐ-CP ngày 31 tháng 12 năm 2008 của Chính phủ quy định chi tiết thi hành một số điều của Luật Chất lượng sản phẩm, hàng hóa;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Căn cứ Nghị định số 28/2008/NĐ-CP ngày 14 tháng 3 năm 2008 của Chính phủ quy định chức năng, nhiệm vụ, quyền hạn và cơ cấu tổ chức của Bộ Khoa học và Công nghệ;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Xét đề nghị của Tổng cục trưởng Tổng cục Tiêu chuẩn Đo lường Chất lượng;",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Bộ trưởng Bộ Khoa học và Công nghệ quy định về công bố hợp chuẩn, công bố hợp quy và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật.",
              "type": "text"
            }
          ],
          "type": "emph"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Chương I",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "QUY ĐỊNH CHUNG",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 1. Phạm vi điều chỉnh",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Thông tư này quy định về công bố hợp chuẩn, công bố hợp quy và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 2. Đối tượng áp dụng",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Thông tư này áp dụng đối với tổ chức, cá nhân và cơ quan quản lý có liên quan đến hoạt động đánh giá sự phù hợp, công bố hợp chuẩn, công bố hợp quy.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 3. Giải thích từ ngữ",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trong Thông tư này, các từ ngữ dưới đây được hiểu như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "Công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " là việc tổ chức, cá nhân tự công bố sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường phù hợp với tiêu chuẩn tương ứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "Công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " là việc tổ chức, cá nhân tự công bố sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường phù hợp với quy chuẩn kỹ thuật tương ứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "Tổ chức chứng nhận thực hiện hoạt động chứng nhận phù hợp tiêu chuẩn",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " là tổ chức đã thực hiện đăng ký lĩnh vực hoạt động chứng nhận (sau đây gọi tắt là tổ chức chứng nhận đã đăng ký) theo quy định tại Thông tư số 08/2009/TT-BKHCN ngày 08 tháng 4 năm 2009 của Bộ trưởng Bộ Khoa học và Công nghệ hướng dẫn về yêu cầu, trình tự, thủ tục đăng ký lĩnh vực hoạt động đánh giá sự phù hợp (sau đây viết tắt là Thông tư số 08/2009/TT-BKHCN) và Thông tư số 10/2011/TT-BKHCN ngày 30 tháng 6 năm 2011 của Bộ trưởng Bộ Khoa học và Công nghệ sửa đổi, bổ sung một số quy định của Thông tư số 08/2009/TT-BKHCN (sau đây viết tắt là Thông tư số 10/2011/TT-BKHCN).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "4. ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "Tổ chức chứng nhận thực hiện hoạt động chứng nhận phù hợp quy chuẩn kỹ",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "thuật",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " là tổ chức chứng nhận đã đăng ký theo quy định tại khoản 3 Điều này và được cơ quan có thẩm quyền chỉ định thực hiện hoạt động chứng nhận hợp quy (sau đây gọi tắt là tổ chức chứng nhận được chỉ định).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "5. ",
          "type": "text"
        },
        {
          "content": [
            {
              "text": "Tổ chức thử nghiệm thực hiện hoạt động thử nghiệm chất lượng sản phẩm, hàng hóa",
              "type": "text"
            }
          ],
          "type": "emph"
        },
        {
          "text": " là tổ chức đã thực hiện đăng ký lĩnh vực hoạt động thử nghiệm (sau đây gọi tắt là tổ chức thử nghiệm đã đăng ký) theo quy định tại Thông tư số 08/2009/TT-BKHCN và Thông tư số 10/2011/TT-BKHCN.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 4. Dấu hợp chuẩn, dấu hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Dấu hợp chuẩn và sử dụng dấu hợp chuẩn",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Dấu hợp chuẩn do tổ chức chứng nhận đã đăng ký quy định về hình dạng, kết cấu, cách thể hiện và sử dụng dấu hợp chuẩn cấp cho đối tượng được chứng nhận hợp chuẩn và phải đáp ứng những yêu cầu cơ bản sau đây:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Bảo đảm rõ ràng, không gây nhầm lẫn với các dấu khác;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Phải thể hiện được đầy đủ ký hiệu của tiêu chuẩn tương ứng dùng làm căn cứ chứng nhận hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trường hợp tổ chức, cá nhân công bố hợp chuẩn trên cơ sở kết quả tự đánh giá thì không phải quy định về hình dạng, kết cấu, cách thể hiện và không được sử dụng dấu hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Dấu hợp quy và sử dụng dấu hợp quy",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Dấu hợp quy có hình dạng, kích thước theo quy định tại Phụ lục I Thông tư này;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Dấu hợp quy được sử dụng trực tiếp trên sản phẩm, hàng hóa hoặc trên bao bì hoặc trong tài liệu kỹ thuật hoặc trên nhãn gắn trên sản phẩm, hàng hóa ở vị trí dễ thấy, dễ đọc;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Dấu hợp quy phải bảo đảm không dễ tẩy xóa và không thể bóc ra gắn lại;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Dấu hợp quy có thể được phóng to hoặc thu nhỏ nhưng phải đảm bảo đúng tỷ lệ, kích thước cơ bản của dấu hợp quy quy định tại Phụ lục I Thông tư này và nhận biết được bằng mắt thường;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "đ) Dấu hợp quy phải được thiết kế và thể hiện cùng một màu, dễ nhận biết.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 5. Các phương thức đánh giá sự phù hợp",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Việc đánh giá sự phù hợp được thực hiện theo một trong các phương thức sau đây:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Phương thức 1: Thử nghiệm mẫu điển hình;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Phương thức 2: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy trên thị trường;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Phương thức 3: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất kết hợp với đánh giá quá trình sản xuất;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Phương thức 4: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất và trên thị trường kết hợp với đánh giá quá trình sản xuất;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "đ) Phương thức 5: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất hoặc trên thị trường kết hợp với đánh giá quá trình sản xuất;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "e) Phương thức 6: Đánh giá và giám sát hệ thống quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "g) Phương thức 7: Thử nghiệm, đánh giá lô sản phẩm, hàng hóa;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "h) Phương thức 8: Thử nghiệm hoặc kiểm định toàn bộ sản phẩm, hàng hóa.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Nội dung, trình tự và nguyên tắc sử dụng các phương thức đánh giá sự phù hợp được quy định tại Phụ lục II Thông tư này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 6. Áp dụng phương thức đánh giá sự phù hợp",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Phương thức đánh giá sự phù hợp tiêu chuẩn áp dụng cho từng loại sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường cụ thể do tổ chức chứng nhận hợp chuẩn hoặc tổ chức, cá nhân công bố hợp chuẩn lựa chọn theo các phương thức đánh giá sự phù hợp quy định tại Điều 5 của Thông tư này. Phương thức đánh giá sự phù hợp được lựa chọn phải thích hợp với đối tượng được đánh giá để đảm bảo độ tin cậy của kết quả đánh giá sự phù hợp.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Phương thức đánh giá sự phù hợp quy chuẩn kỹ thuật áp dụng cho sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường cụ thể được quy định tại quy chuẩn kỹ thuật tương ứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Phương thức đánh giá sự phù hợp phải được ghi cụ thể trên giấy chứng nhận phù hợp quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "type": "line_break"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Chương II",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "CÔNG BỐ HỢP CHUẨN",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 7. Nguyên tắc công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Đối tượng của công bố hợp chuẩn là sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quy định trong tiêu chuẩn tương ứng. Công bố hợp chuẩn là hoạt động tự nguyện.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Việc công bố phù hợp tiêu chuẩn tương ứng dựa trên:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Kết quả chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký thực hiện hoặc;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Kết quả tự đánh giá sự phù hợp của tổ chức, cá nhân công bố hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc thử nghiệm phục vụ đánh giá hợp chuẩn phải được thực hiện tại tổ chức thử nghiệm đã đăng ký.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 8. Trình tự công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc công bố hợp chuẩn được thực hiện theo các bước sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Bước 1: Đánh giá sự phù hợp đối tượng của công bố hợp chuẩn với tiêu chuẩn tương ứng (sau đây viết tắt là đánh giá hợp chuẩn).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Việc đánh giá hợp chuẩn do tổ chức chứng nhận đã đăng ký (bên thứ ba) hoặc do tổ chức, cá nhân công bố hợp chuẩn (bên thứ nhất) thực hiện.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc đánh giá hợp chuẩn được thực hiện theo phương thức đánh giá sự phù hợp quy định tại khoản 1 Điều 6 của Thông tư này;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Kết quả đánh giá hợp chuẩn quy định tại điểm a khoản 1 Điều này là căn cứ để tổ chức, cá nhân công bố hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Bước 2: Đăng ký hồ sơ công bố hợp chuẩn tại Chi cục Tiêu chuẩn Đo lường Chất lượng tỉnh, thành phố trực thuộc Trung ương nơi tổ chức, cá nhân sản xuất đăng ký doanh nghiệp hoặc đăng ký hộ kinh doanh (sau đây viết tắt là Chi cục).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 9. Hồ sơ đăng ký công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Tổ chức, cá nhân công bố hợp chuẩn lập 02 (hai) bộ hồ sơ công bố hợp chuẩn, trong đó 01 (một) bộ hồ sơ nộp trực tiếp hoặc gửi hồ sơ qua đường bưu điện tới Chi cục và 01 (một) bộ hồ sơ lưu giữ tại tổ chức, cá nhân. Thành phần hồ sơ được quy định như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Trường hợp công bố hợp chuẩn dựa trên kết quả chứng nhận hợp chuẩn của tổ chức chứng nhận đã đăng ký (bên thứ ba), hồ sơ công bố hợp chuẩn gồm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Bản công bố hợp chuẩn (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp chuẩn (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Giấy chứng nhận đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Bản sao y bản chính tiêu chuẩn sử dụng làm căn cứ để công bố;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Bản sao y bản chính Giấy chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký cấp kèm theo mẫu dấu hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có chứng thực.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Trường hợp công bố hợp chuẩn dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), hồ sơ công bố hợp chuẩn gồm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Bản công bố hợp chuẩn (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp chuẩn (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Giấy chứng nhận đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Bản sao y bản chính tiêu chuẩn sử dụng làm căn cứ để công bố;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Trường hợp tổ chức, cá nhân công bố hợp chuẩn chưa được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp của tổ chức, cá nhân phải có quy trình sản xuất kèm theo kế hoạch kiểm soát chất lượng được xây dựng, áp dụng (theo Mẫu 1. KHKSCL quy định tại Phụ lục III Thông tư này) và kế hoạch giám sát hệ thống quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "đ) Trường hợp tổ chức, cá nhân công bố hợp chuẩn được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp của tổ chức, cá nhân phải có bản sao y bản chính Giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý còn hiệu lực;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "e) Báo cáo đánh giá hợp chuẩn (theo Mẫu 5. BCĐG quy định tại Phụ lục III Thông tư này) kèm theo bản sao y bản chính Phiếu kết quả thử nghiệm mẫu trong vòng 12 tháng tính đến thời điểm nộp hồ sơ công bố hợp chuẩn của tổ chức thử nghiệm đã đăng ký.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có chứng thực.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 10. Xử lý hồ sơ công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Hồ sơ công bố hợp chuẩn gửi tới Chi cục được xử lý như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Đối với hồ sơ công bố hợp chuẩn không đầy đủ theo quy định tại Điều 9 của Thông tư này, trong thời hạn 03 (ba) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp chuẩn, Chi cục thông báo bằng văn bản đề nghị bổ sung các loại giấy tờ theo quy định tại Điều 9 của Thông tư này tới tổ chức, cá nhân công bố hợp chuẩn. Sau thời hạn 15 (mười lăm) ngày làm việc kể từ ngày Chi cục gửi văn bản đề nghị mà hồ sơ công bố hợp chuẩn không được bổ sung đầy đủ theo quy định, Chi cục có quyền hủy bỏ việc xử lý đối với hồ sơ này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Đối với hồ sơ công bố hợp chuẩn đầy đủ theo quy định tại Điều 9 của Thông tư này, trong thời gian 05 (năm) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp chuẩn, Chi cục phải tổ chức kiểm tra tính hợp lệ của hồ sơ công bố hợp chuẩn để xử lý như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Trường hợp hồ sơ công bố hợp chuẩn đầy đủ và hợp lệ, Chi cục ban hành Thông báo tiếp nhận hồ sơ công bố hợp chuẩn cho tổ chức, cá nhân công bố hợp chuẩn (theo Mẫu 3. TBTNHS quy định tại Phụ lục III Thông tư này). Thông báo tiếp nhận hồ sơ công bố hợp chuẩn có giá trị theo giá trị của giấy chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký cấp hoặc có giá trị 03 (ba) năm kể từ ngày lãnh đạo tổ chức, cá nhân ký xác nhận báo cáo đánh giá hợp chuẩn (đối với trường hợp tổ chức, cá nhân tự đánh giá hợp chuẩn).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Trường hợp hồ sơ công bố hợp chuẩn đầy đủ nhưng không hợp lệ, Chi cục thông báo bằng văn bản cho cho tổ chức, cá nhân công bố hợp chuẩn về lý do không tiếp nhận hồ sơ.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 11. Trách nhiệm của tổ chức, cá nhân công bố hợp chuẩn",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Lựa chọn phương thức đánh giá sự phù hợp phù hợp với đối tượng của công bố hợp chuẩn để đảm bảo độ tin cậy của kết quả đánh giá.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Duy trì liên tục và chịu trách nhiệm về sự phù hợp của các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã đăng ký công bố hợp chuẩn; duy trì việc kiểm soát chất lượng, thử nghiệm và giám sát định kỳ tại cơ sở sản xuất, kinh doanh của tổ chức, cá nhân.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Khi phát hiện sự không phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp chuẩn trong quá trình lưu thông, sử dụng, tổ chức, cá nhân phải:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Tạm ngừng việc xuất xưởng và tiến hành thu hồi các sản phẩm, hàng hóa không phù hợp đang lưu thông trên thị trường trong trường hợp sản phẩm, hàng hóa không phù hợp có rủi ro cao gây mất an toàn cho người sử dụng; ngừng vận hành, khai thác các quá trình, dịch vụ, môi trường liên quan khi cần thiết;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Tiến hành các biện pháp khắc phục sự không phù hợp;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Thông báo bằng văn bản cho Chi cục về kết quả khắc phục sự không phù hợp trước khi tiếp tục đưa các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường vào sử dụng, lưu thông, khai thác, kinh doanh.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "4. Lập và lưu giữ hồ sơ công bố hợp chuẩn như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Trường hợp công bố hợp chuẩn dựa trên kết quả chứng nhận hợp chuẩn của tổ chức chứng nhận đã đăng ký (bên thứ ba), lưu giữ hồ sơ công bố hợp chuẩn bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 1 Điều 9 và Hồ sơ đánh giá giám sát của tổ chức chứng nhận đã đăng ký;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Trường hợp công bố hợp chuẩn dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), lưu giữ hồ sơ công bố hợp chuẩn bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 2 Điều 9 và Hồ sơ tự đánh giá giám sát của tổ chức, cá nhân theo kế hoạch giám sát.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "5. Cung cấp tài liệu chứng minh việc đảm bảo sự phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường với tiêu chuẩn tương ứng khi có yêu cầu của cơ quan nhà nước có thẩm quyền.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "6. Cung cấp bản sao y bản chính Thông báo tiếp nhận hồ sơ công bố hợp chuẩn cho tổ chức, cá nhân kinh doanh sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "7. Thực hiện việc công bố lại khi có bất kỳ sự thay đổi nào về nội dung hồ sơ công bố hợp chuẩn đã đăng ký hoặc có bất kỳ sự thay đổi nào về tính năng, công dụng, đặc điểm của sản phẩm, hàng hóa, dịch vụ đã công bố hợp chuẩn.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Chương III",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "CÔNG BỐ HỢP QUY",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 12. Nguyên tắc công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Đối tượng của công bố hợp quy là sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quy định trong quy chuẩn kỹ thuật quốc gia do các Bộ quản lý ngành, lĩnh vực ban hành hoặc được quy định trong quy chuẩn kỹ thuật địa phương do Ủy ban nhân tỉnh, thành phố trực thuộc Trung ương ban hành. Công bố hợp quy là hoạt động bắt buộc.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Việc công bố phù hợp quy chuẩn kỹ thuật dựa trên một trong hai trường hợp sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Kết quả chứng nhận hợp quy theo quy định tại quy chuẩn kỹ thuật tương ứng và do tổ chức chứng nhận được chỉ định thực hiện;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Kết quả tự đánh giá sự phù hợp của tổ chức, cá nhân công bố hợp quy.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc thử nghiệm phục vụ đánh giá hợp quy được thực hiện tại tổ chức thử nghiệm đã đăng ký.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Trường hợp sản phẩm, hàng hóa được quản lý bởi nhiều quy chuẩn kỹ thuật khác nhau thì tổ chức, cá nhân phải thực hiện việc đăng ký bản công bố hợp quy tại các cơ quan chuyên ngành tương ứng và dấu hợp quy chỉ được sử dụng khi sản phẩm, hàng hóa đó đã thực hiện đầy đủ các biện pháp quản lý theo quy định tại các quy chuẩn kỹ thuật tương ứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 13. Trình tự công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc công bố hợp quy được thực hiện theo các bước sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Bước 1: Đánh giá sự phù hợp đối tượng của công bố hợp quy với quy chuẩn kỹ thuật tương ứng (sau đây viết tắt là đánh giá hợp quy).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Việc đánh giá hợp quy có thể do tổ chức chứng nhận được chỉ định (bên thứ ba) hoặc do tổ chức, cá nhân công bố hợp quy (bên thứ nhất) thực hiện.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Việc đánh giá hợp quy được thực hiện theo phương thức đánh giá sự phù hợp quy định trong quy chuẩn kỹ thuật tương ứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trường hợp sử dụng kết quả đánh giá sự phù hợp của tổ chức đánh giá sự phù hợp nước ngoài thì tổ chức đánh giá sự phù hợp nước ngoài phải được thừa nhận theo quy định của pháp luật hoặc được cơ quan quản lý nhà nước có thẩm quyền chỉ định;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Kết quả đánh giá hợp quy là căn cứ để tổ chức, cá nhân công bố hợp quy.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Bước 2: Đăng ký bản công bố hợp quy tại cơ quan chuyên ngành do Bộ quản lý ngành, lĩnh vực và Ủy ban nhân tỉnh, thành phố trực thuộc Trung ương chỉ định (sau đây viết tắt là cơ quan chuyên ngành).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 14. Hồ sơ đăng ký công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Tổ chức, cá nhân công bố hợp quy lập 02 (hai) bộ hồ sơ công bố hợp quy, trong đó 01 (một) bộ hồ sơ nộp trực tiếp hoặc gửi hồ sơ qua đường bưu điện tới cơ quan chuyên ngành và 01 (một) bộ hồ sơ lưu giữ tại tổ chức, cá nhân. Thành phần hồ sơ được quy định như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Trường hợp công bố hợp quy dựa trên kết quả chứng nhận hợp quy của tổ chức chứng nhận được chỉ định (bên thứ ba), hồ sơ công bố hợp quy bao gồm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Bản công bố hợp quy (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp quy (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Bản sao y bản chính giấy chứng nhận phù hợp quy chuẩn kỹ thuật tương ứng do tổ chức chứng nhận được chỉ định cấp kèm theo mẫu dấu hợp quy của tổ chức chứng nhận được chỉ định cấp cho tổ chức, cá nhân.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có công chứng;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Trường hợp công bố hợp quy dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), hồ sơ công bố hợp quy bao gồm:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Bản công bố hợp quy (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp quy (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Trường hợp tổ chức, cá nhân công bố hợp quy chưa được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp quy của tổ chức, cá nhân phải có quy trình sản xuất kèm theo kế hoạch kiểm soát chất lượng được xây dựng, áp dụng (theo Mẫu 1. KHKSCL quy định tại Phụ lục III Thông tư này) và kế hoạch giám sát hệ thống quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Trường hợp tổ chức, cá nhân công bố hợp quy được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp quy của tổ chức, cá nhân phải có bản sao y bản chính giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý còn hiệu lực;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "đ) Bản sao y bản chính Phiếu kết quả thử nghiệm mẫu trong vòng 12 tháng tính đến thời điểm nộp hồ sơ công bố hợp quy của tổ chức thử nghiệm đã đăng ký;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "e) Báo cáo đánh giá hợp quy (theo Mẫu 5. BCĐG quy định tại Phụ lục III Thông tư này) kèm theo mẫu dấu hợp quy và các tài liệu có liên quan;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có công chứng.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 15. Xử lý hồ sơ công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Hồ sơ công bố hợp quy gửi tới cơ quan chuyên ngành được xử lý như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Đối với hồ sơ công bố hợp quy không đầy đủ theo quy định tại Điều 14 của Thông tư này, trong thời hạn 03 (ba) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp quy, cơ quan chuyên ngành thông báo bằng văn bản đề nghị bổ sung các loại giấy tờ theo quy định tới tổ chức, cá nhân công bố hợp quy. Sau thời hạn 15 (mười lăm) ngày làm việc kể từ ngày cơ quan chuyên ngành gửi văn bản đề nghị mà hồ sơ công bố hợp quy không được bổ sung đầy đủ theo quy định, cơ quan chuyên ngành có quyền hủy bỏ việc xử lý đối với hồ sơ này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Đối với hồ sơ công bố hợp quy đầy đủ theo quy định tại Điều 14 của Thông tư này, trong thời gian 05 (năm) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp quy, cơ quan chuyên ngành tổ chức kiểm tra tính hợp lệ của hồ sơ công bố hợp quy:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Trường hợp hồ sơ công bố hợp quy đầy đủ và hợp lệ, cơ quan chuyên ngành ban hành Thông báo tiếp nhận hồ sơ công bố hợp quy cho tổ chức, cá nhân công bố hợp quy (theo Mẫu 3. TBTNHS quy định tại Phụ lục III Thông tư này).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Thông báo tiếp nhận hồ sơ công bố hơp quy có giá trị theo giá trị của giấy chứng nhận hợp quy do tổ chức chứng nhận được chỉ định cấp hoặc có giá trị ba (03) năm kể từ ngày lãnh đạo tổ chức, cá nhân ký xác nhận báo cáo đánh giá hợp quy (đối với trường hợp tổ chức, cá nhân tự đánh giá hợp quy);",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Trường hợp hồ sơ công bố hợp quy đầy đủ nhưng không hợp lệ, cơ quan chuyên ngành thông báo bằng văn bản cho tổ chức, cá nhân công bố hợp quy về lý do không tiếp nhận hồ sơ.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 16. Trách nhiệm của tổ chức, cá nhân công bố hợp quy",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Thông báo trên các phương tiện thông tin thích hợp về việc công bố hợp quy của mình đảm bảo người sử dụng sản phẩm, hàng hóa đó dễ dàng tiếp cận.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Duy trì liên tục và chịu trách nhiệm về sự phù hợp của các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp quy; duy trì việc kiểm soát chất lượng, thử nghiệm và giám sát định kỳ.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Sử dụng dấu hợp quy đối với sản phẩm, hàng hóa đã được công bố hợp quy theo quy định tại khoản 2 Điều 4 của Thông tư này trước khi đưa ra lưu thông trên thị trường. Lập sổ theo dõi và định kỳ hàng năm báo cáo việc sử dụng dấu hợp quy cho tổ chức chứng nhận được chỉ định.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "4. Khi phát hiện sự không phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp quy trong quá trình lưu thông hoặc sử dụng, tổ chức, cá nhân phải:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Kịp thời thông báo bằng văn bản về sự không phù hợp với cơ quan chuyên ngành;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Tạm ngừng việc xuất xưởng và tiến hành thu hồi các sản phẩm, hàng hóa không phù hợp đang lưu thông trên thị trường trong trường hợp sản phẩm, hàng hóa không phù hợp có rủi ro cao gây mất an toàn cho người sử dụng; ngừng vận hành, khai thác các quá trình, dịch vụ, môi trường liên quan khi cần thiết;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Tiến hành các biện pháp khắc phục sự không phù hợp;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Thông báo bằng văn bản cho cơ quan chuyên ngành về kết quả khắc phục sự không phù hợp trước khi tiếp tục đưa các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường vào sử dụng, lưu thông, khai thác, kinh doanh.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "5. Lập và lưu giữ hồ sơ công bố hợp quy làm cơ sở cho việc kiểm tra, thanh tra của cơ quan quản lý nhà nước như sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Trường hợp công bố hợp quy dựa trên kết quả chứng nhận hợp quy của tổ chức chứng nhận được chỉ định (bên thứ ba), lưu giữ hồ sơ công bố hợp quy bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 1 Điều 14 và Hồ sơ đánh giá giám sát của tổ chức chứng nhận được chỉ định;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Trường hợp công bố hợp quy dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), lưu giữ hồ sơ công bố hợp quy bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 2 Điều 14 và Hồ sơ tự đánh giá giám sát của tổ chức, cá nhân theo kế hoạch giám sát.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "6. Cung cấp tài liệu chứng minh việc đảm bảo sự phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường với quy chuẩn kỹ thuật tương ứng khi có yêu cầu của cơ quan nhà nước có thẩm quyền.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "7. Cung cấp bản sao y bản chính giấy chứng nhận hợp quy, Thông báo tiếp nhận hồ sơ công bố hợp quy cho tổ chức, cá nhân kinh doanh sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "8. Thực hiện việc công bố lại khi có bất kỳ sự thay đổi nào về nội dung của hồ sơ công bố hợp quy đã đăng ký hoặc có bất kỳ sự thay đổi nào về tính năng, công dụng, đặc điểm của sản phẩm, hàng hóa, dịch vụ đã công bố hợp quy.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Chương IV",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "TỔ CHỨC THỰC HIỆN",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 17. Trách nhiệm của các cơ quan quản lý",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Trách nhiệm của các Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Chỉ đạo hoạt động công bố hợp quy theo quy định tại Thông tư này khi ban hành các quy chuẩn kỹ thuật tương ứng để quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Chỉ định cơ quan đầu mối chịu trách nhiệm quản lý hoạt động công bố hợp quy trong lĩnh vực được phân công; thông báo danh sách cơ quan đầu mối cho các tổ chức, cá nhân có liên quan để thực hiện và gửi tới Bộ Khoa học và Công nghệ để phối hợp, quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Giao trách nhiệm thực hiện việc tiếp nhận hồ sơ công bố hợp quy cho các cơ quan chuyên ngành;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Định kỳ hằng năm, tổng hợp tình hình chỉ định tổ chức đánh giá sự phù hợp, thông báo cho Bộ Khoa học và Công nghệ để phối hợp quản lý; đột xuất, khi có yêu cầu, tổng hợp báo cáo tình hình công bố hợp quy về Bộ Khoa học và Công nghệ để tổng hợp báo cáo Thủ tướng Chính phủ.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Trách nhiệm của Tổng cục Tiêu chuẩn Đo lường Chất lượng là cơ quan đầu mối được chỉ định theo quy định tại điểm b khoản 1 Điều này:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Giúp Bộ Khoa học và Công nghệ thống nhất quản lý và hướng dẫn hoạt động đánh giá sự phù hợp, công bố hợp chuẩn và công bố hợp quy;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Phối hợp với các cơ quan đầu mối ở Trung ương thuộc các Bộ quản lý ngành, lĩnh vực, Sở Khoa học và Công nghệ các tỉnh, thành phố trực thuộc Trung ương trong việc đôn đốc, hướng dẫn thực hiện việc công bố hợp chuẩn, công bố hợp quy theo quy định tại Thông tư này;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Thực hiện việc theo dõi tình hình công bố hợp chuẩn và công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường thuộc trách nhiệm quản lý của Bộ Khoa học và Công nghệ trên cơ sở báo cáo của các Chi cục Tiêu chuẩn Đo lường Chất lượng; theo dõi việc chỉ định của Bộ quản lý ngành, lĩnh vực về hoạt động đánh giá sự phù hợp.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Trách nhiệm của cơ quan đầu mối được chỉ định theo quy định tại điểm b khoản 1 Điều này thuộc các Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Thực hiện việc theo dõi và quản lý hoạt động đăng ký công bố hợp quy của các cơ quan chuyên ngành; phối hợp với Tổng cục Tiêu chuẩn Đo lường Chất lượng trong công tác quản lý hoạt động công bố hợp quy; định kỳ hằng năm, tổng hợp báo cáo gửi Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương liên quan về tình hình chỉ định tổ chức đánh giá sự phù hợp, đồng thời gửi về Tổng cục Tiêu chuẩn Đo lường Chất lượng để phối hợp quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Tổng hợp tình hình hoạt động công bố hợp quy của các cơ quan chuyên ngành và định kỳ hằng năm, đột xuất khi có yêu cầu, báo cáo Bộ quản lý ngành, lĩnh vực, Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương liên quan.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "4. Trách nhiệm của cơ quan chuyên ngành do các Bộ quản lý ngành, lĩnh vực, Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chỉ định:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Tiếp nhận hồ sơ đăng ký và quản lý hồ sơ công bố hợp quy; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quản lý bởi các quy chuẩn kỹ thuật quốc gia do các Bộ quản lý ngành, lĩnh vực ban hành và các quy chuẩn kỹ thuật địa phương liên quan đến các lĩnh vực được phân công quản lý;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Công bố công khai trên trang thông tin điện tử của mình về tình hình công bố hợp quy với các nội dung sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Tên tổ chức, cá nhân công bố hợp quy;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Sản phẩm, hàng hóa công bố hợp quy;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Số hiệu quy chuẩn kỹ thuật;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Loại hình đánh giá: Bên thứ nhất (tên tổ chức, cá nhân) hay bên thứ ba (tên tổ chức chứng nhận được chỉ định).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Phối hợp với Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương trong việc cung cấp các thông tin về công bố hợp quy để thuận lợi cho việc kiểm tra chất lượng sản phẩm, hàng hóa;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Định kỳ hằng năm, đột xuất khi có yêu cầu, tổng hợp, báo cáo cơ quan đầu mối danh mục sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã đăng ký công bố hợp quy (theo Mẫu 4. BCTNHS quy định tại Phụ lục III Thông tư này).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "5. Trách nhiệm của Chi cục Tiêu chuẩn Đo lường Chất lượng thuộc Sở Khoa học và Công nghệ các tỉnh, thành phố trực thuộc Trung ương:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "a) Tiếp nhận đăng ký và quản lý hồ sơ công bố hợp chuẩn; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp chuẩn của các tổ chức, cá nhân sản xuất, kinh doanh tại địa phương và công bố công khai trên trang thông tin điện tử của Sở Khoa học và Công nghệ hoặc Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương tình hình công bố hợp chuẩn;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "b) Tiếp nhận đăng ký và quản lý hồ sơ công bố hợp quy; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quản lý bởi các quy chuẩn kỹ thuật quốc gia do Bộ Khoa học và Công nghệ ban hành và các quy chuẩn kỹ thuật địa phương liên quan đến các lĩnh vực được phân công quản lý; công bố công khai trên trang thông tin điện tử của Sở Khoa học và Công nghệ hoặc Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương tình hình công bố hợp quy với các nội dung sau:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Tên tổ chức, cá nhân công bố hợp quy;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Sản phẩm, hàng hóa công bố hợp quy;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Số hiệu quy chuẩn kỹ thuật;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "- Loại hình đánh giá: Bên thứ nhất (tên tổ chức, cá nhân) hay bên thứ ba (tên tổ chức chứng nhận được chỉ định).",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "c) Phối hợp với cơ quan chuyên ngành ở địa phương trong việc cung cấp các thông tin về công bố hợp chuẩn để thuận lợi cho việc kiểm tra chất lượng sản phẩm, hàng hóa;",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "d) Định kỳ hằng năm, đột xuất khi có yêu cầu, tổng hợp, báo cáo Tổng cục Tiêu chuẩn Đo lường Chất lượng tình hình tiếp nhận hồ sơ công bố hợp chuẩn, công bố hợp quy (theo Mẫu 4. BCTNHS quy định tại Phụ lục III Thông tư này) theo quy định tại điểm a, b khoản này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 18. Kiểm tra, thanh tra, xử lý vi phạm",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Cơ quan quản lý nhà nước có thẩm quyền thực hiện việc kiểm tra, thanh tra và xử lý vi phạm pháp luật trong hoạt động công bố hợp chuẩn, công bố hợp quy theo quy định tại Thông tư này và các quy định hiện hành khác có liên quan.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Tổ chức, cá nhân vi phạm các quy định về công bố hợp chuẩn, công bố hợp quy, tùy theo tính chất, mức độ vi phạm sẽ bị xử lý theo quy định của pháp luật hiện hành có liên quan.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 19. Điều khoản thi hành",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Thông tư này có hiệu lực thi hành kể từ ngày 27 tháng 01 năm 2013 và thay thế Quyết định số 24/2007/QĐ-BKHCN ngày 28 tháng 9 năm 2007 của Bộ trưởng Bộ Khoa học và Công nghệ về việc ban hành quy định về chứng nhận hợp chuẩn, chứng nhận hợp quy và công bố hợp chuẩn, công bố hợp quy.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "Điều 20. Tổ chức thực hiện",
              "type": "text"
            }
          ],
          "type": "strong"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "1. Bộ trưởng, Thủ trưởng cơ quan ngang Bộ, Chủ tịch Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chịu trách nhiệm tổ chức triển khai thực hiện Thông tư này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "2. Tổng cục trưởng Tổng cục Tiêu chuẩn Đo lường Chất lượng có trách nhiệm hướng dẫn và tổ chức thực hiện Thông tư này.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "3. Trong quá trình thực hiện, nếu có vấn đề phát sinh hoặc vướng mắc, tổ chức và cá nhân phản ánh kịp thời bằng văn bản về Bộ Khoa học và Công nghệ để nghiên cứu sửa đổi, bổ sung./.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "default"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "text": "Nơi nhận:",
                            "type": "text"
                          },
                          {
                            "type": "line_break"
                          }
                        ],
                        "type": "strong"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "text": "- Thủ tướng Chính phủ;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Các Phó Thủ tướng Chính phủ;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Các Bộ, cơ quan ngang Bộ, cơ quan thuộc CP;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Văn phòng Quốc hội;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Văn phòng Tổng Bí thư;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Văn phòng Chủ tịch nước;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- UBND các tỉnh, thành phố trực thuộc TW;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Công báo;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Cục Kiểm soát TTHC (Bộ Tư pháp);",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Cục Kiểm tra văn bản (Bộ Tư pháp);",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Lưu: VT, PC, TĐC.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {

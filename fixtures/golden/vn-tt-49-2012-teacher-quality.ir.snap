                        "content": [
                          {
                            "text": "Các Bộ, cơ quan ngang Bộ,",
                            "type": "text"
                          }
                        ],
                        "type": "paragraph"
                      }
                    ],
                    "checked": null
                  }
                ],
                "ordered": false,
                "start": null,
                "tight": false,
                "type": "list"
              },
              {
                "blocks": [
                  {
                    "content": [
                      {
                        "text": "cơ quan trực thuộc CP;",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  },
                  {
                    "content": [
                      {
                        "text": "- Cục KtrVBQPPL (Bộ Tư pháp);",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Kiểm toán Nhà nước;",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Như Điều 3;",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Công báo;",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Website Chính phủ;",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Website Bộ GDĐT;",
                        "type": "text"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "text": "- Lưu: VT, Vụ PC, Cục KTKĐCLGD.",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "quote"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {

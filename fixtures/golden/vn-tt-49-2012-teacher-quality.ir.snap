                  {
                    "content": [
                      {
                        "text": "Hà Nội, ngày 12 tháng 12 năm 2012",
                        "type": "text"
                      }
                    ],
                    "type": "emph"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "colspan": 1,

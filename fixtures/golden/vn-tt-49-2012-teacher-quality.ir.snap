                      {
                        "content": [
                          {
                            "text": "Nơi nhận:",
                            "type": "text"
                          }
                        ],
                        "type": "strong"
                      }
                    ],
                    "type": "emph"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Văn phòng Chính phủ;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- Ban Tuyên giáo TƯ;",
                    "type": "text"
                  },
                  {
                    "type": "line_break"
                  },
                  {
                    "text": "- UBVHGDTNTNNĐ của QH;",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              },
              {
                "items": [

      </w:tr>
      <w:tr>
        <w:tc>
          <w:tcPr />
          <w:p>
            <w:pPr>
              <w:pStyle w:val="FirstParagraph" />
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:lang w:val="vi" />
              </w:rPr>
              <w:t xml:space="preserve">Reading garden</w:t>
            </w:r>
          </w:p>
        </w:tc>
        <w:tc>
          <w:tcPr />
          <w:p>
            <w:pPr>
              <w:pStyle w:val="FirstParagraph" />
              <w:jc w:val="right" />
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:lang w:val="vi" />
              </w:rPr>
              <w:t xml:space="preserve">14</w:t>
            </w:r>
          </w:p>
        </w:tc>
      </w:tr>
    </w:tbl>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="FirstParagraph" />
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve">The combined distance is</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <m:oMath>
        <m:sSub>
          <m:e>
            <m:r>
              <m:t>d</m:t>
            </m:r>
          </m:e>
          <m:sub>
            <m:r>
              <m:t>1</m:t>
            </m:r>
          </m:sub>
        </m:sSub>
        <m:r>
          <m:rPr>
            <m:sty m:val="p" />
          </m:rPr>
          <m:t>+</m:t>
        </m:r>
        <m:sSub>
          <m:e>
            <m:r>
              <m:t>d</m:t>
            </m:r>
          </m:e>
          <m:sub>
            <m:r>
              <m:t>2</m:t>
            </m:r>
          </m:sub>
        </m:sSub>
      </m:oMath>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:b />
          <w:bCs />
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve">Check the bridge</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve">before leaving.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Compact" />
        <w:numPr>
          <w:ilvl w:val="0" />
          <w:numId w:val="1001" />
        </w:numPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:lang w:val="vi" />
        </w:rPr>
        <w:t xml:space="preserve">Save the route</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Compact" />
        <w:numPr>
          <w:ilvl w:val="0" />
          <w:numId w:val="1002" />

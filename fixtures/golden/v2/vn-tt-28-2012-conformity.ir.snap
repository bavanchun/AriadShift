          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "THÔNG TƯ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0
      },
      "id": "bf4ce85a8efc0e35aad618e00bbd80a3f1d689b36186d65b12f89b291620156db",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Quy định về công bố hợp chuẩn, công bố hợp quy",
                  "type": "text"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0
      },
      "id": "b3cb56f496140682647ad615c6c940958d56696b0055322facb11bee89dcb805e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0
      },
      "id": "beda9005a9dbf43ba4f309c89febb91a1068f894aa765058d160de53a638e8397",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "_______________________",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0
      },
      "id": "bf56963fb80f41f3f2f00c68a7ee230332d0dbecf5e0bb6336c14adca2c42e224",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Căn cứ Luật Tiêu chuẩn và Quy chuẩn kỹ thuật ngày 29 tháng 6 năm 2006;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bacda41902a6a5f866c5bc71498e13f5411f1e943869fa05835fdaa1e9fb133aa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Căn cứ Luật Chất lượng sản phẩm, hàng hóa ngày 21 tháng 11 năm 2007;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b585cad668af1b7b6acb71e2fd619e095517939035d907a50280d89aaf012f24b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Căn cứ Nghị định số 127/2007/NĐ-CP ngày 01 tháng 8 năm 2007 của Chính phủ quy định chi tiết thi hành một số điều của Luật Tiêu chuẩn và Quy chuẩn kỹ thuật;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd1818a40a87dab9bff14b9222626167ecf227a7f75397c598bd3da96ee279450",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Căn cứ Nghị định số 132/2008/NĐ-CP ngày 31 tháng 12 năm 2008 của Chính phủ quy định chi tiết thi hành một số điều của Luật Chất lượng sản phẩm, hàng hóa;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b84bd5ce14b270d76e0bb6a338b11f5403bb0d84d6a2ca1c3daff32a5d03171aa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Căn cứ Nghị định số 28/2008/NĐ-CP ngày 14 tháng 3 năm 2008 của Chính phủ quy định chức năng, nhiệm vụ, quyền hạn và cơ cấu tổ chức của Bộ Khoa học và Công nghệ;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdcf80fc1b3cde2eab7eb97dcd666e0157d7f65098583b982524e37fc7c45939a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Xét đề nghị của Tổng cục trưởng Tổng cục Tiêu chuẩn Đo lường Chất lượng;",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "beeb303da686778761c8430b1ab8d7545bb9b3112ea7ee81e05b59f1034ba7603",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Bộ trưởng Bộ Khoa học và Công nghệ quy định về công bố hợp chuẩn, công bố hợp quy và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "italic": true,
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba5cd14a46c26848fa8d94916907a7749a29a5787ab59b129654ea23d92c0e691",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Chương ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "I",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7607353df14ba7d4c5018249e24cd105d0d0627d3d71499e75fe955e6e069f57",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "QUY ĐỊNH CHUNG",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0c35356a467d3f8753da21b69c6ad215566df836d48f07f5279bea1868f8213b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 1. Phạm vi điều chỉnh",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b63053a23d7826a6acc506ef8031014cdb84989b1f01c0ef8c8cd085a362629a4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Thông tư này quy định về công bố hợp chuẩn, công bố hợp quy và phương thức đánh giá sự phù hợp với tiêu chuẩn, quy chuẩn kỹ thuật.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b74acbf0beeb3d2f050dc23d14004bd7618c3745fbad7de7baf0963c24336714d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 2. Đối tượng áp dụng",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd9497f0298a5efbe7099927c3c82b960ecdf46448eb06a7ab1da5d00293f98fa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Thông tư này áp dụng đối với tổ chức, cá nhân và cơ quan quản lý có liên quan đến hoạt động đánh giá sự phù hợp, công bố hợp chuẩn, công bố hợp quy.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0f8ff088a90ef72bb675d756502e83cacc0cc3d232353aad5da2c501c2d5c29f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 3. Giải thích từ ngữ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba84a651abb434b3a839a7bbe7fcc9fe0300d7ecf49804bf51667cebe300aae36",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong Thông tư này, các từ ngữ dưới đây được hiểu như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bab34d2c07a824720d44035471d66f8b866b1bbca21f9d1c92573b80ee53c2708",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " là việc tổ chức, cá nhân tự công bố sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường phù hợp với tiêu chuẩn tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb73ecff917363245f55f484ae49d0265675b44f535370364d10521e19e1dd7c3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " là việc tổ chức, cá nhân tự công bố sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường phù hợp với quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b58123e3de1f48a042424de8845bf5832d2cdde51b5df5d854ec828a4a8c64b53",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Tổ chức chứng nhận thực hiện hoạt động chứng nhận phù hợp tiêu chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " là tổ chức đã thực hiện đăng ký lĩnh vực hoạt động chứng nhận (sau đây gọi tắt là tổ chức chứng nhận đã đăng ký) theo quy định tại Thông tư số 08/2009/TT-BKHCN ngày 08 tháng 4 năm 2009 của Bộ trưởng Bộ Khoa học và Công nghệ hướng dẫn về yêu cầu, trình tự, thủ tục đăng ký lĩnh vực hoạt động đánh giá sự phù hợp (sau đây viết tắt là Thông tư số 08/2009/TT-BKHCN) và Thông tư số 10/2011/TT-BKHCN ngày 30 tháng 6 năm 2011 của Bộ trưởng Bộ Khoa học và Công nghệ sửa đổi, bổ sung một số quy định của Thông tư số 08/2009/TT-BKHCN (sau đây viết tắt là Thông tư số 10/2011/TT-BKHCN).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b908953bf22e96e05ecf625120f3b3838bb2c73d23cb7bfbd63da2cdf63fbc29b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "4. ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Tổ chức chứng nhận thực hiện hoạt động chứng nhận phù hợp quy chuẩn kỹ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "thuật",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " là tổ chức chứng nhận đã đăng ký theo quy định tại khoản 3 Điều này và được cơ quan có thẩm quyền chỉ định thực hiện hoạt động chứng nhận hợp quy (sau đây gọi tắt là tổ chức chứng nhận được chỉ định).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b029471819070aa843ee35794dcc87638603142819b9dc443d33a3c3d6e9153f3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "5. ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Tổ chức thử nghiệm thực hiện hoạt động thử nghiệm chất lượng sản phẩm, hàng hóa",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": " là tổ chức đã thực hiện đăng ký lĩnh vực hoạt động thử nghiệm (sau đây gọi tắt là tổ chức thử nghiệm đã đăng ký) theo quy định tại Thông tư số 08/2009/TT-BKHCN và Thông tư số 10/2011/TT-BKHCN.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbd1ae09a4ea5f20a17be21470b269da417f585f245227a0d0b33fab175dc5faf",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 4. Dấu hợp chuẩn, dấu hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b565ad116259f7144bd2bbdfbe340dd492e47d9806f1b3f839b13795ff249ccd2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Dấu hợp chuẩn và sử dụng dấu hợp chuẩn",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8a70e7b5cf5149e3db2a615dc497b606e14d2d7b55e530557a754a53ea344ca2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Dấu hợp chuẩn do tổ chức chứng nhận đã đăng ký quy định về hình dạng, kết cấu, cách thể hiện và sử dụng dấu hợp chuẩn cấp cho đối tượng được chứng nhận hợp chuẩn và phải đáp ứng những yêu cầu cơ bản sau đây:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbef0fddffd12ab70dc7ca0ba156f3919c5bcf1c4e035fff2cba02b0ab74fc1fb",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Bảo đảm rõ ràng, không gây nhầm lẫn với các dấu khác;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0f28a3ccf11d673530fe7daa2ed45de5c6a52dbb52be4f6ec6d94d115954a23f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Phải thể hiện được đầy đủ ký hiệu của tiêu chuẩn tương ứng dùng làm căn cứ chứng nhận hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bad0a0a8ffc6b061c16b47d641c54a9e959a9ed1e383f800eb5286ff6f9ed7640",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trường hợp tổ chức, cá nhân công bố hợp chuẩn trên cơ sở kết quả tự đánh giá thì không phải quy định về hình dạng, kết cấu, cách thể hiện và không được sử dụng dấu hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4465189c7c4ba4a761f6dd53ac53463baacaf91b9e183a6165784e54599cccfb",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Dấu hợp quy và sử dụng dấu hợp quy",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1389b9541058b4ef67a42c9f709e86ca2f8952657d328af2393f4b942ae92f0f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Dấu hợp quy có hình dạng, kích thước theo quy định tại Phụ lục I Thông tư này;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc1fb6af19b66a22c50b1d831f1ca56a8b5d255b65f522396adc2c7cd276e7841",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Dấu hợp quy được sử dụng trực tiếp trên sản phẩm, hàng hóa hoặc trên bao bì hoặc trong tài liệu kỹ thuật hoặc trên nhãn gắn trên sản phẩm, hàng hóa ở vị trí dễ thấy, dễ đọc;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0808ed5269c652f740d7af2fa37dfee7cf7c9448604c460b825a13fba5075d9b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Dấu hợp quy phải bảo đảm không dễ tẩy xóa và không thể bóc ra gắn lại;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc3ffcc0154f209581a6d49219bf2b6d5c65ac6438525adab1bfff5016fee9989",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Dấu hợp quy có thể được phóng to hoặc thu nhỏ nhưng phải đảm bảo đúng tỷ lệ, kích thước cơ bản của dấu hợp quy quy định tại Phụ lục I Thông tư này và nhận biết được bằng mắt thường;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbda5fe702c9ec53e78b43a03314477b8e26a8f48f6cf4624cf45ab1e74372570",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Dấu hợp quy phải được thiết kế và thể hiện cùng một màu, dễ nhận biết.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b71d927d2c1d2dfc1146254eed0568e828bca4262295461bb30b71b054edda9b9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 5. Các phương thức đánh giá sự phù hợp",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9d3aaedecab52617abb5a079cc456e70df0e37275554a546d25633b67b838a89",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Việc đánh giá sự phù hợp được thực hiện theo một trong các phương thức sau đây:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2a6f50cfce2bd118c13a9afa6b2829f1fc27da945c77c094157f3d2507a30066",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Phương thức 1: Thử nghiệm mẫu điển hình;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b836f8e7d15e368fbdb1606741ba279a7f2c1be433302d314f8ca2cb6a5062f80",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Phương thức 2: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy trên thị trường;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b47bea495e907e88ab42223520169ed2ec07b32675dd0e9ce0039a3b553882d64",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Phương thức 3: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất kết hợp với đánh giá quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b356c66ba9d35bb9981760774f7a1ee1c6ce90e7f447ebed2f1f2396b952342c2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Phương thức 4: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất và trên thị trường kết hợp với đánh giá quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5a18c363abf66f69d10d80d45216a605f6ecaa9e9e0960b5981c2fd9c361c8ca",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Phương thức 5: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất hoặc trên thị trường kết hợp với đánh giá quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd5d22eb15dff79fd6adffba3f9492ed2cb23fa51ddce8fd35a55670d4a577bb9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "e) Phương thức 6: Đánh giá và giám sát hệ thống quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6a813894faabfd5e8e5b434a0b61328cc1a592c186756153c4f874c1065165af",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "g) Phương thức 7: Thử nghiệm, đánh giá lô sản phẩm, hàng hóa;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b14339d7c497230d1e784dd3397277d0f3fdac95e1fda9c1a34c2a95785838ef0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "h) Phương thức 8: Thử nghiệm hoặc kiểm định toàn bộ sản phẩm, hàng hóa.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b08d9f3b7f4d80c22274abb3b8f7d57bc40c6722e9ddf95e8e47185b8e971868c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nội dung, trình tự và nguyên tắc sử dụng các phương thức đánh giá sự phù hợp được quy định tại Phụ lục II Thông tư này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b815d7e14c1887e119dc9069b40daec82f039ab7a093c289ff74d3d45b221c024",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 6. Áp dụng phương thức đánh giá sự phù hợp",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b82593236f6f8dec8ebeb0323e5bbe7ffdbaef9035268ab2e12b5635b5b4dad40",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Phương thức đánh giá sự phù hợp tiêu chuẩn áp dụng cho từng loại sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường cụ thể do tổ chức chứng nhận hợp chuẩn hoặc tổ chức, cá nhân công bố hợp chuẩn lựa chọn theo các phương thức đánh giá sự phù hợp quy định tại Điều 5 của Thông tư này. Phương thức đánh giá sự phù hợp được lựa chọn phải thích hợp với đối tượng được đánh giá để đảm bảo độ tin cậy của kết quả đánh giá sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0a66805f7f6bfe44f80a8d311f69f7ac8e23d0dbd8d8bf902a786ba0a62fb7ba",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Phương thức đánh giá sự phù hợp quy chuẩn kỹ thuật áp dụng cho sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường cụ thể được quy định tại quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9018f0fd2b87bf175dd9c77e97f06c223f767c68359cdd04a4c0e648bddcf374",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Phương thức đánh giá sự phù hợp phải được ghi cụ thể trên giấy chứng nhận phù hợp quy chuẩn kỹ thuật.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb1fae5da0c821ac2773a1a959f58762111c9793523f7365aa94f0305344a6a8c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "type": "line_break"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0
      },
      "id": "bb21793755b6c805279ae87f866801745c8944cfb50c318d3cf42cf60cfa9f032",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Chương ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "II",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bba6e64d6012b419b0e3287588df0cafee218387e254075a05e8bb727481ff329",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "CÔNG BỐ HỢP CHUẨN",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be52339644f0f3324b710f28b3a2b75228a5c038c08a2f143b2eb9bf2bc94000a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 7. Nguyên tắc công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be2a23ca6936e803a7b510f7a888fb957aca6559ed8608731fd3762f34c9d01de",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Đối tượng của công bố hợp chuẩn là sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quy định trong tiêu chuẩn tương ứng. Công bố hợp chuẩn là hoạt động tự nguyện.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b544726d09cb1caa75fcd8d4df8a0e3907ad47bca0b111d527d2fd76fe72e7adb",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Việc công bố phù hợp tiêu chuẩn tương ứng dựa trên:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9adb45f004bf2095fdeed64920cd10fa09e5487ebfa13b17bbc85d6af39ca519",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Kết quả chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký thực hiện hoặc;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb6a9f9b69885f159df90a3c49c96359570992f8f3fae37dd8e7a4de4f788e72f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kết quả tự đánh giá sự phù hợp của tổ chức, cá nhân công bố hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2cf5e2b54ab6ffbd0c26e740db72252bf1c907422e4526db7e03263845c7cfec",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm phục vụ đánh giá hợp chuẩn phải được thực hiện tại tổ chức thử nghiệm đã đăng ký.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcabc9eb38e202848a042dbc39e475891b386494165c019b6900f7ced7fabc0a2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 8. Trình tự công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba1cb59a2fca4962caa484138be7b6847f2b1f3b0f204e355204c3d8f3b8cf905",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc công bố hợp chuẩn được thực hiện theo các bước sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b14c776d63b3084c309486223bb65f54e4c0448fbc030e54c9e8533ac5ccf5783",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Bước 1: Đánh giá sự phù hợp đối tượng của công bố hợp chuẩn với tiêu chuẩn tương ứng (sau đây viết tắt là đánh giá hợp chuẩn).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be1281cc5c6b7b2113876ebd5ea20f44aabff1686d3c9592487a62127f8ab973d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Việc đánh giá hợp chuẩn do tổ chức chứng nhận đã đăng ký (bên thứ ba) hoặc do tổ chức, cá nhân công bố hợp chuẩn (bên thứ nhất) thực hiện.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "babc1f8a5e8478a7dbf19a00c267258714e800d0f2d3bd1b7388d0b7f7777d946",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá hợp chuẩn được thực hiện theo phương thức đánh giá sự phù hợp quy định tại khoản 1 Điều 6 của Thông tư này;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b002e5cec579b698d48bb3fb9d7a02699189a3314df87fb02a04fbb0e548d4fd7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kết quả đánh giá hợp chuẩn quy định tại điểm a khoản 1 Điều này là căn cứ để tổ chức, cá nhân công bố hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd429ba98da2b13689641e97880fbc78f33ee2ed025b9e1fca5c637b2adeec353",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Bước 2: Đăng ký hồ sơ công bố hợp chuẩn tại Chi cục Tiêu chuẩn Đo lường Chất lượng tỉnh, thành phố trực thuộc Trung ương nơi tổ chức, cá nhân sản xuất đăng ký doanh nghiệp hoặc đăng ký hộ kinh doanh (sau đây viết tắt là Chi cục).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b959bfbb4dc785dfb0dfbc02ec511ad2bf274bcd9fe337a360b089804792a0e77",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 9. Hồ sơ đăng ký công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be5dda4bcc5dbe91138bf4acf75eadc9e2424999410e64e2871f03b5d5a6b9684",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tổ chức, cá nhân công bố hợp chuẩn lập 02 (hai) bộ hồ sơ công bố hợp chuẩn, trong đó 01 (một) bộ hồ sơ nộp trực tiếp hoặc gửi hồ sơ qua đường bưu điện tới Chi cục và 01 (một) bộ hồ sơ lưu giữ tại tổ chức, cá nhân. Thành phần hồ sơ được quy định như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7077482055237e77c0c14bc2872713dd7d5205ce05c6f59b93fb013ace50650f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Trường hợp công bố hợp chuẩn dựa trên kết quả chứng nhận hợp chuẩn của tổ chức chứng nhận đã đăng ký (bên thứ ba), hồ sơ công bố hợp chuẩn gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5c6c274022e2cdfde0badb6a0a291f608a1390c1140dad881a057160071376a9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Bản công bố hợp chuẩn (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b32d9643334ce9e49a08b36e9a5540565e96dc24b521af86d93f250cbdd7b8811",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp chuẩn (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Giấy chứng nhận đăng ký hộ kinh doanh ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "babf819701568487e469490342d5c7803ce8dfcb9e314931f796367a6edca93cf",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Bản sao y bản chính tiêu chuẩn sử dụng làm căn cứ để công bố;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3ae6a69825d85395abf347f521921c2142d5adc9e9d07f26b9a2c2155fad5d8b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Bản sao y bản chính Giấy chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký cấp kèm theo mẫu dấu hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b05b2a63f593a4c5ba7accd41d9b1f6ee6238a0956ec9779278219daac2b82024",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có chứng thực.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b40682d926412a6752d67ecb473af74ca5d4af8754dcdd5a085431368e5c14e32",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Trường hợp công bố hợp chuẩn dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), hồ sơ công bố hợp chuẩn gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7e6b6e2387cc1d48895ae5f5f06ed1c643a008e7d0cdb6af78bf035b794a8bb3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Bản công bố hợp chuẩn (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0d9afd766efb55c56922dbd99f37a0bc79d87040c410a859f6d1b5aabb7c9d02",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp chuẩn (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Giấy chứng nhận đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be9e3be4b65b97dcfb5d2c430b950a9d4e3af527b2f120e130656e638cbebc05a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Bản sao y bản chính tiêu chuẩn sử dụng làm căn cứ để công bố;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd3d832a3b9fcf2c3744a7f20fe4eb83f3bab989e44d848f8cb8074ea641e071c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Trường hợp tổ chức, cá nhân công bố hợp chuẩn chưa được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp của tổ chức, cá nhân phải có quy trình sản xuất kèm theo kế hoạch kiểm soát chất lượng được xây dựng, áp dụng (theo Mẫu 1. KHKSCL quy định tại Phụ lục III Thông tư này) và kế hoạch giám sát hệ thống quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0ffdc067d45f7be1a174fb456e7d48ad28ad097d3926e425eb6c72788dd1ee97",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Trường hợp tổ chức, cá nhân công bố hợp chuẩn được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp của tổ chức, cá nhân phải có bản sao y bản chính Giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý còn hiệu lực;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcbf2b15a86430e2aa3ab0a1ce97fc561cbf5aa8b7955b17e5cab31b9c1cfeb0f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "e) Báo cáo đánh giá hợp chuẩn (theo Mẫu 5. BCĐG quy định tại Phụ lục III Thông tư này) kèm theo bản sao y bản chính Phiếu kết quả thử nghiệm mẫu trong vòng 12 tháng tính đến thời điểm nộp hồ sơ công bố hợp chuẩn của tổ chức thử nghiệm đã đăng ký.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdc1e6974cc2cf56d928bbc4d47c5914d52e6b8b6dce8a2cfa36e86b0ae2dec5f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có chứng thực.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b59bc23776f794fb97ea045bda05143cb470d01046a826cd428139b1523ba79df",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 10. Xử lý hồ sơ công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd66a3bbf2805af29c20f09fa7346baa56ee8edba02ced2bc0f546d9d9398dd3e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Hồ sơ công bố hợp chuẩn gửi tới Chi cục được xử lý như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd8923d55d870b007441549045487d87e75016aee36eacb087a2e59f93d441c77",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Đối với hồ sơ công bố hợp chuẩn không đầy đủ theo quy định tại Điều 9 của Thông tư này, trong thời hạn 03 (ba) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp chuẩn, Chi cục thông báo bằng văn bản đề nghị bổ sung các ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "loại giấy tờ theo quy định tại Điều 9 của Thông tư này tới tổ chức, cá nhân công bố hợp chuẩn. Sau thời hạn 15 (mười lăm) ngày làm việc kể từ ngày Chi cục gửi văn bản đề nghị mà hồ sơ công bố hợp chuẩn không được bổ sung đầy đủ theo quy định, Chi cục có quyền hủy bỏ việc xử lý đối với hồ sơ này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2907459f6e6c23fc9960a60f11e48a2df153b9cae9c2ebd9e43a4c4dd44c072d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Đối với hồ sơ công bố hợp chuẩn đầy đủ theo quy định tại Điều 9 của Thông tư này, trong thời gian 05 (năm) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp chuẩn, Chi cục phải tổ chức kiểm tra tính hợp lệ của hồ sơ công bố hợp chuẩn để xử lý như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba20d219950c98f3256b200975f90af68e2dc21f2d6b06f111a7345f687f85622",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Trường hợp hồ sơ công bố hợp chuẩn đầy đủ và hợp lệ, Chi cục ban hành Thông báo tiếp nhận hồ sơ công bố hợp chuẩn cho tổ chức, cá nhân công bố hợp chuẩn (theo Mẫu 3. TBTNHS quy định tại Phụ lục III Thông tư này). Thông báo tiếp nhận hồ sơ công bố hợp chuẩn có giá trị theo giá trị của giấy chứng nhận hợp chuẩn do tổ chức chứng nhận đã đăng ký cấp hoặc có giá trị 03 (ba) năm kể từ ngày lãnh đạo tổ chức, cá nhân ký xác nhận báo cáo đánh giá hợp chuẩn (đối với trường hợp tổ chức, cá nhân tự đánh giá hợp chuẩn).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb48ad3ec295a5978475ae7057a6ef64ce81af8f12c972a16024c5fce10e01ec1",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Trường hợp hồ sơ công bố hợp chuẩn đầy đủ nhưng không hợp lệ, Chi cục thông báo bằng văn bản cho cho tổ chức, cá nhân công bố hợp chuẩn về lý do không tiếp nhận hồ sơ.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcc9c3ef6bd53920008713e73f5d955907ae9fa0e11866183f0714d8b371f00f0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 11. Trách nhiệm của tổ chức, cá nhân công bố hợp chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b93ca721832138c6f9976629063f98a0615d6cfc5bbcf0c38cb8df3d6c8ec2fc4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Lựa chọn phương thức đánh giá sự phù hợp phù hợp với đối tượng của công bố hợp chuẩn để đảm bảo độ tin cậy của kết quả đánh giá.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc80332f14d7b9b1b7ab34aa7f212bad28d84b51a2e9d220ee2aac00416153e47",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Duy trì liên tục và chịu trách nhiệm về sự phù hợp của các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã đăng ký công bố hợp chuẩn; duy trì việc kiểm soát chất lượng, thử nghiệm và giám sát định kỳ tại cơ sở sản xuất, kinh doanh của tổ chức, cá nhân.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc75f27e25cf8382314a11b21b297fdadb91bf32ed3c670ae17fe79c69f002640",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Khi phát hiện sự không phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp chuẩn trong quá trình lưu thông, sử dụng, tổ chức, cá nhân phải:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b88a76d85fe028bab9c2d916ac2490e65b747e05c2953b5422ff7f4d86f223a57",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Tạm ngừng việc xuất xưởng và tiến hành thu hồi các sản phẩm, hàng hóa không phù hợp đang lưu thông trên thị trường trong trường hợp sản phẩm, hàng hóa không phù hợp có rủi ro cao gây mất an toàn cho người sử dụng; ngừng vận hành, khai thác các quá trình, dịch vụ, môi trường liên quan khi cần thiết;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b98b05a1de556ea8e6e777368ae10539441bb5fae979b557351303243a9b1830d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Tiến hành các biện pháp khắc phục sự không phù hợp;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc8b9da7d3baa847508bbbf037dd4e0fe87d92d53d33c7a8b6e5d6a7b7840aa6b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Thông báo bằng văn bản cho Chi cục về kết quả khắc phục sự không phù hợp trước khi tiếp tục đưa các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường vào sử dụng, lưu thông, khai thác, kinh doanh.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5611f952d0a6975c20233d82b1db252d30f5197887a9ad94be1bcaff9007dd46",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "4. Lập và lưu giữ hồ sơ công bố hợp chuẩn như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0e74163def518705cd78e2b0aec55c4383f6171d6ec1584f1562d78acc8640d5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Trường hợp công bố hợp chuẩn dựa trên kết quả chứng nhận hợp chuẩn của tổ chức chứng nhận đã đăng ký (bên thứ ba), lưu giữ hồ sơ công bố hợp ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "chuẩn bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 1 Điều 9 và Hồ sơ đánh giá giám sát của tổ chức chứng nhận đã đăng ký;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b024731017849e9a1f61763e8a68c52b0f768def6497eca5788641882dd230c74",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Trường hợp công bố hợp chuẩn dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), lưu giữ hồ sơ công bố hợp chuẩn bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 2 Điều 9 và Hồ sơ tự đánh giá giám sát của tổ chức, cá nhân theo kế hoạch giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba23961b5f6c351176f6bfa85f7a1bb6d127241368a27f08bae076ed59f135956",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "5. Cung cấp tài liệu chứng minh việc đảm bảo sự phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường với tiêu chuẩn tương ứng khi có yêu cầu của cơ quan nhà nước có thẩm quyền.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b527de75682373e6b6afe3f9011b6ee32b7d2e24d82a59b947ed0488abc35ad3b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "6. Cung cấp bản sao y bản chính Thông báo tiếp nhận hồ sơ công bố hợp chuẩn cho tổ chức, cá nhân kinh doanh sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b27ced65cf49789b6f7451d9caa6f51f0f1d7db12e1fae542b14ee6d17ddbe92f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "7. Thực hiện việc công bố lại khi có bất kỳ sự thay đổi nào về nội dung hồ sơ công bố hợp chuẩn đã đăng ký hoặc có bất kỳ sự thay đổi nào về tính năng, công dụng, đặc điểm của sản phẩm, hàng hóa, dịch vụ đã công bố hợp chuẩn.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd52c293381edce114cc82bc002fcf3b3871dc8744123d0d005afd97faa0a062d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Chương ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "III",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3c97054b72e9bd0760fc6e1c2c44663253908c113c9475e10beb105e43c22eff",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "CÔNG BỐ HỢP QUY",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b14d43823ee371a5f0b2fa9a384990541ff13efd815493dc831c5d4689a8cbf23",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 12. Nguyên tắc công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b70b7ed3c2561bff6bafbf02862d110726c3ec401dd6c4b09e57ea892eeeb5e6e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Đối tượng của công bố hợp quy là sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quy định trong quy chuẩn kỹ thuật quốc gia do các Bộ quản lý ngành, lĩnh vực ban hành hoặc được quy định trong quy chuẩn kỹ thuật địa phương do Ủy ban nhân tỉnh, thành phố trực thuộc Trung ương ban hành. Công bố hợp quy là hoạt động bắt buộc.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8303cceabc05cf910353efb3253671831c0feaccbb0fc4d32dfc5f738c97307b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Việc công bố phù hợp quy chuẩn kỹ thuật dựa trên một trong hai trường hợp sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2299807204c38449e4c81d656a8c0b2586dd0650f0531c531a13d942a5a6fe24",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Kết quả chứng nhận hợp quy theo quy định tại quy chuẩn kỹ thuật tương ứng và do tổ chức chứng nhận được chỉ định thực hiện;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf0ea6533d6bf046de7842f4098b6bb6479aabde9d0085ff21fe4e16763eb2bfa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kết quả tự đánh giá sự phù hợp của tổ chức, cá nhân công bố hợp quy.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b624a277f8f5e84806666fe7b2904d470c55d4eac7f014f5690ea6c788f390120",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm phục vụ đánh giá hợp quy được thực hiện tại tổ chức thử nghiệm đã đăng ký.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6c059cecc06023765f1dd33df1402ef11b9bf4850b21f942a3e5797388ad4861",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Trường hợp sản phẩm, hàng hóa được quản lý bởi nhiều quy chuẩn kỹ thuật khác nhau thì tổ chức, cá nhân phải thực hiện việc đăng ký bản công bố hợp quy tại các cơ quan chuyên ngành tương ứng và dấu hợp quy chỉ được sử dụng khi sản phẩm, hàng hóa đó đã thực hiện đầy đủ các biện pháp quản lý theo quy định tại các quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb1b4af10f572998c9c34c0e2bf3f1c4d68a880e24aed5c2b210a4b4f9cb32d8a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 13. Trình tự công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4c647ff449b51ee2ba831676edf4a59ac038849361b90b2ea9ad90fcf971bea5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc công bố hợp quy được thực hiện theo các bước sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b54b2be1cdb2fd9730e70b1d8a7e1350203d64de8f25d06a70de4d1580342654a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Bước 1: Đánh giá sự phù hợp đối tượng của công bố hợp quy với quy chuẩn kỹ thuật tương ứng (sau đây viết tắt là đánh giá hợp quy).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bab619551c4c4a8de327c95295ca8f65cd6363ff18a6f2627e5c21310abe1ccdd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Việc đánh giá hợp quy có thể do tổ chức chứng nhận được chỉ định (bên thứ ba) hoặc do tổ chức, cá nhân công bố hợp quy (bên thứ nhất) thực hiện.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b00362ec7d09d9fcd7aaa9b2754185854ccfc306d08d9370b1966c69ce8183c45",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá hợp quy được thực hiện theo phương thức đánh giá sự phù hợp quy định trong quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b89b09e576a045694b688cabd1725b2ccbf7449ce2cee4c0b532068a98764abcd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trường hợp sử dụng kết quả đánh giá sự phù hợp của tổ chức đánh giá sự phù hợp nước ngoài thì tổ chức đánh giá sự phù hợp nước ngoài phải được thừa nhận theo quy định của pháp luật hoặc được cơ quan quản lý nhà nước có thẩm quyền chỉ định;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b171ba49f36499295569e967ea77bbd6f6d34a6ae30722742df5eb840e567731f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kết quả đánh giá hợp quy là căn cứ để tổ chức, cá nhân công bố hợp quy.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9abab1e3b332f3e87803b71565c65a6c562fc69ba6d6f11bcaf73df10cd4192d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Bước 2: Đăng ký bản công bố hợp quy tại cơ quan chuyên ngành do Bộ quản lý ngành, lĩnh vực và Ủy ban nhân tỉnh, thành phố trực thuộc Trung ương chỉ định (sau đây viết tắt là cơ quan chuyên ngành).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7d9aeca3396d1da28cc71a27d2089afe054c672ef7ce8fbeb609c4c1d7be0f84",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 14. Hồ sơ đăng ký công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2dcf73aa85f210942c2366897cc5b3ada8890025caec54fb5ecec9831dfbefff",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tổ chức, cá nhân công bố hợp quy lập 02 (hai) bộ hồ sơ công bố hợp quy, trong đó 01 (một) bộ hồ sơ nộp trực tiếp hoặc gửi hồ sơ qua đường bưu điện tới cơ quan chuyên ngành và 01 (một) bộ hồ sơ lưu giữ tại tổ chức, cá nhân. Thành phần hồ sơ được quy định như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9b4047a11769f1c2836820c5156071642894c7a4e957d00f557b9576572f8b89",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Trường hợp công bố hợp quy dựa trên kết quả chứng nhận hợp quy của tổ chức chứng nhận được chỉ định (bên thứ ba), hồ sơ công bố hợp quy bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b27552974d0cde6abc45f4d7cc7d5d2232238b414e9c1c50a03dd2db4003ab829",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Bản công bố hợp quy (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb3a6b4a287eefca2ec7e30c7043de3b1b464d145480a1c333380348728cb8a42",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp quy (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Đăng ký hộ kinh doanh hoặc Giấy chứng nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbdcc72e64f08daad015bb31484402d34d48bdea1976ade970e9608491f703b26",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Bản sao y bản chính giấy chứng nhận phù hợp quy chuẩn kỹ thuật tương ứng do tổ chức chứng nhận được chỉ định cấp kèm theo mẫu dấu hợp quy của tổ chức chứng nhận được chỉ định cấp cho tổ chức, cá nhân.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb660db54190e62a21d7c005edcabdfb8ebd2a1791d52a41b7955f3fd83d5a5e5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có công chứng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b34fbec8171e2378098fd6c7cfd4624e76fa1865833b933ec1b23542549d480db",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Trường hợp công bố hợp quy dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), hồ sơ công bố hợp quy bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbcf56ff1cf4f112e1d6aec7f44812928a1812afd41bc172d78d5a1fff9b0c1bc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Bản công bố hợp quy (theo Mẫu 2. CBHC/HQ quy định tại Phụ lục III Thông tư này);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbb096a81f2aa61ae8903f1bba8c9fd0653f1f49890a1ef49ab99a0ae07cbc905",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Bản sao y bản chính giấy tờ chứng minh về việc thực hiện sản xuất, kinh doanh của tổ chức, cá nhân công bố hợp quy (Giấy đăng ký doanh nghiệp hoặc Giấy đăng ký kinh doanh hoặc Đăng ký hộ kinh doanh hoặc Giấy chứng ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "nhận đầu tư hoặc Quyết định thành lập hoặc Giấy tờ khác theo quy định của pháp luật);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8b958c7e2b26ffe2fa853a83c6a5e88bda9d35c7772ce4278fcde49116d55456",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Trường hợp tổ chức, cá nhân công bố hợp quy chưa được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp quy của tổ chức, cá nhân phải có quy trình sản xuất kèm theo kế hoạch kiểm soát chất lượng được xây dựng, áp dụng (theo Mẫu 1. KHKSCL quy định tại Phụ lục III Thông tư này) và kế hoạch giám sát hệ thống quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b72791192885097c10303cc61dda2c4fce597aee771fc8870bca5d5916344f45d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Trường hợp tổ chức, cá nhân công bố hợp quy được tổ chức chứng nhận đã đăng ký cấp giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý (ISO 9001, ISO 22000, HACCP...), thì hồ sơ công bố hợp quy của tổ chức, cá nhân phải có bản sao y bản chính giấy chứng nhận phù hợp tiêu chuẩn về hệ thống quản lý còn hiệu lực;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc3d1c739581d77bd71731c6f7b85f31ae0f56791517ea8dc1a12466d41f4be24",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Bản sao y bản chính Phiếu kết quả thử nghiệm mẫu trong vòng 12 tháng tính đến thời điểm nộp hồ sơ công bố hợp quy của tổ chức thử nghiệm đã đăng ký;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b41faf3ca03eb19601b9d35975236ef9044bb7af933ed202ef0e2fbe2e9c3d990",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "e) Báo cáo đánh giá hợp quy (theo Mẫu 5. BCĐG quy định tại Phụ lục III Thông tư này) kèm theo mẫu dấu hợp quy và các tài liệu có liên quan;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b36ab82c759245bc029883defee941f7edb4417bc8b00b10dce8db905cb0542c9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong quá trình xem xét hồ sơ, nếu cần thiết sẽ xem xét, đối chiếu với bản gốc hoặc yêu cầu bổ sung bản sao có công chứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdcbc2a378b66fcb4e7549a3886910c12827069f56557eea87f0f74ce085d7bb2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 15. Xử lý hồ sơ công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b702aa408e79b70bd0bc1d5195b6b8cfc1d7cc2680f32b1015aec5d656f0a14a9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Hồ sơ công bố hợp quy gửi tới cơ quan chuyên ngành được xử lý như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b16d5960d08cbc90ed5175d207ac21150716d06ca600f9ec2c43499913774dd64",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Đối với hồ sơ công bố hợp quy không đầy đủ theo quy định tại Điều 14 của Thông tư này, trong thời hạn 03 (ba) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp quy, cơ quan chuyên ngành thông báo bằng văn bản đề nghị bổ sung các loại giấy tờ theo quy định tới tổ chức, cá nhân công bố hợp quy. Sau thời hạn 15 (mười lăm) ngày làm việc kể từ ngày cơ quan chuyên ngành gửi văn bản đề nghị mà hồ sơ công bố hợp quy không được bổ sung đầy đủ theo quy định, cơ quan chuyên ngành có quyền hủy bỏ việc xử lý đối với hồ sơ này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1655e1a7c97d09c01f080bdc3e5deed040b48345e1c3ca169136415906cebabc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Đối với hồ sơ công bố hợp quy đầy đủ theo quy định tại Điều 14 của Thông tư này, trong thời gian 05 (năm) ngày làm việc kể từ ngày nhận được hồ sơ công bố hợp quy, cơ quan chuyên ngành tổ chức kiểm tra tính hợp lệ của hồ sơ công bố hợp quy:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6479c8a634f9fe725ffa87cf99f42bb4a43c380fb5af9609834355375d6f02c2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Trường hợp hồ sơ công bố hợp quy đầy đủ và hợp lệ, cơ quan chuyên ngành ban hành Thông báo tiếp nhận hồ sơ công bố hợp quy cho tổ chức, cá nhân công bố hợp quy (theo Mẫu 3. TBTNHS quy định tại Phụ lục III Thông tư này).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc7e5634438206fb75331300caa8903dca0e162fc97856679fd209ad80bef3712",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Thông báo tiếp nhận hồ sơ công bố hơp quy có giá trị theo giá trị của giấy chứng nhận hợp quy do tổ chức chứng nhận được chỉ định cấp hoặc có giá trị ba (03) năm kể từ ngày lãnh đạo tổ chức, cá nhân ký xác nhận báo cáo đánh giá hợp quy (đối với trường hợp tổ chức, cá nhân tự đánh giá hợp quy);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1048669c51ee6ef218bbc8bcb96909a1abf156d36fb5348d87fb79366f355f4e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Trường hợp hồ sơ công bố hợp quy đầy đủ nhưng không hợp lệ, cơ quan chuyên ngành thông báo bằng văn bản cho tổ chức, cá nhân công bố hợp quy về lý do không tiếp nhận hồ sơ.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b809031a595d6f395d2dd3fd56903a513d759fc79e1771118ac18c42b721c2054",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 16. Trách nhiệm của tổ chức, cá nhân công bố hợp quy",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2f1b3bbc858fa78f5871d4b48824fd6842a588f933cf20c470dac9718b8c5dff",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Thông báo trên các phương tiện thông tin thích hợp về việc công bố hợp quy của mình đảm bảo người sử dụng sản phẩm, hàng hóa đó dễ dàng tiếp cận.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9a5e7951f064513fdd242befa284cec883eda368d97541e14fd064dc039fc1fc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Duy trì liên tục và chịu trách nhiệm về sự phù hợp của các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp quy; duy trì việc kiểm soát chất lượng, thử nghiệm và giám sát định kỳ.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b87224b7c85f238eb64e9761236ae7499c5a31813e11041ec8bf8dfe1ee1c268d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Sử dụng dấu hợp quy đối với sản phẩm, hàng hóa đã được công bố hợp quy theo quy định tại khoản 2 Điều 4 của Thông tư này trước khi đưa ra lưu thông trên thị trường. Lập sổ theo dõi và định kỳ hàng năm báo cáo việc sử dụng dấu hợp quy cho tổ chức chứng nhận được chỉ định.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbd226f357a400fa5c95b3317342c873a98200c38932598020a4fcd6c56bceb97",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "4. Khi phát hiện sự không phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã công bố hợp quy trong quá trình lưu thông hoặc sử dụng, tổ chức, cá nhân phải:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bacbfa81fc22ef320120ac091c4fdffddd7e32c646f6b65e76625bdeb669ee59c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Kịp thời thông báo bằng văn bản về sự không phù hợp với cơ quan chuyên ngành;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b34acff3e60b84160ef8ad2a88fea5dc271737923a7f7603460c85ea23490d93e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Tạm ngừng việc xuất xưởng và tiến hành thu hồi các sản phẩm, hàng hóa không phù hợp đang lưu thông trên thị trường trong trường hợp sản phẩm, hàng hóa không phù hợp có rủi ro cao gây mất an toàn cho người sử dụng; ngừng vận hành, khai thác các quá trình, dịch vụ, môi trường liên quan khi cần thiết;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2b75455d9b3ef6ba9f130add91b0b96f068ba1372adc3fdd429688dbb15750bb",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Tiến hành các biện pháp khắc phục sự không phù hợp;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b18bce969140c60cf3a87189d943abb3eda5ba31bf73022751dd7e06c25662b8b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Thông báo bằng văn bản cho cơ quan chuyên ngành về kết quả khắc phục sự không phù hợp trước khi tiếp tục đưa các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường vào sử dụng, lưu thông, khai thác, kinh doanh.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b68bfe8dcbfc8ddaf4495ebcdfb426bfc69df13729f18ce67b67acfeeac43455c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "5. Lập và lưu giữ hồ sơ công bố hợp quy làm cơ sở cho việc kiểm tra, thanh tra của cơ quan quản lý nhà nước như sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b80929782318ae61348d48ccf4c1e9872492dfe187dfd6eaf7aeb6624cabb3931",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Trường hợp công bố hợp quy dựa trên kết quả chứng nhận hợp quy của tổ chức chứng nhận được chỉ định (bên thứ ba), lưu giữ hồ sơ công bố hợp quy bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 1 Điều 14 và Hồ sơ đánh giá giám sát của tổ chức chứng nhận được chỉ định;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3f20204389bc6982eb635507a60bffd88b1669497f487b45988c660f733cda1c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Trường hợp công bố hợp quy dựa trên kết quả tự đánh giá của tổ chức, cá nhân sản xuất, kinh doanh (bên thứ nhất), lưu giữ hồ sơ công bố hợp quy bao gồm các bản chính, bản sao các giấy tờ theo quy định tại khoản 2 Điều 14 và Hồ sơ tự đánh giá giám sát của tổ chức, cá nhân theo kế hoạch giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b730c213ec4c294d4c40857aa170c3188cec47fcbbb9112f9c2f241d5922a4842",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "6. Cung cấp tài liệu chứng minh việc đảm bảo sự phù hợp của sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường với quy chuẩn kỹ thuật tương ứng khi có yêu cầu của cơ quan nhà nước có thẩm quyền.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bad574f072d8236c087baacb0f10df91f84462cbc9c861c2707020f5b08a2f0af",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "7. Cung cấp bản sao y bản chính giấy chứng nhận hợp quy, Thông báo tiếp nhận hồ sơ công bố hợp quy cho tổ chức, cá nhân kinh doanh sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b847903b551c7122f3ffe896e7d25c38bd5aacb074a1d98d7bc983c572692d6fa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "8. Thực hiện việc công bố lại khi có bất kỳ sự thay đổi nào về nội dung của hồ sơ công bố hợp quy đã đăng ký hoặc có bất kỳ sự thay đổi nào về tính năng, công dụng, đặc điểm của sản phẩm, hàng hóa, dịch vụ đã công bố hợp quy.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b340017bf723a5e60f937853d99bfaa5698c89c80099c81a78ab78c436674fd3a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Chương ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "IV",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b008ea4ae0ac6ce72c79bfb8f66745df5c460307bf23c78f790d2604756ac9ab0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "TỔ CHỨC THỰC HIỆN",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b42d0f666c9382dd389e69c8e0c6187123fd27df26455c565f2e93f727a5917f5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 17. Trách nhiệm của các cơ quan quản lý",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2a04d13beb299fe14d85f33c80824ffd5aa9b0923a64ff8241eb56bdc21f817c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Trách nhiệm của các Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7939be31bd55ca43e2706929ab898961076341423180a2420413f92c267d0cbb",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Chỉ đạo hoạt động công bố hợp quy theo quy định tại Thông tư này khi ban hành các quy chuẩn kỹ thuật tương ứng để quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb84440837a627d83005dcf8a866da3cac73bfe7195fe2832376932d1d9585552",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Chỉ định cơ quan đầu mối chịu trách nhiệm quản lý hoạt động công bố hợp quy trong lĩnh vực được phân công; thông báo danh sách cơ quan đầu mối cho các tổ chức, cá nhân có liên quan để thực hiện và gửi tới Bộ Khoa học và Công nghệ để phối hợp, quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0788f8fdd8b9b0762990d0bdd04b7d2eb5998dcce27bf273778fdb5cfdb42cdd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Giao trách nhiệm thực hiện việc tiếp nhận hồ sơ công bố hợp quy cho các cơ quan chuyên ngành;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b27343fad749b550fbe4d3b941aa04a45b535872b11b5cc44ac7564df402a3544",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Định kỳ hằng năm, tổng hợp tình hình chỉ định tổ chức đánh giá sự phù hợp, thông báo cho Bộ Khoa học và Công nghệ để phối hợp quản lý; đột xuất, khi có yêu cầu, tổng hợp báo cáo tình hình công bố hợp quy về Bộ Khoa học và Công nghệ để tổng hợp báo cáo Thủ tướng Chính phủ.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "baeba22013f6dd60ca91bcdfe4b207cdc3742f3e95240176ea6cb2d9f9003759c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Trách nhiệm của Tổng cục Tiêu chuẩn Đo lường Chất lượng là cơ quan đầu mối được chỉ định theo quy định tại điểm b khoản 1 Điều này:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bae6e5682f66c4e7f9118b912d1df22137e19f13fb6f09221372c1295f64ec3e4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Giúp Bộ Khoa học và Công nghệ thống nhất quản lý và hướng dẫn hoạt động đánh giá sự phù hợp, công bố hợp chuẩn và công bố hợp quy;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7ef3045c807f6315be7f90be388d337f9c6066790a3af0462eb88b85a4dbae76",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Phối hợp với các cơ quan đầu mối ở Trung ương thuộc các Bộ quản lý ngành, lĩnh vực, Sở Khoa học và Công nghệ các tỉnh, thành phố trực thuộc Trung ương trong việc đôn đốc, hướng dẫn thực hiện việc công bố hợp chuẩn, công bố hợp quy theo quy định tại Thông tư này;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b83f65ec3a9a9c162608d582d43538f828a8128f94914e1fe246307a231d1f988",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Thực hiện việc theo dõi tình hình công bố hợp chuẩn và công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường thuộc trách nhiệm quản lý của Bộ Khoa học và Công nghệ trên cơ sở báo cáo của các Chi cục Tiêu chuẩn Đo lường Chất lượng; theo dõi việc chỉ định của Bộ quản lý ngành, lĩnh vực về hoạt động đánh giá sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1149b9a546ed5c5d1413a901a44e13a67396945b3c405cf138c69ea3b5f287d8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Trách nhiệm của cơ quan đầu mối được chỉ định theo quy định tại điểm b khoản 1 Điều này thuộc các Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7fe3c84176d906f652ab2a3170fefe66d64a505d7e4284f2ff65fa7bba864814",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Thực hiện việc theo dõi và quản lý hoạt động đăng ký công bố hợp quy của các cơ quan chuyên ngành; phối hợp với Tổng cục Tiêu chuẩn Đo lường Chất lượng trong công tác quản lý hoạt động công bố hợp quy; định kỳ hằng năm, tổng hợp báo cáo gửi Bộ quản lý ngành, lĩnh vực và Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương liên quan về tình hình chỉ định tổ chức đánh giá sự phù hợp, đồng thời gửi về Tổng cục Tiêu chuẩn Đo lường Chất lượng để phối hợp quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b706ab998a38fcae188b7940b06130b96575d915dc96e62acf05fbd0843c6842d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Tổng hợp tình hình hoạt động công bố hợp quy của các cơ quan chuyên ngành và định kỳ hằng năm, đột xuất khi có yêu cầu, báo cáo Bộ quản lý ngành, lĩnh vực, Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương liên quan.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b857415ad0b85d8cd01e7b0294c7ba280c49da8da28d12d843f8e086ad230b258",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "4. Trách nhiệm của cơ quan chuyên ngành do các Bộ quản lý ngành, lĩnh vực, Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chỉ định:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2d7b0448c0aeb584e6b24023dfdf694ed5ebe58bfffcdbf47825fa084187239f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Tiếp nhận hồ sơ đăng ký và quản lý hồ sơ công bố hợp quy; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quản lý bởi các quy chuẩn kỹ thuật quốc gia do các Bộ quản lý ngành, lĩnh vực ban hành và các quy chuẩn kỹ thuật địa phương liên quan đến các lĩnh vực được phân công quản lý;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b51334485b66b835a1790aa3f30604260d861e9f89d07926cc83f7ed02f6a5ac3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Công bố công khai trên trang thông tin điện tử của mình về tình hình công bố hợp quy với các nội dung sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf58a6cec6be050d04cee46d75b664f9a070dcb5b37f79ed01b4d00645db94f15",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Tên tổ chức, cá nhân công bố hợp quy;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8577b59a0091437d546807fde3bfe45193760e4b534184a8004aabe689d83ed6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Sản phẩm, hàng hóa công bố hợp quy;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf9b8d033ec928d69fd3b88f836f0bd7999e9b4e801e12af78876cdabf3ea09c9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Số hiệu quy chuẩn kỹ thuật;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b772671226a293c7bf43e5c1c3ad59e3c161818793b4690897d7e088ade2b7d85",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Loại hình đánh giá: Bên thứ nhất (tên tổ chức, cá nhân) hay bên thứ ba (tên tổ chức chứng nhận được chỉ định).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7be8d9deab52c639b1bc7e17d01a2813d8ccda5f282de390f2abf546809799d5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Phối hợp với Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương trong việc cung cấp các thông tin về công bố hợp quy để thuận lợi cho việc kiểm tra chất lượng sản phẩm, hàng hóa;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3d6a000de2463cb6ce5678ea242c54a1a8ab6a7ce6c4bf7433cc54ab5618a3ad",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Định kỳ hằng năm, đột xuất khi có yêu cầu, tổng hợp, báo cáo cơ quan đầu mối danh mục sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường đã đăng ký công bố hợp quy (theo Mẫu 4. BCTNHS quy định tại Phụ lục III Thông tư này).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb54cd43b7a858ed6976a2bd7973785bf9f8f287141be84e0beab725c80ff9e14",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "5. Trách nhiệm của Chi cục Tiêu chuẩn Đo lường Chất lượng thuộc Sở Khoa học và Công nghệ các tỉnh, thành phố trực thuộc Trung ương:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba84fb52faf99e7c2f5c7dfb1d4b561f6a632e3099e41d4e35bf8401ea6b39225",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Tiếp nhận đăng ký và quản lý hồ sơ công bố hợp chuẩn; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp chuẩn của các tổ chức, cá nhân sản xuất, kinh doanh tại địa phương và công bố công khai trên trang thông tin điện tử của Sở Khoa học và Công nghệ hoặc Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương tình hình công bố hợp chuẩn;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2c62d93966f021d2c646a5246c21a75e60d011e531d57e54f66bb508dec90c63",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Tiếp nhận đăng ký và quản lý hồ sơ công bố hợp quy; hủy bỏ, đình chỉ kết quả tiếp nhận hồ sơ công bố hợp quy đối với các sản phẩm, hàng hóa, dịch vụ, quá trình, môi trường được quản lý bởi các quy chuẩn kỹ thuật quốc gia do ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "Bộ Khoa học và Công nghệ ban hành và các quy chuẩn kỹ thuật địa phương liên quan đến các lĩnh vực được phân công quản lý; công bố công khai trên trang thông tin điện tử của Sở Khoa học và Công nghệ hoặc Chi cục Tiêu chuẩn Đo lường Chất lượng địa phương tình hình công bố hợp quy với các nội dung sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bad074de091654d0b77a0742d6cf5c472a5e3c3a89bf1270291d55b7a2478601b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Tên tổ chức, cá nhân công bố hợp quy;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b90c839b059739511c811ccd9c62781a62c23dc41667603d9ad40ec2514ddebbd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Sản phẩm, hàng hóa công bố hợp quy;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b33dce500fbfb7b65444c4aef23e17b034cdb1b485f8e7a624564792ab228d057",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Số hiệu quy chuẩn kỹ thuật;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3e1adacdce53997811908a464e04b70e86f073a493731b50ef8dfcbe8565f220",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Loại hình đánh giá: Bên thứ nhất (tên tổ chức, cá nhân) hay bên thứ ba (tên tổ chức chứng nhận được chỉ định).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0da4328b7b34343e8140becff2f8e7c0d47ab54975c58d5b84d375ca2e3c44ff",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Phối hợp với cơ quan chuyên ngành ở địa phương trong việc cung cấp các thông tin về công bố hợp chuẩn để thuận lợi cho việc kiểm tra chất lượng sản phẩm, hàng hóa;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b15605c5c6b35b358bb05e9e31d7f9e37cae488d128bb46a23241c910938647cc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Định kỳ hằng năm, đột xuất khi có yêu cầu, tổng hợp, báo cáo Tổng cục Tiêu chuẩn Đo lường Chất lượng tình hình tiếp nhận hồ sơ công bố hợp chuẩn, công bố hợp quy (theo Mẫu 4. BCTNHS quy định tại Phụ lục III Thông tư này) theo quy định tại điểm a, b khoản này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1e4f3ffc3d49b6bf15603b1a03e7e832900e864250b82e6653695c9ecbeed5a7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 18. Kiểm tra, thanh tra, xử lý vi phạm",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4bd42d2fb5a2698f88b70420f7869ffe96074f6672d33f735f8ba56d3bed9087",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Cơ quan quản lý nhà nước có thẩm quyền thực hiện việc kiểm tra, thanh tra và xử lý vi phạm pháp luật trong hoạt động công bố hợp chuẩn, công bố hợp quy theo quy định tại Thông tư này và các quy định hiện hành khác có liên quan.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5d60368b6480fb11392196addea037af9a8fdb4294b5811c52efac8c65e7a1f6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Tổ chức, cá nhân vi phạm các quy định về công bố hợp chuẩn, công bố hợp quy, tùy theo tính chất, mức độ vi phạm sẽ bị xử lý theo quy định của pháp luật hiện hành có liên quan.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b20bdaae2c2d158f4b276b9077854e1bed9ac0efa550b9edb2abc3fd68d3988d6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 19. Điều khoản thi hành",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7c757a70b64d5576019282c4bd09e040dc5f0cc05a8a827f9c01781ab03bc794",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Thông tư này có hiệu lực thi hành kể từ ngày 27 tháng 01 năm 2013 và thay thế Quyết định số 24/2007/QĐ-BKHCN ngày 28 tháng 9 năm 2007 của Bộ trưởng Bộ Khoa học và Công nghệ về việc ban hành quy định về chứng nhận hợp chuẩn, chứng nhận hợp quy và công bố hợp chuẩn, công bố hợp quy.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b61cfa0d636a193dc985456a6482d1c920c3b87e0faab4833bb159ad68f9c1d38",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Điều 20. Tổ chức thực hiện",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bfe40ede6a7825c970b9ece6b8f57f01b45cb567fe55ba8bf01dc49bb6332a64b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Bộ trưởng, Thủ trưởng cơ quan ngang Bộ, Chủ tịch Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương chịu trách nhiệm tổ chức triển khai thực hiện Thông tư này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b588cfa4cc2ca73e3eabfd45b59e6f1761fd1fbd58db813c6d6842f308dfe5c01",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Tổng cục trưởng Tổng cục Tiêu chuẩn Đo lường Chất lượng có trách nhiệm hướng dẫn và tổ chức thực hiện Thông tư này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b460db9905d72f545506e50c0e8cc7764d64c0c5b0fe96e7612191a70569ff3d6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "3. Trong quá trình thực hiện, nếu có vấn đề phát sinh hoặc vướng mắc, tổ chức và cá nhân phản ánh kịp thời bằng văn bản về Bộ Khoa học và Công nghệ để nghiên cứu sửa đổi, bổ sung./.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b686de804102b6b0847e4ef4745bda7b8c0b2818fa65b6e9f0bb168f4d47acabd",
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "default"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "content": [
                                  {
                                    "text": "Nơi nhận:",
                                    "type": "text"
                                  }
                                ],
                                "direct": {
                                  "font": {
                                    "family": "Times New Roman"
                                  },
                                  "italic": true,
                                  "size_pt": 11.0,
                                  "weight": 700
                                },
                                "type": "styled"
                              },
                              {
                                "type": "line_break"
                              }
                            ],
                            "type": "strong"
                          }
                        ],
                        "type": "emph"
                      },
                      {
                        "content": [
                          {
                            "text": "- Thủ tướng Chính phủ;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Các Phó Thủ tướng Chính phủ;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Các Bộ, cơ quan ngang Bộ, cơ quan thuộc CP;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Văn phòng Quốc hội;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Văn phòng Tổng Bí thư;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Văn phòng Chủ tịch nước;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- UBND các tỉnh, thành phố trực thuộc TW;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Công báo;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Cục Kiểm soát TTHC (Bộ Tư pháp);",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Cục Kiểm tra văn bản (Bộ Tư pháp);",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Lưu: VT, PC, TĐC.",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          },
                          "size_pt": 11.0
                        },
                        "type": "styled"
                      }
                    ],
                    "direct": {
                      "font": {
                        "family": "Times New Roman"
                      },
                      "size_pt": 11.0
                    },
                    "type": "styled"
                  }
                ],
                "direct": {
                  "font": {
                    "family": "Times New Roman"
                  },
                  "size_pt": 11.0,
                  "space_before_pt": 6.0
                },
                "id": "b2f2e7fb4f0adc1819d694f6bb2540d50c0ecb9dc6ab1fdaf94e31a1020348c51",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },

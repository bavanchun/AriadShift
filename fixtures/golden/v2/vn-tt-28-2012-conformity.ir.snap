                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "content": [
                                  {
                                    "text": "Nơi nhận:",
                                    "type": "text"
                                  }
                                ],
                                "direct": {
                                  "font": {
                                    "family": "Times New Roman"
                                  },
                                  "italic": true,
                                  "weight": 700
                                },
                                "type": "styled"
                              },

                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b542530e054512afe164178747cae0710464ee21d430753e2f3b980c05433ce87",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "I. Phương thức 1: Thử nghiệm mẫu điển hình",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b68a8758473e1bb435a250c3046d5998cf4c926be95489d8dc197ba2e4d6e29c0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 1 thử nghiệm mẫu điển hình của sản phẩm, hàng hóa để kết luận về sự phù hợp. Kết luận về sự phù hợp có giá trị đối với kiểu, loại sản phẩm, hàng hóa đã được lấy mẫu thử nghiệm.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba123aa39354f97059e855aa5b86161a7b28ea213342252ac22581802ed8f046a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động chính trong Phương thức 1 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf91ebc8c24dd3e7615c3369601b539636e6b81e70012f406bb29a6b5aaedd873",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7e02effbc9c7c3c62a5d260fd6f6e63a1a6a0b614a2cb49e4a49235f037845de",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành lấy mẫu điển hình cho sản phẩm, hàng hóa. Mẫu điển hình của sản phẩm, hàng hóa là mẫu đại diện cho một kiểu, loại cụ thể của sản phẩm, hàng hóa được sản xuất theo cùng một dạng thiết kế, trong cùng một điều kiện và sử dụng cùng loại nguyên vật liệu.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bade24c0799a2cbc079d0a338060a48c493630e6f0882a063cec7b8cec36f8cea",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Số lượng mẫu phải đủ cho việc thử nghiệm và lưu mẫu.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bae1640949657f40cafaa1abe5d2e1abe4606ec170e9021c9217e09daa95e883e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8404a742c4ee858c1cb7df933569b1dc2bf053ff51f5435065300c03df9e306f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Mẫu sản phẩm, hàng hóa được thử nghiệm tại phòng thử nghiệm đã đăng ký lĩnh vực hoạt động thử nghiệm theo quy định của pháp luật, có thể bao gồm cả phòng thử nghiệm của nhà sản xuất. Ưu tiên sử dụng phòng thử nghiệm được chỉ định và được công nhận.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b78ea60d27cec74bfc2a298f22b864cf9602c430b1afe3d8eae68b4d4061fad23",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Các đặc tính của sản phẩm, hàng hóa cần thử nghiệm và phương pháp thử nghiệm được quy định trong tiêu chuẩn, quy chuẩn kỹ thuật tương ứng",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb1514ff51270f22012a38f8f73dc427b5890ab1ed92445129f85cc546b59bd15",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6505b3a96f018fcf40b8747e256abab666214098397b9892d11c7e0aa184aa3b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Xem xét các đặc tính của sản phẩm, hàng hóa qua kết quả thử nghiệm mẫu so với yêu cầu của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4c1d6951f54f0b8769ac7fd4698a6f34464ce75d378ca8db46a49244875651e8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Kết luận về sự phù hợp",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b38781d0992907c5bf82bde59af02132bbf37fbda6c6b07ed47d035c34ff99c88",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết luận về sự phù hợp của sản phẩm, hàng hóa so với yêu cầu của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng. Sản phẩm, hàng hóa được xem là phù hợp nếu tất cả các chỉ tiêu của mẫu thử nghiệm phù hợp với mức quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b636c25778832d2f7cbb209d4abf08be11cf9536ad0179e0f240abd485be1d3f1",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng phương thức 1",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc4807839b4228da552960b61573a856bfa94ca7f77ebcc51f79d6bf5b843490c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 1 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba41966f28f26ee036017ad32452e959a9f4db7cd4064392938562d10a59a5804",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Thiết kế của sản phẩm, hàng hóa cho phép xác định rõ sản phẩm, hàng hóa theo từng kiểu, loại đặc trưng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bfc213a37ad5b7c85c1e0c476990aa649353cfc28826f8af7e6b6047b1a9df628",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Không tiến hành xem xét được các yêu cầu đảm bảo duy trì ổn định chất lượng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1e51b3581b30d92886785b907e609e05cc1c2218e3d12270846149ebae7731fe",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "II. Phương thức 2: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy trên thị trường",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb33bfd8056a489c92e4aeb53933a60047f616df2553da6e8ed00a0961236c34a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 2 căn cứ kết quả thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất để kết luận về sự phù hợp của sản phẩm, hàng hóa. Việc đánh giá giám sát sau đó được thực hiện thông qua thử nghiệm mẫu sản phẩm, hàng hóa lấy trên thị trường.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd80f44febfcf07afc7226b738f59f72cf9b9cca0dbe4266c0ed8d9f509693ba3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động chính trong Phương thức 2 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcf6d3982805bfb257388a30e3ed40d28c01bca220112369a0d14fc737e9686d0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2023e9a232b300fc37050bf3303259673fc50fb8d0e35ae7f4471b7695bbb84d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.1 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7f4f906b8b5c724983d5773983096121a7c7126e5fc1c11764118029d9c9b65b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb3ff77d489760834f3ae744868c76dd0e1f239dd266631e8a2e03c63f5ba8176",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.2 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b04c291713cfebd4ac8c81fe75e94682bef28bde7bdf9eeade091e59a8d194e79",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Đánh giá sự phù hợp của quá trình sản xuất:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b29f704a374b92a50d86f8d385d4b17256d67fdb3605e8a2b0de7249522d815fa",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá quá trình sản xuất phải xem xét đầy đủ tới các điều kiện kiểm soát của nhà sản xuất liên quan đến việc tạo thành sản phẩm nhằm đảm bảo duy trì ổn định chất lượng sản phẩm, hàng hóa. Các điều kiện kiểm soát bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3d07f9b483cb0364bf0428cb83ea080a964a9e4e116319ef1bbffe5d3bed5d36",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Kiểm soát hồ sơ kỹ thuật của sản phẩm (tài liệu thiết kế, tiêu chuẩn kỹ thuật của sản phẩm);",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b632caafff704090faba0b907fd078afbda3afe86a06cf37cbbb5c03bb1325566",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kiểm soát toàn bộ quá trình sản xuất từ đầu vào, qua các giai đoạn trung gian cho đến khi hình thành sản phẩm bao gồm cả quá trình bao gói, xếp dỡ, lưu kho và vận chuyển sản phẩm;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc0f0aa816eef0f8175fbb3f7726a65b53919afeef165cd000acbdf1128d717a4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Kiểm soát chất lượng nguyên vật liệu, bán thành phẩm và thành phẩm;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b01f37960a1de770b5c5ca83d8a110ab1dbb0ee7c1901de0ba7eac245dbefb5de",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Kiểm soát trang thiết bị công nghệ và trang thiết bị đo lường, kiểm tra, thử nghiệm;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3abd2b5a36bec3cccc13e5bd3d9bc37f343c645e43a61a5d524f73ae9f5a7aac",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Kiểm soát trình độ tay nghề công nhân và cán bộ kỹ thuật;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b25b2d08bc7de36b16ea1155f5d12beba1814a582d7c2b5fc508c213da72a84de",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "e) Các nội dung kỹ thuật cần thiết khác.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b57a3b4235bb58be8e94bce73c9703681453ec5204e430d53c7f31402405bd73c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trường hợp nhà sản xuất đã có chứng chỉ hệ thống quản lý chất lượng của tổ chức chứng nhận đã đăng ký lĩnh vực hoạt động chứng nhận hoặc được thừa nhận đối với lĩnh vực sản xuất sản phẩm, hàng hóa được đánh giá, không cần phải đánh giá quá trình sản xuất. Tuy nhiên, nếu có bằng chứng về việc không duy trì hiệu lực HTQLCL, tổ chức chứng nhận cần tiến hành đánh giá quá trình sản xuất, đồng thời báo cáo về Tổng cục Tiêu chuẩn Đo lường Chất lượng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4af56ada5b98ff9cf5d627748aa13b0aa92c7dd04415370763e129236423fd82",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7d1409db61007aa514bfc7e9bb4fe9d79bd2e7668a3cbb0f3f66401021eee050",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Xem xét các đặc tính của sản phẩm, hàng hóa qua kết quả thử nghiệm mẫu so với yêu cầu của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb45f0768bf33f9431660c4a7c20d93d10a90ef0cb2b4d7107f2ba4f257befee8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Xem xét sự phù hợp của quá trình sản xuất so với yêu cầu quy định tại mục 1.3 của phương thức này.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd16da6310c712ae1129b84cd8d32f4fed8f352bba5b67433770865cfbc7601cc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.5. Kết luận về sự phù hợp",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b84baf0dfdf43047d206d22e2114829ee7c5f0e3e45578468b97375cfc2a28c95",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết luận về sự phù hợp của sản phẩm, hàng hóa so với yêu cầu của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng. Sản phẩm, hàng hóa được xem là phù hợp nếu đảm bảo đủ 2 điều kiện sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bfd5c998766c255ff6ef5cd219132eeff1aafca494e0bb3ff1a39f141d695ddf0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Tất cả các chỉ tiêu của mẫu thử nghiệm phù hợp với mức quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0c5083b5726bcc81ffa1b527862a8bd4acc911045b14ceb85b772fd2eb7b6f5f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Kết quả đánh giá quá trình sản xuất phù hợp với yêu cầu.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b456aee65ab90f2dcc18cfac013bb33b24ce8f074a3058afb9ae1e356457cfea3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết luận về sự phù hợp của sản phẩm, hàng hóa có giá trị hiệu lực tối đa 3 năm với điều kiện sản phẩm, hàng hóa được đánh giá giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf256f9a41c60bc85413d4f8617b611ce720aeb9c8d960c791663605c956010f6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.6. Giám sát:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7ab11b5b5a720772c5142dbb8751e10e13739e418779cd6a0148dd3bd9732d16",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong thời gian hiệu lực của kết luận về sự phù hợp, sản phẩm, hàng hóa phải được đánh giá, giám sát thông qua việc thử nghiệm mẫu lấy trên thị trường. Tần suất đánh giá, giám sát phải đảm bảo không được quá 12 tháng/1 lần.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc45fd1d98ff986472ecbacdd5fc294bdc2bd02a286b42aa4651f5e058265a53b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm mẫu sản phẩm, hàng hóa được thực hiện như quy định tại mục 1.1, 1.2 và 1.3 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bec63ad7c191ae60b1df23c9e4e83ffdc46ae9622249a5a699cd61d9e75fdca1f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết quả đánh giá giám sát sẽ được sử dụng làm căn cứ để quyết định việc duy trì, đình chỉ hay hủy bỏ kết luận về sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf0e006999b5fa87055db7e1af99986abe4a34c332b5fb118676ac65b9a5d5884",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng phương thức 2:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "baf50708e155e4c069524dd327f4a2f4c7cd7684dd023d7b7d570699363371b82",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 2 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b17e2f65706024792c00bb41b75269b9ed174046ac8ea08b01b33a5456eb2d675",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Sản phẩm, hàng hóa thuộc diện có nguy cơ rủi ro về an toàn, sức khỏe, môi trường ở mức thấp;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc9587da6d3d5ff8b3af121066d6a1a9f76fe57e2cc40c81cb5b34b57f6efa75b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Thiết kế của sản phẩm, hàng hóa cho phép xác định rõ sản phẩm, hàng hóa theo từng kiểu, loại đặc trưng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba2a4358afc06a7c0476709159e11d8f2cde3db25685a7666e8146aa468266a5c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Cần quan tâm tới việc duy trì ổn định các đặc tính chất lượng của sản phẩm, hàng hóa trong quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b82110f9019a196271e543951acf3a2b4128523a1c6a9a2ab9e6fe0ed6e174008",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Chất lượng của sản phẩm, hàng hóa có khả năng bị biến đổi trong quá trình phân phối lưu thông trên thị trường;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bec79b90783f85fed9790965876dcc69fd94cb342700800289b3bec6a654e6c97",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Tổ chức, cá nhân sản xuất, kinh doanh sản phẩm, hàng hóa có các biện pháp hữu hiệu để thu hồi sản phẩm, hàng hóa từ thị trường khi phát hiện sản phẩm, hàng hóa không phù hợp trong quá trình giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc39e315a7a08c7419314a05047b5439ce23edc921bedb797acbfb3e75811a1d9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "III. Phương thức 3: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất kết hợp với đánh giá quá trình sản xuất",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdb58498a8c9656a11354e87376be26359226f37f24393ddab0703533f62dffbc",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 3 căn cứ kết quả thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất để kết luận về sự phù hợp. Việc đánh giá giám sát được thực hiện thông qua thử nghiệm mẫu sản phẩm, hàng hóa lấy từ nơi sản xuất kết hợp với đánh giá quá trình sản xuất.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1609a86e8f599d87a0354e42b0c1ae8e644c20cc36d04ef2c11cc491035fe7d8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động cơ bản trong Phương thức 3 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb7d279e81c61c9454fc9965bd710dcab8f0746703def637e84e9984f6c0e4bd6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bff2a7232de3742f5670ecc588bea6e8b2bc60a4ba9001ae0839498e550669728",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.1 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf68f4819c64bf86d78bf020878563b614b89ebcea853e20100e49171f7042215",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0352902cff9a48bff4e46397c5b238c871f3369da11fba619e0da5f65904bd0b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.2 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba5e37d232080593a110378cc84291b05175590fd99cdf4770eae0478d2d48b91",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Đánh giá sự phù hợp của quá trình sản xuất:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b81f62ae8ab8296a2915b9a6da184faf2ff2054ac2fa6bd4dcd4da0b66367eec1",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7ae9d4842b8d4caa38394d371735a704960787cb9e123ff7c48cd45b710c63cf",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b16df41d0400b764cc7df9f8a46996b1e92b56c82611fdf84de87522591d64452",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.4 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdca8e68b227f0af80fe331d1b740ba8e183cedb50c41c23f6c8df2ae218cd5b9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.5. Kết luận về sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0f47a2f8389aa55a70a87f25bd739d31163ca20c9ab4e84324bf9870aea37162",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.5 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb5f11b32fe0cffde399853cf280122703702f6ee24750e29157b2b3d576b184a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.6. Giám sát:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b591bed8bc3740300ddc87b4e2dce2e818a36544a26147b3468a666f70a831297",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong thời gian hiệu lực của kết luận về sự phù hợp, sản phẩm, hàng hóa phải được đánh giá, giám sát thông qua việc thử nghiệm mẫu lấy tại nơi sản xuất kết hợp với đánh giá quá trình sản xuất. Tần suất đánh giá, giám sát phải đảm bảo không được quá 12 tháng/1 lần.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b55631168e0432a215990b734769a8721d9c35470a957a0c7aa9a2feee1ba0222",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm mẫu sản phẩm, hàng hóa được thực hiện như quy định tại mục 1.1, 1.2 và 1.3 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b742bee49cacde3559eca44869413479cde8a384f62dbd49cd2905ad9dd259cfd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá quá trình sản xuất được thực hiện như quy định tại mục 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd3badadda57c87c9dd85412cfbd57088bc34c2501279af8e8ba287d36181a45d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết quả đánh giá giám sát sẽ được sử dụng làm căn cứ để quyết định việc duy trì, đình chỉ hay hủy bỏ kết luận về sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8c10c5b471105bf2753353a5fd9f8d16c7e59e8623cdb18bed9856a78123429d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng Phương thức 3:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb167a109fda3b77c51c20b0280a1fe68146016e24a1b28ce1d8bc9c20051e69f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 3 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b782e2e6b4ac2c433ec872d9054c15e2a8e115574ab14ddccd2e336eca928da59",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Sản phẩm, hàng hóa thuộc diện có nguy cơ gây mất an toàn, sức khỏe, môi trường cao hơn so với sản phẩm, hàng hóa được đánh giá theo phương thức 2;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0fc47d9750b4593b644aaab2b5f95b8dee4eb61c1fdc493174a61d49a195e016",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Thiết kế của sản phẩm, hàng hóa cho phép xác định rõ sản phẩm, hàng hóa theo từng kiểu, loại đặc trưng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3ea4f2b7b251ba238465b24c7fe96b38470d5ced75019e06c7e47e5d570e0d26",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Cần quan tâm tới việc duy trì ổn định các đặc tính chất lượng của sản phẩm, hàng hóa trong quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bdcdb55602ce356a2f3153458231ab9d934092fe8a49fb29d67cadc1e7fb6a1b7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Chất lượng của sản phẩm, hàng hóa về bản chất ít hoặc không bị biến đổi trong quá trình phân phối lưu thông trên thị trường;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b682317eb08bf0292bfc6b6f16f91671bfe6d98197fccdedf5ecf546fa515773d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Khó có biện pháp hữu hiệu để thu hồi sản phẩm, hàng hóa từ thị trường khi phát hiện sản phẩm, hàng hóa không phù hợp trong quá trình giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5d3ea5bdc5811cc7b876055058aa1ba980c3ac7024ee9c3af0e7bcef6a489740",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "IV. Phương thức 4: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất và trên thị trường kết hợp với đánh giá quá trình sản xuất",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcb0edee144dfe70bc15099617c786a4f21284548ea4dd1f6ef89f4add1d3b2a7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 4 căn cứ kết quả thử nghiệm điển hình và đánh giá quá trình sản xuất để kết luận về sự phù hợp. Việc đánh giá giám sát sau đó được thực hiện thông qua thử nghiệm mẫu sản phẩm, hàng hóa lấy từ nơi sản xuất và trên thị trường kết hợp với đánh giá quá trình sản xuất.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb1f5cc30561ceec27bb5a2cf0368f8fd74be6cedc0b164babcb8a7e9823756de",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động cơ bản trong Phương thức ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "4 ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "ba3c3b6e054060891937cbcd80db66356bf4e21928993bb3984950363205712b8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b513a31292cf07cf5aa221c9c1f4d4aac2c1b1ad6ab02ea45d312168ec641f1e1",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.1 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be891ba181978d8cdf4a89338524a20b22331ffcfbdcd30293b50b616869f806a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7af8c53b65cb2900993ca9b0fcf9b8267672b507e1c18401f3a936422be5e0df",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.2 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3d9caa4f716c027ed986d1a3502c9fcb424d6c02e89fa0e8d59871a32aa2ff2b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Đánh giá sự phù hợp của quá trình sản xuất:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b47012943048c0e14ab95d627b126f0852c8e6484c94a2837457477f122099eca",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b05dd9fedaa56de530c515cca5f74f13404f4000a1e560c931a9e623f3c2f63b9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b922e1c116903bde02a86270cb8adadef46c6a06c2d90b34f7ea4b8ce0a015203",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.4 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8e192d90829fbe1001299f3eedd403710c8ed3e49a2b7f2d3f40da33cc619aa3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.5. Kết luận về sự phù hợp",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1c2f062333fbbc8f33dc726529d139ea3553c9dba6a067fcbec68ca34672bdd2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.5 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9e47854a85d492338bf5d72e93da7c2b8b2f8ab7ac7f5320ad1bb650931a6cef",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.6. Giám sát:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9941dfc23653a484e0e2c4aaba5fe7ad5ca967d8e01194a5dc081b26fcee05e8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong thời gian hiệu lực của thông báo về sự phù hợp, sản phẩm, hàng hóa phải được đánh giá, giám sát thông qua việc thử nghiệm mẫu lấy tại nơi sản xuất và trên thị trường kết hợp với đánh giá quá trình sản xuất. Tần suất đánh giá giám sát phải đảm bảo không quá 12 tháng/1 lần.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bee4fbcd2b36ae0149f180fe6dddc9c31fa2a2adad2cfbe99e49d042581c22dae",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm mẫu sản phẩm, hàng hóa được thực hiện như quy định tại mục 1.1, 1.2 và 1.3 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7b84930eaa35192fae06c921db24a5ebf84c575325bec32596208de226173bcd",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá quá trình sản xuất được thực hiện như quy định tại mục 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0695acf2461c64a69bf62ce96144d3ce0f3e3742f199d85e981c05d33ce9ec37",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết quả đánh giá giám sát sẽ được sử dụng làm căn cứ để quyết định việc duy trì, đình chỉ hay hủy bỏ kết luận về sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bef3f50b9c6d595fb7dc482243f62f42ca6265e9944170b84893a427d540a7ff1",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng Phương thức 4:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b98314cc0ce76e06324498e450e991aaf261e2a688ee09e59d375aad6abd74cad",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 4 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện sau:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6393ce14ac9c7e2694060ff3c57e5af5efd94eb2c8bc9b6c31ef24355c322646",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Sản phẩm, hàng hóa thuộc diện có nguy cơ gây mất an toàn, sức khỏe, môi trường cao hơn so với sản phẩm, hàng hóa được đánh giá sự phù hợp theo phương thức 3;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9dc60ec7913c79f727bb660a932707d7ffccecb2e867329186183e45e5168905",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Thiết kế của sản phẩm, hàng hóa cho phép xác định rõ sản phẩm, hàng hóa theo từng kiểu, loại đặc trưng;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbdbd133708472a103d1ad555e7e5318eef79bcf281aa3d7ca838d7c8f1c23a2c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "c) Cần quan tâm tới việc duy trì ổn định các đặc tính chất lượng của sản phẩm, hàng hóa trong quá trình sản xuất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5f2345db30f7f1f8e409571e50f3cc34bd1b7b3f2ff3327759a93972756b60a4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "d) Chất lượng của sản phẩm, hàng hóa có khả năng mất ổn định trong quá trình sản xuất và bị biến đổi trong quá trình phân phối lưu thông trên thị trường;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc527f047e515f8083a761eca18f9923e6c08220de3caa933bef521be2ca77797",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "đ) Có biện pháp cho phép thu hồi sản phẩm, hàng hóa từ thị trường khi phát hiện sản phẩm, hàng hóa không phù hợp trong quá trình giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf87567d7b90104ec5568b8b2bd2078eb42f6522a78f19a7a72a7fbb35ee445e3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "V. Phương thức 5: Thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất; giám sát thông qua thử nghiệm mẫu lấy tại nơi sản xuất hoặc trên thị trường kết hợp với đánh giá quá trình sản xuất",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9c99c3fe2064a69fdf0b49d3711dd5e5ee04969f953e4baaec7864b098114c2e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 5 căn cứ kết quả thử nghiệm mẫu điển hình và đánh giá quá trình sản xuất để kết luận về sự phù hợp. Việc đánh giá giám sát được thực hiện thông qua việc thử nghiệm mẫu lấy tại nơi sản xuất hoặc mẫu lấy trên thị trường kết hợp đánh giá quá trình sản xuất.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5ea13ce67dde527bdfcad900d7e4bff9178af6f360da63b88a05ca8aec06e0f3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động cơ bản trong Phương thức 5 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2359b2e5ad225b6fee64bfa1e98534130482c3f046ceebb7dfae276627a04775",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bace18b7a9636cd4050f102c62b915069d3cf5279ebb5da7efb60db47c1944a4a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.1 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9bd25be9a2e4677db48fc842947e8fd0007147b1ce3fe35e57d836f1f023d07d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b57814e82bfa01f9472cd3df4f210e957eb936aac3159a215c0e6fddd2c275181",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.2 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b07e30dd87c5de05807598bf012a0240f7b3305393eeecd14035ec6955ef43e5b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Đánh giá sự phù hợp của quá trình sản xuất:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf5bf5f13c523ca34dc91abf00292ec11cc104a8fa985dead8f40c00cf53b7b18",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb39906b9ae5f8b2c697d2074750272245dd28ebaceb1cbaab8ce592fd0727481",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2c069282c64f924b9fd3d664b18e3f369e69f4730054cdf3c295aea351f57438",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.4 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4267081885a202baea4c3359b255bfb7c734d4b60e74234ed8dc5e8c70b2ca8d",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.5. Kết luận về sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7ab09ca5021c41549e4476b3c2ab6d696c5f04e1c85e6b39f0290876aafcbf07",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.5 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b83c5c52a6234d8a758b1304df616f01c44e6226d89e0dece1258166d994ae03b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.6. Giám sát:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd6ed07d85c1de445eb01bfec40021d1ebeddb9ab7d0f37a5ba14fd2ac8e6843f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Trong thời gian hiệu lực của kết luận về sự phù hợp, sản phẩm, hàng hóa phải được đánh giá, giám sát thông qua việc thử nghiệm mẫu lấy tại nơi sản xuất hoặc lấy trên thị trường kết hợp với đánh giá quá trình sản xuất. Tần suất đánh giá giám sát phải đảm bảo không quá 12 tháng/1 lần.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6b54badd44da14ea948e0f10b12c5e8b9385f47414493ba7b0d4723b32135a5b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc thử nghiệm mẫu sản phẩm, hàng hóa được thực hiện như quy định tại mục 1.1, 1.2 và 1.3 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bcd633e7a630e4ad5995278837f2a30d6d7e75c5adf978aae929fd85ae1aa40a8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Việc đánh giá quá trình sản xuất được thực hiện như quy định tại mục 1.3 của Phương thức 2.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b35d05f840a3861414609054e8f9d73b7b8e8360fc0ed7e1ab49b35651bc23782",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết quả đánh giá giám sát sẽ được sử dụng làm căn cứ để quyết định việc duy trì, đình chỉ hay hủy bỏ thông báo sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b2dec46cff3e9a44d71179ba614dd1979332d931150492e95726b7729a67f6ff0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng Phương thức 5:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b689cbad871f6778ff4337cffbf5b14eceaa0fd22692b6489462e53d5eac8f758",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 5 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc67407c99f8522cb7cab038e08d6a12092a325e8021edc5464be3b8eb7bc0c63",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Cần sử dụng một phương thức có độ tin cậy cao như phương thức 4, nhưng cho phép linh hoạt trong việc sử dụng các biện pháp giám sát để giảm được chi phí;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3c79046f11490da1a29e25c1ced95ca4fe85052de75e0689090e3d148757f8c4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Cần sử dụng một phương thức được áp dụng phổ biến nhằm hướng tới việc thừa nhận lẫn nhau các kết quả đánh giá sự phù hợp.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb8865784be9f12196f9fd333a5da49b1fc04ddd0cd806923d862a903f4fafc13",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "VI. Phương thức 6: Đánh giá và giám sát hệ thống quản lý",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf57408c4f80eb884e098df7916e9e1e04d5db28e00d5474928f32ce4cccce986",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 6 căn cứ vào việc đánh giá hệ thống quản lý để kết luận về sự phù hợp của hệ thống quản lý với quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9e5aa2fa302428a1bd1928a233617d6b02d3dd24910ec6db92c457b53f598434",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động chính trong Phương thức 6 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bfa45156c9b725e3668f285d9872e6bc800a171e25a841b2129ba8eca8bac2851",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Đánh giá sự phù hợp của hệ thống quản lý:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b103f346f276a8f9387888b3a4b089fec0acd5d5ce698f8cfe8adbf9329ed529b",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Hệ thống quản lý được đánh giá theo quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b47a44a13474c95e56f7f731555c43f224cb16ef92beb4bd0c78c156da5aa8e3e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Báo cáo kết quả đánh giá đối chiếu với các quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd105465318b84ecfa4eda35691a5f80d73ff01b17503918adfff2f8fbbde7617",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Kết luận về sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf1405273e75e654403f5673662a50571a68b4cf827c0da81d382ff108ab6cb3f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Căn cứ báo cáo kết quả đánh giá, kết luận về sự phù hợp của hệ thống quản lý với các quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b230ff748d9a96cfa4b1d30317e40424f199d90ed0c5130f368a0a72d7fa03191",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Kết luận về sự phù hợp của hệ thống quản lý có giá trị hiệu lực tối đa 3 năm với điều kiện hệ thống quản lý được đánh giá giám sát.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bffc209aaa12f1233f1d8b09ca42975757d683cd5713e6899a9a2842ebb2468c3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Giám sát hệ thống quản lý.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8d877d3fbab39daf0f887aec6087115830ff039ed696f63317ed2f265a5a8e88",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Giám sát thông qua việc đánh giá hệ thống quản lý với tần suất đánh giá giám sát phải đảm bảo không quá 12 tháng/1 lần.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4119474750162330a6deada0b1cc788566ef720d84897dcd8161ccbb52e4f0a6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "- Kết quả giám sát là căn cứ để quyết định tiếp tục duy trì, đình chỉ, hủy bỏ sự phù hợp của hệ thống quản lý.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8b5024d05834160a5c7e810e16ca6bb52e0ef39dd56cdf615c956ff475218226",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng Phương thức 6:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bd900f32a59f454b97bfd8d22350ccace86990d8b56c5aa37c7537cbb504f2117",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 6 được sử dụng để đánh giá sự phù hợp của các quá trình, dịch vụ, môi trường có hệ thống quản lý theo các quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b1e81d6e82c31f39f88a3a9567c5ad110aa19aa18c0d1cf0020ba6e4bc58b9a4e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "VII. Phương thức 7: Thử nghiệm, đánh giá lô sản phẩm, hàng hóa",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b31bc11f40832fd5c2f48928e65aae410c96e7e020820b9984aafd3ab28cd9150",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 7 căn cứ kết quả thử nghiệm mẫu sản phẩm, hàng hóa được lấy theo phương pháp xác suất thống kê cho lô sản phẩm, hàng hóa để ra kết luận về sự phù hợp của lô. Kết luận về sự phù hợp chỉ có giá trị cho lô sản phẩm, hàng hóa cụ thể và không cần thực hiện các biện pháp giám sát tiếp theo.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be013d522cac95d341cc977dae06d03f0a40e490dd905690b38a82da4ac2458da",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động chính trong Phương thức 7 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be4d674003c5ab95696a7bee8f2d735b3e3ae0316eef9ab198a38f934a952e1e0",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Lấy mẫu:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7e2cfabd2c5cdfa89738a1d94351756e25a133c42ef55bf842da22219e94c0e8",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Mẫu thử nghiệm là mẫu được lấy theo phương pháp xác suất thống kê, đảm bảo tính đại diện cho toàn bộ lô hàng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b3994c0ddd7ee023f893aab25755a2bc22b7e89754c3c10cf35577fb313fcaed4",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Số lượng mẫu phải đủ cho việc thử nghiệm và lưu mẫu.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b657ce8ea85caed9364bc05e7b5e3d4b3e92d70257154cc9f0626a1f33cfb4a7a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của mẫu thử nghiệm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b493c49e9380c17810b410f2d6b1938d20ca40d5cbbef2adfe71745ac1d615921",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Tiến hành như quy định tại mục 1.2 của Phương thức 1.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6bb44d344892fdc576efadf72caa49ed7f2d38135457d7e9e8e1c477ca9ec41f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b5daccca806ebf0c3fa1f957968278ba874aeeb841815d733c632c337e752c40e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Xem xét các đặc tính của sản phẩm, hàng hóa qua kết quả thử nghiệm mẫu với quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7e13f783f6a7e48e7abed30ff25ce0790c14c7f019836e21c511f36cf475d408",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Kết luận về sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b43b3ba16b0e80f5abb25f2e8571a48b2742ad44b7467a4b7f222cd132adeae63",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Lô sản phẩm, hàng hóa được xem là phù hợp với quy định nếu số lượng mẫu thử nghiệm có kết quả không phù hợp nằm trong giới hạn cho phép.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4bea032f241afbcde70f8292509bddbbbd48629bbbf6ee3aec336c0e7aceb0ad",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Lô sản phẩm, hàng hóa được xem là không phù hợp với quy định nếu số lượng mẫu thử nghiệm có kết quả không phù hợp vượt quá giới hạn cho phép.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bfcbdaa9b28d604edefe7f938e1df58b64c1c4ac07d0006708036c3fbb6043512",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng Phương thức 7:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb2aaea1cb260edc82b5a1e7a2ac5b31be87be1a25c98a107e1e4f50cac76ecaf",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 7 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa với các điều kiện:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b151f4d881823ec1ad4352ed0a3b876b7aaeabe75cd6f0a69aa741c9f6bcdfe0e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Sản phẩm, hàng hóa đuợc phân định theo lô đồng nhất;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b17ed31d5c7d66e9b978d933715ab6704013b6a6218ea7367bc3100e89443cfc3",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Không tiến hành xem xét được các yêu cầu đảm bảo duy trì ổn định chất lượng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "be2b27753ec946d2770a892aa568c94014018864a7b69272d65960b7101b0ef16",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "VIII. Phương thức 8: Thử nghiệm hoặc kiểm định toàn bộ sản phẩm, hàng hóa",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bf42c1cbf49e5c27fba696c698ba1c09ad8a6b74365ea22a16bf3b92ba38ab811",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 8 căn cứ kết quả thử nghiệm hoặc kiểm định toàn bộ sản phẩm, hàng hóa để kết luận về sự phù hợp trước khi đưa ra lưu thông, sử dụng. Kết luận về sự phù hợp chỉ có giá trị cho từng sản phẩm, hàng hóa đơn chiếc và không cần thực hiện các biện pháp giám sát tiếp theo.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4804ed8deff5c8b7ad9349b983dce71a0b112528cda2441d4d3ecf55fe7430b5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1. Nội dung và trình tự thực hiện các hoạt động chính trong Phương thức 8 bao gồm:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bb676ced3fec9202b78704be94e62e040935fbbd4e4dec5bcf7b44745258306c5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.1. Xác định sản phẩm, hàng hóa cần được thử nghiệm hoặc kiểm định;",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b9f054244bbda800cd8d3626526cae84b16eb941b2c202a1cc142bffcd24e84ec",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.2. Đánh giá sự phù hợp của sản phẩm, hàng hóa:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b781ca6256f39cbf3f4d90c5ce42b4b706158d2fe52d1d53f368547aafdb38375",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Việc thử nghiệm hoặc kiểm định sản phẩm, hàng hóa do phòng thử nghiệm, phòng kiểm định đã đăng ký lĩnh vực hoạt động có năng lực tiến hành ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "tại nơi sản xuất, nơi lắp đặt, nơi sử dụng hoặc tại phòng thử nghiệm, phòng kiểm định.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b066d659e97a9850ba51c0a6df68b9b04b09e3e6e6f67fe19d2b864955ecc25a5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Ưu tiên sử dụng phòng thử nghiệm, phòng kiểm định được công nhận.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b7fe3b3bebf53fac9cc022936bb3e42650225bb3b9ff236e0bcb23d50c79bc432",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "b) Các đặc tính của sản phẩm, hàng hóa cần thử nghiệm, kiểm định và phương pháp thử nghiệm, kiểm định được quy định trong tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b75f413b89cd33932e9736601f5b9e07dda7a888ba038d52a76dd1e1b4d3600c5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.3. Xử lý kết quả đánh giá sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b8d790f42a36d1651c7603e86f7a13d3a911dc7931847df65f286fdfb047da895",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Xem xét các đặc tính của sản phẩm, hàng hóa qua kết quả thử nghiệm hoặc kết quả kiểm định so với yêu cầu.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b32e47e8263403a527481ad764e85a9079eab527ad7112926a496066149287151",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "1.4. Kết luận về sự phù hợp:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b28d5510605c7e64a6debb3938a7a7ca8a7b551c7656f20335be3fea11f72a440",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Sản phẩm, hàng hóa được xem là phù hợp nếu tất cả các chỉ tiêu của sản phẩm, hàng hóa được thử nghiệm hoặc kiểm định phù hợp với mức quy định của tiêu chuẩn, quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b59fe8f151f50d66790570a9e7b6ab0d09163aa3042661c0691ec4370e3b24f5e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "2. Nguyên tắc sử dụng của Phương thức 8:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b60b8b18f344b97058111c7dc5312883d5ffae82d0e4df37bc4b5806538775287",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Phương thức 8 được sử dụng để đánh giá sự phù hợp của sản phẩm, hàng hóa có yêu cầu nghiêm ngặt về an toàn trước khi đưa vào lưu thông, sử dụng./.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b907a5c95cb45cfeec832d648928247601fea51526ecc503812434aa69e092e13",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {

      "id": "bccb8f4cd8906627e3fe977745548a33f0ca3ba6af141538f865b6d1cef11fce5",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "địa chỉ tổ chức, cá nhân:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": " ………………………………………………………….",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bca78e90b49b77e2a2e778e6da5dfc47bd818595648c5253e1f5b1e90585a61f6",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "cho sản phẩm, hàng hóa, quá trình, dịch vụ, môi trường ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "(tên gọi, kiểu, loại, nhãn hiệu, đặc trưng kỹ thuật...)",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": ": ",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "text": "………………………………………",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b573a355061ebaa3f57c9088e6a056fb22dc308bafcc6de5b1b494214e573ef48",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "phù hợp tiêu chuẩn (",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "số hiệu, ký hiệu, tên gọi tiêu chuẩn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": ")/quy chuẩn kỹ thuật (",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "số hiệu, ký hiệu, tên gọi quy chuẩn kỹ thuật",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": ") và có giá trị đến ngày ….. tháng …… năm ……. (hoặc ghi: có giá trị 3 năm kể từ ngày …… tháng ……. năm ….).",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b05f4013872953d2124ffb33d119b662a0eae00ab111d33e29dcb24279e945f91",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "Thông báo này ghi nhận sự cam kết của tổ chức, cá nhân. Thông báo này không có giá trị chứng nhận cho sản phẩm, hàng hóa, quá trình, dịch vụ, môi trường phù hợp với tiêu chuẩn/quy chuẩn kỹ thuật tương ứng.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b4562a4fdcbec338f9967ec2759ea1b7b67621eecdf8b282cfff1ce05c788e21e",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "(",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            },
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Tên tổ chức, cá nhân",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "italic": true,
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "type": "emph"
            },
            {
              "content": [
                {
                  "text": ") …… phải hoàn toàn chịu trách nhiệm về tính phù hợp của sản phẩm, hàng hóa, quá trình, dịch vụ, môi trường do mình sản xuất, kinh doanh, bảo quản, vận chuyển, sử dụng, khai thác.",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "font": {
          "family": "Times New Roman"
        },
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b0480778cce3803eac8503f5d8986830f8335d6418d7f36e035495e504a1eb08e",
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "default"

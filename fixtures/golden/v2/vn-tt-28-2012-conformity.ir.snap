    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "HÌNH DẠNG, KÍCH THƯỚC CỦA DẤU HỢP QUY",
                  "type": "text"
                },
                {
                  "type": "line_break"
                }
              ],
              "type": "strong"
            },
            {
              "content": [
                {
                  "text": "(Ban hành kèm theo Thông tư số 28/2012/TT-BKHCN",
                  "type": "text"
                }
              ],
              "type": "emph"
            }
          ],
          "direct": {

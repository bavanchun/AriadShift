          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "Đại diện có thẩm quyền của",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          },
                          {
                            "content": [
                              {
                                "text": "Cơ quan tiếp nhận công bố",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          }
                        ],
                        "type": "strong"
                      },
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "(ký tên, chức vụ, đóng dấu)",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "italic": true,
                              "size_pt": 14.0
                            },
                            "type": "styled"

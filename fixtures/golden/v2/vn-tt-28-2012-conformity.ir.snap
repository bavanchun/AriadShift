                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "KT. BỘ TRƯỞNG",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,

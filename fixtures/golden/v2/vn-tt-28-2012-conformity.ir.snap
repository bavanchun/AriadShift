      "id": "ba3e6787656b27eea241b4f34af8dec6c43bed1a1a2dc3c6b33271846f7b1abbe",
      "type": "paragraph"
    },
    {
      "id": "b9694a98f851f8a23483cb9c8bc60f700f547c0b7f220c9e97973ee241d45f48b",
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "content": [
                            {
                              "text": "Dấu hợp quy có hình dạng được mô tả tại Hình 1.",
                              "type": "text"
                            }
                          ],
                          "direct": {
                            "font": {

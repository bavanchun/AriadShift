        "space_before_pt": 6.0
      },
      "id": "bb9853b246129460956ecd85f8fb2aeea1ad588951d19f15e05a49f29a9b8d896",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "CÁC PHƯƠNG THỨC ĐÁNH GIÁ SỰ PHÙ HỢP",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {

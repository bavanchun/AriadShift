                                "type": "line_break"
                              }
                            ],
                            "type": "strong"
                          }
                        ],
                        "type": "emph"
                      },
                      {
                        "content": [
                          {
                            "text": "- Tổ chức, cá nhân;",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          }
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Cơ quan chủ quản (để báo cáo);",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          }
                        },
                        "type": "styled"
                      },
                      {
                        "type": "line_break"
                      },
                      {
                        "content": [
                          {
                            "text": "- Lưu: Cơ quan tiếp nhận hồ sơ.",
                            "type": "text"
                          }
                        ],
                        "direct": {
                          "font": {
                            "family": "Times New Roman"
                          }
                        },
                        "type": "styled"
                      }
                    ],
                    "direct": {
                      "font": {
                        "family": "Times New Roman"
                      }
                    },
                    "type": "styled"
                  }
                ],
                "direct": {
                  "font": {
                    "family": "Times New Roman"
                  },
                  "space_before_pt": 6.0
                },
                "id": "bd26192e325c8da4f0c2b273eb7b0e76ae6a05a52498856b582b419df83380d26",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "Đại diện có thẩm quyền của",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          },
                          {
                            "content": [
                              {
                                "text": "Cơ quan tiếp nhận công bố",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          }
                        ],
                        "type": "strong"
                      },
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "(ký tên, chức vụ, đóng dấu)",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "italic": true,
                              "size_pt": 14.0
                            },
                            "type": "styled"
                          }

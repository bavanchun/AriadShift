    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "BÁO CÁO",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b6717a3938d28367231f00f1e013e914dd2f3991197a6bf21638624f330040f16",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "ĐÁNH GIÁ HỢP CHUẨN/HỢP QUY",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "font": {
                      "family": "Times New Roman"
                    },
                    "size_pt": 14.0,
                    "weight": 700
                  },
                  "type": "styled"
                }
              ],
              "type": "strong"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0,
            "weight": 700
          },
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b94af9569546517e1b2f17b3b6563eaebd3d5ee23ab53c54545c39ff7d8b9303c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "1. Ngày đánh giá:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bbf64ee340b7c77b9ce7ab8a5e438f996d23b11d7cca4dbd01dc3a1ec4ec2925f",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "2. Địa điểm đánh giá:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "bc4b9720fd10bbbdc77eccde165989543e32bfea41418d1e9529c17d17898e707",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "3. Tên sản phẩm:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b97ed6f96b5bdbaff2fa8b7ac45c8341692d893e38d057eef386482cf32438b6c",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "4. Số hiệu tiêu chuẩn /quy chuẩn kỹ thuật áp dụng:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b24ffb368e11b10b36658931286a785acf2652a27aa03f8c22d67090ba3857e6a",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "5. Tên tổ chức thử nghiệm sản phẩm:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b62b5c9b57ff51d500f04c87e90edb1d43257940501e38c83faf11004a869b674",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "6. Đánh giá về kết quả thử nghiệm theo tiêu chuẩn /quy chuẩn kỹ thuật áp dụng và hiệu lực việc áp dụng, thực hiện quy trình sản xuất:",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b820fd29217a52aeab2efbb36b289a203a78b3c95dc6dc3209800d112537ac0e9",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "text": "7. Các nội dung khác (nếu có):",
              "type": "text"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b009d6e69e16710a5f781f5575f8202f9354c5f6001a3e7eefa1752117c3c4641",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "8. Kết luận:",
                  "type": "text"
                }
              ],
              "direct": {
                "font": {
                  "family": "Times New Roman"
                },
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "direct": {
            "font": {
              "family": "Times New Roman"
            },
            "size_pt": 14.0
          },
          "type": "styled"
        }
      ],
      "direct": {
        "font": {
          "family": "Times New Roman"
        },
        "size_pt": 14.0,
        "space_before_pt": 6.0
      },
      "id": "b49f8fc9ee4ed67013549d48f1cf8de60968d56e07ae0f792e9b19706b91d49c2",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": " Sản phẩm phù hợp tiêu chuẩn/quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "id": "b31eb27a88ae027a79d31615d821b47b410048e697997ae69f314dd4b2c9b6107",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": " Sản phẩm không phù hợp tiêu chuẩn/quy chuẩn kỹ thuật.",
          "type": "text"
        }
      ],
      "id": "b4e014ebd4e98acc3fa006240b1731d3253f1e2c6aee5269605da885b86803522",
      "type": "paragraph"
    },
    {
      "body": [],
      "caption": null,
      "columns": [
        {
          "align": "center"
        },
        {
          "align": "default"
        }
      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "Người đánh giá",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          }
                        ],
                        "type": "strong"
                      },
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "(ký và ghi rõ họ tên)",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "italic": true,
                              "size_pt": 14.0
                            },
                            "type": "styled"
                          }
                        ],
                        "type": "emph"
                      }
                    ],
                    "direct": {
                      "font": {
                        "family": "Times New Roman"
                      },
                      "size_pt": 14.0
                    },
                    "type": "styled"
                  }
                ],
                "direct": {
                  "align": "center",
                  "font": {
                    "family": "Times New Roman"
                  },
                  "size_pt": 14.0,
                  "space_before_pt": 6.0
                },
                "id": "bc6dd8e4c63986b617f971d6c541bcee8d7ab31c4797c7c25c9a7faf8a8f4c9da",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "header": true,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "content": [
                              {
                                "text": "Xác nhận của lãnh đạo tổ chức, cá nhân",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"

                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          },
                          {
                            "content": [
                              {
                                "text": "THỨ TRƯỞNG",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },
                            "type": "styled"
                          },
                          {
                            "type": "line_break"
                          },
                          {
                            "type": "line_break"
                          },
                          {
                            "content": [
                              {
                                "text": "(Đã ký)",
                                "type": "text"
                              }
                            ],
                            "direct": {
                              "font": {
                                "family": "Times New Roman"
                              },
                              "size_pt": 14.0,
                              "weight": 700
                            },

              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Bóng mát",
                        "type": "text"
                      }
                    ],
                    "direct": {
                      "weight": 400
                    },
                    "type": "styled"
                  }
                ],
                "id": "be10950478710c395747089830d14415fc57e3d7067bdc4c03238a3ef7256b844",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Vườn đọc",
                        "type": "text"
                      }
                    ],

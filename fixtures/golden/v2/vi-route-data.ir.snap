            "blocks": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "Có ghế dài",
                        "type": "text"
                      }
                    ],
                    "direct": {
                      "weight": 400
                    },
                    "type": "styled"
                  }
                ],
                "id": "b8ada13c0008fc6118adf000431f6cb33d7f9c20870ed182116f6906a371d1457",

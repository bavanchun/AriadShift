                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " nhân viên đáp ứng yêu cầu đào tạo của chương trình",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],

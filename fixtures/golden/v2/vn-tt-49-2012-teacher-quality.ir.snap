      },
      "id": "b8ceaca1dc16e30b125fa6623d38f9a48f322bd472a43a2b65c41f57156827888",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 7.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Tiêu chuẩn 4: Người học và công tác hỗ trợ người học",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b7fbfbb67908ab4b64faa847aba3b0250b4383eb90ecfff70de56f23390a0bbad",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "1. Người học được tuyển chọn công bằng và khách quan",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b865a735fe16d410756176e0947fa8e3d2b53da6806431ee821968ea88de0d8ad",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Quy trình, hoạt động tuyển chọn người học đảm bảo công bằng và khách quan.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b83ff6613a19c6ca022d15486163c2c6d0ec5df5537d686263030e33020db0564",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Công khai, minh bạch quy trình tuyển chọn người học của nhà trường.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b21e31d4942309d370cea54c4d7abf3ea786c735a60adaab03c185410299187e0",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Việc xử lý các đơn ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thư",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " khiếu nại, đơn đề nghị phúc khảo trong công tác tuyển sinh của nhà trường liên quan đến chương trình được thực hiện theo quy định.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b465b8b20ec6627299daef9c1d736b28d76d5ce6fae3fcc2cba328f451d4124e2",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "2. Người học được phổ biến đầy đủ các quy định cần thiết",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bc04636c3d8ccfde5d81f801213536c629c74548db0f705e08f67cd0542a3e5a3",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Tổ chức phổ biến, giới thiệu, quán triệt các quy định về tổ chức đào tạo, kiểm tra, thi và công nhận tốt nghiệp của Bộ Giáo dục và Đào tạo và của nhà trường cho người học, cung cấp cho người học tài liệu về cẩm nang đào tạo ngay từ khi mới nhập học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb3617731a983a57156ffc515048a698061bc9fd686d08674d555115d795ab217",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Định kỳ có các hoạt động phổ biến, giới thiệu, quán triệt các quy định về tổ chức đào tạo, kiểm tra, thi và công nhận tốt nghiệp của Bộ Giáo dục và Đào tạo và nhà trường cho người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b1c20550967c0ff7d59c980493c224f966a38af70fd41a2540895230616946727",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Định kỳ rà soát, cập nhật các tài liệu phổ biến về tổ chức đào tạo, kiểm tra, thi và công nhận tốt nghiệp.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be2a5fafe4e1116b9042da778afc0e35b0f2cdc515c2f4ad39309e23ed789f079",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "3. Người học được tạo điều kiện học tập và tham gia nghiên cứu khoa học",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be5e8cc08c5afe2decb360dcc53b9f31b10cbf7bfe7f1db2bb8b1f7d7911e192d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có những chính sách và biện pháp tạo điều kiện cho người học trong học tập.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b2390adf8a97b4ba433ee9a91fde1c13b7fb0a9fd5d27d3a414848b6b76b4100b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có những chính sách và biện pháp tạo điều kiện cho người học trong nghiên cứu khoa học, tỷ lệ người học tham gia nghiên cứu khoa học tăng hàng năm.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b7b3b4226677ed7a8f237e7a136184adbe85c468db2147a2e32e250123edabb86",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có kinh phí sử dụng để hỗ trợ cho người học trong học tập và nghiên cứu khoa học hàng năm.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b202b7a5867d6dbd973c199fd16b47a2a3d9d40dc192bb313dca9cefcfeebfab8",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "4. Người học được tạo điều kiện rèn luyện tư tưởng chính trị, đạo đức, lối sống và tham gia tổ chức Đảng, Đoàn thanh niên cộng sản Hồ Chí Minh và các đoàn thể khác ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định của pháp luật",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bf116643d6335fdf1af3a884716de57ca385efa3aaf10e65b1add01f9b98fed64",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Quan tâm đến việc rèn luyện chính trị, đạo đức của người học, tạo điều kiện cho người học được tham gia tổ chức Đảng.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b53dd27edecb73555bd327929b693f152086b9f1c8b2745d6dd62cabd1cbb2a48",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Tạo điều kiện cho người học tham gia công tác Đoàn, Hội và các hoạt động xã hội khác ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định của pháp luật.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b479e1f612d9e31c9c9fa662085b4350253b12ed8010fa8447ff3681fb8785ac9",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Người học được tạo điều kiện rèn luyện lối sống lành mạnh và các kỹ năng sống.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb01f59514b200396a38e7019d954cf0b87be0538b1f815fd11e674a7100dceec",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "5. Người học được đảm bảo các chế độ và được cung cấp các dịch vụ hỗ trợ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be1de46866cc56aafa909e4e7372bff95a35b7a69870248da9182c3c58ee73ec5",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Người học được cung cấp thông tin và đảm bảo chế độ chính sách xã hội ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b12c7ac5190715261c57883426b6aeafb4c69378483ead62d91169fdb51ea4a66",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Người học được cung cấp các dịch vụ hỗ trợ ăn, ở và giải trí.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b6e5bb405000be48f858a4abc29a854cd1d764fef3e0dd7fa439feb1f35f795e2",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Người học được tạo điều kiện bồi dưỡng sức khỏe, phát triển thể chất và được đảm bảo về dịch vụ y tế học đường.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bd6452b5dc5ef934993793b35516db249fc3cd8b2d57603a632f7e178db91e472",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "6. Người học thực hiện tốt nhiệm vụ học tập và rèn luyện",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b36768d90df1cde3ba8de401cf1f869bf3fdd224e571ff60feec615ab7d3c3f1d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Người học tự giác, tích cực thực hiện nhiệm vụ học tập và đạt kết quả tốt.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b24a3885a6ef14c0792cb382b020cf9b80dad4dca8f3c4e6a45c46be6e9e2c3e8",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Người học chủ động, tích cực rèn luyện tư tưởng chính trị và đạt kết quả tốt.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b72da6a8df9941f5aeb784163af92245f3360908b5f5e94c4342988e0ab817a94",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Người học chủ động, tích cực rèn luyện đạo đức, lối sống và đạt kết quả tốt.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b63c20ff2c5eb3737dad4d87227d1b0c41a65649510303276a6cb2c203045fe34",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 8.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Tiêu chuẩn 5: Cơ sở vật chất phục vụ chương trình",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bc30cd88b56a529b562f0a2cac3c8ed55df36526605612c1751e8d57d53fd0c99",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "1. Hệ thống ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thư",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " viện của khoa, trường đáp ứng yêu cầu",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b8423237699fd1f2f0be80bfae9b2b3efaa1d85f0ff8ebb082c197422b6140e6c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thư",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " viện điện tử, đáp ứng yêu cầu truy cập thông tin của cán bộ, giảng viên, người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b35bbcf1134611c52e308892d8e2429586e347dbfd2b44cc2f6a0dc892b474eb6",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có đủ đầu giáo trình, sách tham khảo chính, tạp chí, tài liệu chuyên ngành và nghiệp vụ sư phạm đáp ứng yêu cầu của chương trình và được bổ sung, cập nhật thường xuyên.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be4c0eaab98d32910c25f045416834d8225b40bb358082e7785d02c379976f4bb",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Công tác ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thư",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " viện phục vụ có hiệu quả các hoạt động đào tạo của chương trình.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be7c8ec0b2be5b5b92370ecb2548f1b7aeffa31721a5b63a8d6ac340aa740e31b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "2. Hệ thống thiết bị giáo dục đáp ứng yêu cầu",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b5062e5b7621b1db2f757b5e1c6a71ac9dd3b3e42f6a1840a4bf3862eed16158a",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có đủ các thiết bị giáo dục đáp ứng yêu cầu giảng dạy, học tập, thực hành, thí nghiệm.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b770f31944c916d358eb970ef7cc18b5f5fcf208986d5717c920273be885930bf",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có đủ các thiết bị giáo dục đáp ứng yêu cầu nghiên cứu khoa học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be141ca7840ebb641ebc703513d2e2527846c7b1116d6b11dba981c2b4582d93d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có đủ các thiết bị giáo dục đáp ứng yêu cầu về quản lý điều hành.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b02f6d7025787334323aa2c6320269ddb9c4da58d2a172659a9c277edc5ba8484",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "3. Hệ thống phòng chức năng, phòng học, phòng thí nghiệm, phòng thực hành đáp ứng yêu cầu",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bcee01b0f3fafbbbc4228d0795738e2362d28834e39d01dc91ec27e33dc00c484",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có đủ số lượng phòng chức năng, phòng học, phòng thí nghiệm, phòng thực hành.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b7ee4ffe7721df44e612cf73aedee3f5f5badc4b3585c99c4e935036bcc7b6dba",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Các phòng chức năng, phòng học, phòng thí nghiệm, phòng thực hành đảm bảo đủ diện tích và đúng quy cách.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bd86027b394b451b1140d4870cefc6931cd72162c6a0032f9b4810541e2dd1483",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Các phòng chức năng, phòng học, phòng thí nghiệm, phòng thực hành được sử dụng có hiệu quả.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b92db0045df5ccc4c3082327d3d3898e6c4d670b779d00bf383a880dade19708c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "4. Cơ sở vật chất phục vụ giáo dục thể chất đáp ứng yêu cầu",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bed364f00d339a5786d444765f233fa341b205e695a4d5d97210e68211ac59a7d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có đủ điều kiện về cơ sở vật chất đáp ứng yêu cầu giáo dục thể chất.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bff0a19e45d42ac43b8611358fdd4291136c1de1d0b603baceceb71f1f971ab0e",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có đủ điều kiện về cơ sở vật chất để tổ chức các hoạt động thể dục thể thao để nâng cao sức khỏe và phát triển thể chất cho người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b75225c1ab2751a8574c0b9dadc41c46d9f5fee18bd89d3ed331044ce9fa678e8",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có biện pháp cải tiến sử dụng hiệu quả các điều kiện cơ sở vật chất.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "ba2008c47d33116ff492ac204489d67ff4a4469b1282fccd92cd30045d89140a1",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "5. Có các biện pháp cải tiến nâng cao chất lượng cơ sở vật chất phục vụ chương trình",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bfed3b2ad83a0c8baadbe356b02c2be1a5d08078f1a68ce19bc01cfc3347cd7c1",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Định kỳ đánh giá chất lượng và hiệu quả sử dụng các phòng học, phòng chức năng và có các biện pháp cải tiến nâng cao hiệu quả sử dụng.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bee781c365dba1df4812fe93553ce4e69f9fefe078fc96b0a63866515a5da1015",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Định kỳ đánh giá chất lượng và hiệu quả sử dụng các phòng thí nghiệm, phòng thực hành và có các biện pháp cải tiến nâng cao hiệu quả sử dụng.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "ba94df7900437dbef0f5f3b7a192506ce804631c26395b1696cf8811860ee0336",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Định kỳ đánh giá chất lượng và hiệu quả sử dụng các cơ sở vật chất khác và có các biện pháp cải tiến nâng cao hiệu quả sử dụng.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bad3152b078baf8646663e44d40be2b48df359c435f42c0861541837b0faa097b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "6. Đảm bảo môi trường sư phạm phục vụ chương trình đào tạo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb9981dee079eed4c6f629608acdee94f268df06887412178ffad40c0228f2306",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có biện pháp đảm bảo môi trường sư phạm xanh, sạch, đẹp.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b2e4909c3503acccd9463c1405f5c3f34f09b2b8398635f4c129f2d1a398d6c8c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có biện pháp đảm bảo môi trường không bạo lực, không có tệ nạn xã hội.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bacc63f8239feb4d08de7bf3564486e18bcb53696aac92f05009ed199021f4495",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có biện pháp đảm bảo ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "an",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " toàn cho người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b758c0689b7e303ea0c87845903c4eecab5b23d3f700e322e0adf92ce76f13ad5",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 9.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Tiêu chuẩn 6: Công tác tài chính phục vụ chương trình đào tạo",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b2f1bc04014ba0f6756b0a11f39b110c281f270905b23e3fb443c920f7993a5a1",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "1. Có kế hoạch tài chính và quản lý tài chính đảm bảo cho hoạt động đào tạo giáo viên trung học phổ thông",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b207e2591f3087d71fa076313f22aa78c4e297cf0198e232fd31a3c2beb6e07c7",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có dự trù kinh phí hàng năm cho chương trình đào tạo một cách rõ ràng, chi tiết.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b4398ca437e4e7e1fc856905e92d254410f2d5d26f149f56ace1ea7bbf28a3036",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có sự tham gia của các đơn vị thực hiện chương trình trong việc xây dựng kế hoạch và phân bổ tài chính cho các hoạt động của chương trình.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be341c4ec3574b276973be8452f6ac36160cd0f3b2dbf8c8b234818cb206d8c88",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Đảm bảo kinh phí được phân bổ đúng quy định, phục vụ hiệu quả các hoạt động của chương trình, đáp ứng yêu cầu rèn luyện nghiệp vụ sư phạm và kiến tập, thực tập sư phạm của người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b7fc6c65a9652c45b33669350516e001f0c8e2556fca80e8b491e3e5e8d31c03b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "2. Thực hiện chế độ kiểm tra, giám sát, đánh giá và báo cáo về tài chính ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b1ebc89aa5dccbe5ace815abfc5558ddfe1fa550c84e9db5f25cad14b8c7e9123",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có hệ thống văn bản, biểu mẫu quản lý các hoạt động tài chính.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b0eb245fe593d16d435c6f7369daa627c85cb21abf0c569fd9877002765981677",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Hàng năm, có báo cáo quyết toán và đánh giá hiệu quả sử dụng các nguồn tài chính phục vụ hoạt động của chương trình một cách rõ ràng và minh bạch.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b5a94559a625e267fc4d5041039d0be4aa03ad7724916efd76057f698624cd04f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Kết quả kiểm toán hàng năm cho thấy không có những ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "vi",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " phạm về tài chính.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b8e534e20331e9279919901cdabe53a12a061d323be62d5b05513b55c4440dd8d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "3. Có các nguồn tài chính hợp pháp phục vụ chương trình.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b9ec4d717c108dd01de5ca48bf612a62d2fdbda99b4ce3a8eaf51b5e98c22d69f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có nguồn tài chính hợp pháp hỗ trợ các hoạt động đào tạo của chương trình.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b36ce17869479ea1dde50118f5c7bf98f6826c903c014e3124d000d8b854eda38",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có nguồn tài chính hợp pháp hỗ trợ công tác nghiên cứu khoa học của chương trình.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b2dd4055b197bf5b5eea9acf5bcd1771b148cde1aa60b08534427bf2403fccc9d",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có chiến lược để tăng kinh phí của các nguồn ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thu",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " hợp pháp để đáp ứng các hoạt động đào tạo và nghiên cứu khoa học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b15008d428ea2ed8f1daed5ac5cd2b55d564c19b2a8e0e70471893c7ffdee7077",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "4. Thực hiện công khai tài chính và có cơ chế để cán bộ, giảng viên tham gia kiểm tra và giám sát tài chính",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b5d2b33029404abb5ba6d41980bee414ac871ecc2357fef88d0cf5feec76a281f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có quy chế chi tiêu nội bộ minh bạch và hợp lý được xây dựng trên cơ sở lấy ý kiến rộng rãi của mọi thành viên trong khoa, trường.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b678be76511ca5e9a82d99caa11b8d98e0e5d2668585ea53aafc82d83ae5c1e2f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có cơ chế để cán bộ, giảng viên tham gia kiểm tra và giám sát tài chính.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b384fe13f1a8d581bc7c47233a67135650f3053caa3835d3f5deb73682afabd54",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Công khai tài chính hàng năm cho cán bộ, giảng viên tham gia đóng góp ý kiến.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "ba734dd9cf5f23d1c1c95d50fbea96fff38d98bbdfc77b08d69090ceb8f032a3c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 10.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Tiêu chuẩn 7: Công tác đánh giá sinh viên tốt nghiệp và hoạt động tư vấn việc làm",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bbc800dbd210c78881926ffbe9d52e2a3c419c2e0b4c2a38ac61f9a7b97e746c2",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "1. Thực hiện tốt việc đánh giá sinh viên tốt nghiệp",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "ba2bd1b6b444b5b6e381561faabceef6038f1a0556bf90814adbc3d4da8dfd9e7",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Xây dựng các bộ tiêu chuẩn đánh giá sinh viên tốt nghiệp về phẩm chất, tư tưởng chính trị, đạo đức nghề nghiệp và năng lực.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b4a85b6bcaba63c6c9fccec031a6a92b291585713978e1b730ac9a7e3ceef437f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Sử dụng bộ tiêu chuẩn đánh giá sinh viên tốt nghiệp ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " đúng quy trình và phương pháp khoa học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "ba099bfe155a5a9a84055a2bed5d2644480012bd27a3bfd9627b10e8f0a80ed7c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Việc đánh giá đảm bảo công bằng, khách quan cho kết quả chính xác.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be8188cebfb0fe5a8733923d0fec4c324bd78fb14dc6ab97eb700184b5b03e9e6",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "2. Thực hiện đánh giá tình hình việc làm của sinh viên tốt nghiệp",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be45427ab30ccdfba7b17ee8675583f31a1d1d21559e67634cd5d4f90be2e508a",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Có bộ phận chuyên trách về công tác cựu sinh viên.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b3a483adefc0a6ec88d2d8a9122512a98456f044d27ae01e0153927863cb0e31b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Xây dựng cơ sở dữ liệu về cựu sinh viên và thường xuyên cập nhật thông tin.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b9b5d31b5707d9abd0f1648c6a43823030f78b71b373952f0af152ec757b72de0",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Định kỳ thực hiện điều tra về tình hình việc làm của sinh viên tốt nghiệp.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b9b9135084cc54c40df18a882ef038b30957290f852fcecf2cf71cc0958d88dbc",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "3. Triển khai các hoạt động tư vấn nghề nghiệp và việc làm cho sinh viên tốt nghiệp",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b93cbd9d3e574a8f2c444331e71130b99fbef43773195a610211bd72dd2abbadc",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "text": "a) Hàng năm, tổ chức các hoạt động tư vấn nghề nghiệp và việc làm cho người học sắp tốt nghiệp.",
                  "type": "text"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b618efafd9c6945021a8950def5333fe213a8f4555e1b347b0be0748bad4fa53a",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Người học được huấn luyện, tư vấn về các kỹ năng tìm việc làm.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb654f8cb953621d8e6621782babb115d7297eef785e1c244b48de073e34e1bac",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Có mối liên hệ thường xuyên với các nhà tuyển dụng và cựu sinh viên để tư vấn, giới thiệu việc làm cho người học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b37acd83e8f790a2d06cac5bfd2e89bbe6a1f87367689072e0da297cbe7bd6087",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Chương III",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bdfa8a17e581decd30dbed5d1c0cc1f1742a8661bbbc690e5d8c00cc4efd86102",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "TỔ CHỨC THỰC HIỆN",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "center",
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb0945676fa8ee54cd47209dd809cc3b7dacd8c472cae2c6e4ecb3eabba1f77c5",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 11.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Trách nhiệm của trường thực hiện chương trình đào tạo giáo viên trung học phổ thông trình độ đại học",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b7b6b1b0ce3ad7204e36804a592e350daab5fd77f6e3a678227b1f5ff30a1ea90",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Các trường có thực hiện chương trình đào tạo giáo viên trung học phổ thông trình độ đại học phải căn cứ vào tình hình cụ thể của trường để lập kế hoạch xây dựng chương trình đạt tiêu chuẩn chất lượng giáo dục cho từng giai đoạn và có các biện pháp thực hiện tốt kế hoạch đề ra.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b5e0ede06b7d1861970e93d3b34c05b15f63b649cb0568f74551addba500d8e0a",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 12.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Trách nhiệm của các tổ chức kiểm định chất lượng giáo dục",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b8f9d972ca838fd8a2c0145fc3b8de0e741df0dbb6672dcf1d40f6ab5d9425a77",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Các tổ chức kiểm định chất lượng giáo dục căn cứ vào các tiêu chuẩn này để đánh giá, xem xét và công nhận chương trình giáo dục đạt tiêu chuẩn chất lượng giáo dục cho từng giai đoạn",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "./",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"

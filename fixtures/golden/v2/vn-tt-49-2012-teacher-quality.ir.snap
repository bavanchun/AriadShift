      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "8. Có đội ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [

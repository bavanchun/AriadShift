      "id": "b7f89cd1e67f6acdc259e3257704bdccc76dc9d4d77763a1d65621097df477fb6",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Theo đề nghị của Cục trưởng Cục Khảo thí và Kiểm định chất lượng giáo dục;",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "emph"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b0c5b3a60137f36f181079e0affc8d9ad83d02be10d8ef38341cb554f56dbdd94",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Bộ trưởng Bộ Giáo dục và Đào tạo ban hành Thông tư Quy định về tiêu chuẩn đánh giá chất lượng chương trình đào tạo giáo viên trung học phổ thông trình độ đại học.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "emph"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b71ea4e5ca4572bce428143a08c3c13a067fbefb0d6b7eeb54e27abb7700d3a1b",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 1.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "content": [
                    {
                      "text": " Ban hành kèm ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " Thông tư này Quy định về tiêu chuẩn đánh giá chất lượng chương trình đào tạo giáo viên trung học phổ thông trình độ đại học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b3e86098167fc79654966172cdcf0eb8efcf0e7a7b4b3392dff0deb3e72cd73eb",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 2.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "content": [
                    {
                      "text": " ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "Thông tư này có hiệu lực thi hành kể từ ngày 01 tháng 02 năm 2013.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be3f29d3c0241ddafb2505ab8d5cfb27d549df25ff47139d5cf2ce8d3abfb92a9",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "Thông tư này thay thế Quyết định số 03/2008/QĐ-BGDĐT ngày 04 tháng 02 năm 2008 của Bộ trưởng Bộ Giáo dục và Đào tạo ban hành Quy định về tiêu chuẩn đánh giá chất lượng chương trình đào tạo giáo viên trung học phổ thông trình độ đại học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b2a8275e05665bc0c2bd825c57520a641e2368e8c8ce0856e40389cb3a9e31d78",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 3.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "content": [
                    {
                      "text": " Chánh Văn phòng, Cục trưởng Cục Khảo thí và Kiểm định chất lượng giáo dục, Thủ trưởng các đơn vị có liên quan thuộc Bộ Giáo dục và Đào tạo; Chủ tịch Ủy ban nhân dân tỉnh, thành phố trực thuộc Trung ương; Thủ trưởng các cơ quan quản lý các đại học, học viện, trường đại học; Giám đốc các đại học, học viện, Hiệu trưởng các trường đại học có thực hiện chương trình đào tạo giáo viên trung học phổ thông trình độ đại học; Giám đốc các tổ chức kiểm định chất lượng giáo dục chịu trách nhiệm thi hành Thông tư này./.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],

      },
      "id": "b36e68ae35ac273af343b0623c8db7eceb7208472c628eb9565865777dca39836",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "7. Giảng viên được định kỳ đánh giá năng lực và được tạo điều kiện để hoàn thành nhiệm vụ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be28b5c647a4fcc55add692106964661120e4769bddfe870a2f2c719d0d93d69e",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Định kỳ tổ chức đánh giá về chất lượng giảng dạy của giảng viên trên cơ sở đánh giá của đồng nghiệp và của sinh viên.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b9b7f1aa5318771c8e365448c0df6f323c6fdd7b3c340ddb51508ebeef1ddc47c",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có các biện pháp hỗ trợ, tạo điều kiện để giảng viên hoàn thành nhiệm vụ giảng dạy.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bc3babbff7aa1ee154ad6193920cbfdc88dad1fcb32156c0b4c613074b238206e",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Giảng viên được hỗ trợ và tạo điều kiện trong việc hướng dẫn nghiên cứu khoa học và thực tập sư phạm.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",

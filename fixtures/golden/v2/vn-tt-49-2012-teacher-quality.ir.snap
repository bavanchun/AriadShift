                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " giảng viên đạt tiêu chuẩn về phẩm chất chính trị tư tưởng; được tham gia các lớp bồi dưỡng, học tập chính trị.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },

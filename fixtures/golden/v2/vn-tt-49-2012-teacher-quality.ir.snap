      },
      "id": "b134ae5e96a38e789138baa08b0da8883d1efb50fa13df92921272e0441565e85",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Căn cứ Nghị định số 75/2006/NĐ-CP ngày 02 tháng 8 năm 2006 của Chính phủ quy định chi tiết và hướng dẫn thi hành một số điều của Luật ",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": "g",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": "iáo dục;",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " ",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": "Nghị định số 31/2011/NĐ-CP ngày 11 tháng 5 năm 2011 của Chính phủ về việc sửa đổi, bổ sung một số điều của Nghị định số 75/2006/NĐ-CP ngày 02 tháng 8 năm 2006 của Chính phủ quy định chi tiết và hướng dẫn thi hành một số điều của Luật Giáo dục;",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "italic": true,
                        "size_pt": 14.0
                      },
                      "type": "styled"
                    }

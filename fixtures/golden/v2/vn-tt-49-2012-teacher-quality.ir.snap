    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "content": [
                        {
                          "text": "Điều 1.",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Phạm ",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": "vi",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " điều chỉnh và đối tượng áp dụng",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    }
                  ],

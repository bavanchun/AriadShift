                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "ngũ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " nhân viên thực hiện có hiệu quả nhiệm vụ được giao.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {

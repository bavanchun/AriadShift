      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Giảng viên được phân công giảng dạy đúng ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " năng lực chuyên môn được đào tạo.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b813faccac24671b14317463a63fbe69e73676a1fec1b56e5c6f5befe783471c9",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Giảng viên được tạo điều kiện nâng cao trình độ chuyên môn, nghiệp vụ.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b3bc9ce096851037636b04ef8cbed255db58df1a9647e11e1c72b98e237f4f6db",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Giảng viên được tạo điều kiện nâng cao trình độ chính trị, ngoại ngữ và tin học.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b38bdedfb11ce9e40f379785d3cc9b45ebb78882690b64e9f97ed43f6f5019b77",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "6. Giảng viên được đảm bảo các quyền và lợi ích ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định của pháp luậ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "t.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "be3ee861bf2d46c8bb703e8b7360d665b261bf98b8a44313fe7ab607dd97a7d78",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Các chủ trương, chính sách về quyền và lợi ích liên quan đến hoạt động nghề nghiệp của giảng viên được phổ biến đầy đủ, kịp thời.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bb2075b9838a3d8324cdf6599a6badf53a9e91bc53a03e43708f1052eaadf8c55",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Có những biện pháp cụ thể để đảm bảo quyền và lợi ích liên quan đến hoạt động nghề nghiệp của giảng viên.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b8545ce29bf0fc742e399d3d10486f19570fa1b9bde61d4058361873d3509881f",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Việc xử lý các đơn ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "thư",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " khiếu nại về quyền và lợi ích của giảng viên được thực hiện đúng theo quy định.",
                      "type": "text"
                    }
                  ],
                  "direct": {

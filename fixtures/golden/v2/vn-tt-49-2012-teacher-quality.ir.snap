                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },
                    {
                      "content": [
                        {
                          "text": " Tiêu chuẩn 3: Đội ",
                          "type": "text"
                        }
                      ],
                      "direct": {
                        "size_pt": 14.0,
                        "weight": 700
                      },
                      "type": "styled"
                    },

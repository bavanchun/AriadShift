    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "4. Giảng viên thực hiện tốt các nhiệm vụ được giao",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0

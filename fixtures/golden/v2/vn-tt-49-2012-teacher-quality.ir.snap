      },
      "id": "bd6021bcef765e2871c1cc51070497e3efe829a173eec7abb41e7089cfec7b1d5",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "a) Giảng viên thực hiện đầy đủ và có chất lượng chương trình đào tạo.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b69736c4e01c3d41ce1bc8086a800dbb878e407bc183b454b4115a64722711ba1",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "b) Giảng viên tích cực tham gia xây dựng kế hoạch đào tạo, biên soạn giáo trình, tài liệu giảng dạy của khoa, bộ môn.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "bbd15d936d6d4550719c6ad41b048f1c896b1e7b4b8c1fb6ee877c290e4dd4e85",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "c) Hàng năm, giảng viên tham gia nghiên cứu khoa học ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": "theo",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": " quy định.",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b162578d314bf3da5b81a385b77b18dacbba1c48158676002183f8a92480c3ee7",
      "style": "s6fe525545abf8c3750cce2a413aa0bdc4316a03df2925e5ffe78d0b586d17bc7",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "content": [
            {
              "content": [
                {
                  "content": [
                    {
                      "text": "5. Giảng viên được phân công giảng dạy hợp lý và được tạo điều kiện nâng cao trình độ",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                },
                {
                  "content": [
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ],
                  "direct": {
                    "size_pt": 14.0
                  },
                  "type": "styled"
                }
              ],
              "direct": {
                "size_pt": 14.0
              },
              "type": "styled"
            }
          ],
          "style": "pRun3745c105a8997c2144a1ff94f12aa7de4f5c0b89c8339bfa7a53b2d4564272f1",
          "type": "styled"
        }
      ],
      "direct": {
        "align": "justify",
        "indent_first_pt": 36.0,
        "size_pt": 14.0,
        "space_after_pt": 0.0,
        "space_before_pt": 6.0
      },
      "id": "b1c80c514ac34f5b56b4360890fee43fca2a8677ba5c1a4acac1b2be6a161cb5d",

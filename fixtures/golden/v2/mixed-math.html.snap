  font-family: ui-monospace, monospace;
}
pre {
  padding: 1rem;
  background: #f4f4f4;
  overflow-x: auto;
  border-radius: 4px;
}
table {
  border-collapse: collapse;
  width: 100%;
  margin: 1rem 0;
}
th, td {
  border: 1px solid #ddd;
  padding: 0.5rem;
  text-align: left;
}

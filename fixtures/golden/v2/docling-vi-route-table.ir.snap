                "id": "bf8a6205a87e623221b11f0b624ff8f8b65de01d5bb39b915d9926811f45d4542",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Có ghế dài",
                    "type": "text"
                  }
                ],
                "id": "b8ada13c0008fc6118adf000431f6cb33d7f9c20870ed182116f6906a371d1457",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Lịch khảo sát cập nhật mỗi tháng.",
                    "type": "text"
                  }
                ],
                "id": "b35e65924858d30149cd2622dd82a60ec7a3388f5d3948d328fc28add27fd67a6",
                "type": "paragraph"

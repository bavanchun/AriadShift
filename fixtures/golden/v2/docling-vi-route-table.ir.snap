  "body": [
    {
      "content": [
        {
          "text": "Bảng hành trình ven sông",
          "type": "text"
        }
      ],
      "id": "b589117f1cb8afea14acade94bfea93a60d057217b5e0fcc55ef5cd21e5e2db1a",
      "level": 2,
      "type": "heading"
    },
    {
      "content": [
        {
          "text": "Thành phố nhỏ thức dậy trước tiếng chuông xe đạp. Người bán hàng kéo tấm bạt xanh ra khỏi quầy, còn mặt sông giữ lại màu hồng nhạt của bình minh. Từ bến đá, con đường lát gạch men theo hàng me rồi vòng qua cây cầu gỗ.",
          "type": "text"
        }
      ],
      "id": "b3f679e43d3aed20f7d36a744c4e16a0fd9c811e79b07cab2e9fa225d01f99bcb",
      "type": "paragraph"
    },
    {
      "body": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Bến sông",
                    "type": "text"
                  }
                ],
                "id": "bfc4eeabe6629356b1ca2573b02f1c0bee4b33c618cb544089f2f234bc3169503",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "8",
                    "type": "text"
                  }
                ],
                "id": "bdc08934c2376314679d895ee88a79f77aff6388570b99c36723d3e9b9898087d",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Bóng mát",
                    "type": "text"
                  }
                ],
                "id": "be10950478710c395747089830d14415fc57e3d7067bdc4c03238a3ef7256b844",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Vườn đọc",
                    "type": "text"
                  }
                ],
                "id": "be71a0908a4dbc59f931fdcfe3cd127fca7c0231871fa6561f9b1f0416c8bfb98",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [

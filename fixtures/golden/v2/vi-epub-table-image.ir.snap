    {
      "asset": {
        "id": "6bca795730900c41e97ac33d04db2b054019dcd598e0e57f98dbc958e94291fb",
        "type": "asset"
      },
      "caption": [
        {
          "text": "Sơ đồ tuyến đường ven sông",
          "type": "text"
        }
      ],
      "id": "b8f2ccaa0f867aae889fe5b8aed03c0bccbdc2c940433a061c3e61c76aa752664",
      "type": "figure"
    },
    {
      "content": [
        {
          "text": "Lan thường đi chậm ở đoạn này. Cô ghi lại những thay đổi của bờ sông trong một cuốn sổ: bậc thềm mới, chiếc đèn được thay, và lối nhỏ vừa mở cạnh nhà kho. Mỗi ghi chú giúp người sau tìm đường dễ hơn.",
          "type": "text"
        }
      ],
      "id": "b43fe106b819702b6caf1f168fcacc7133d7ff3ad9a45e3ebffd7d748bb836a7c",
      "type": "paragraph"
    }

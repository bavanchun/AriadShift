                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ],
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Sách nấu ăn",
                    "type": "text"
                  }
                ],
                "id": "b2d0600fa2cc6c076ccd7c8385e3ce660382de897ec8bc33a4f7e48f7679e29ad",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {

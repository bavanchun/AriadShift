{
  "assets": {},
  "body": [
    {
      "content": [
        {
          "text": "Khu vườn đọc sách",
          "type": "text"
        }
      ],
      "id": "b9cb599a22b1d3167f6caf6fa1985623035ccf985c9db7db2b8baaac672aa5495",
      "level": 1,
      "type": "heading"
    },
    {
      "content": [
        {
          "text": "Một khoảng sân nhỏ sau thư viện phường",
          "type": "text"
        }
      ],
      "id": "bb351914c14e19b677c7a39e5264648aba0b67c515b252e85fec91f166e2cdb58",
      "type": "paragraph"
    },
    {
      "content": [
        {
          "text": "Lịch chăm vườn",
          "type": "text"
        }
      ],
      "id": "bc8f170ccd43a23e2a6339922a3b8b3f8f437322901d09a5aa8ccc360c5d64a0f",
      "level": 1,
      "type": "heading"
    },
    {
      "id": "b5d1fc1853e1da191c3f7b11beba0e8a54c6c643ec7d877d5524df2ba2ce7f0de",
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Thứ bảy: tưới cây và đổi sách",
                  "type": "text"
                }
              ],
              "id": "b38b9aae65a99249ac37f19b6bf75ea433657acc4cf52efb693f85fe95cbd826b",
              "type": "paragraph"
            }
          ],
          "checked": null
        },
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Ngày nắng: học bài dưới giàn hoa giấy",
                  "type": "text"
                }
              ],
              "id": "bbbc7fc8f4dd05b36e353f0c80e7434aa86fcfafedd5c214679515b7c19b3f601",
              "type": "paragraph"
            }
          ],
          "checked": null
        },
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Ngày mưa: chuyển vào mái hiên",
                  "type": "text"
                }
              ],
              "id": "b8e54671d26ff9e703e4e719a2d31325864eec7db1fb7350e5798347e21af1cc7",
              "type": "paragraph"
            }
          ],
          "checked": null
        }
      ],
      "ordered": false,
      "start": null,
      "tight": true,
      "type": "list"
    },
    {
      "content": [
        {
          "text": "Sách được đổi trong tháng",
          "type": "text"
        }
      ],
      "id": "bf50f7eab6fa9aaddd32d2e9b6105e952350f456c566eee29be6f0e3151c58140",
      "level": 1,
      "type": "heading"
    },
    {
      "body": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Truyện tranh",
                    "type": "text"
                  }
                ],
                "id": "b9b465b49b6120962f1eb8cfb4aeeb7e1e94574211ccdeb1c2ea2b4ee46012ee4",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {

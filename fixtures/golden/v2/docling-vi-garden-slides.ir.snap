      ],
      "head": [
        [
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Loại sách",
                    "type": "text"
                  }
                ],
                "id": "be902aa8f811abd8ccbcc2f808c9eba5de9776dbdfc254e66e4fdbaa9652c7800",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          },
          {
            "blocks": [
              {
                "content": [
                  {
                    "text": "Số quyển",
                    "type": "text"
                  }
                ],
                "id": "bcf93ef601be6e62057fcdbd43894a439b2e2495bdcde2a9d06ed35bd0a5ef8dc",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ]
      ],
      "id": "b0b0f6667c5987e7cd3861eda24ca07f3ef5d42af62c2af84d7e241a63094698e",
      "type": "table"
    },
    {
      "content": [
        {
          "text": "Ghi chép",
          "type": "text"
        }
      ],
      "id": "bb84d6803a3baaa1d95fd92a49223e3a0afb502f32b7b3d458369f8afa3997b79",
      "level": 1,
      "type": "heading"
    },
    {
      "id": "bfcb6b4022c4ab6f080f33d9724b95a2199255d0295252bbe1501ea99f8cfe716",
      "items": [
        {
          "blocks": [
            {
              "content": [
                {
                  "text": "Mỗi sáng thứ bảy, một nhóm hàng xóm tưới cây và đổi sách. Trẻ nhỏ chọn truyện tranh; người lớn mang đến sách nấu ăn, bản đồ cũ và tạp chí khoa học. Những quyển sách được bọc giấy nâu để mưa không làm cong góc.",
                  "type": "text"
                }
              ],
              "id": "beff7c6afc9dbcbc05400a042e5bb1209fedea46884be5719dc85d9263e3b55fa",
              "type": "paragraph"
            }
          ],
          "checked": null
        }
      ],
      "ordered": false,
      "start": null,
      "tight": true,
      "type": "list"
    }

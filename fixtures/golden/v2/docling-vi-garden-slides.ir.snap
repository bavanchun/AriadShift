                "id": "bb4b0edddcc847ab887d2a6bee0845313b5748368b12ced9b1ddcea4dc0cd17fc",
                "type": "paragraph"
              }
            ],
            "colspan": 1,
            "rowspan": 1
          }
        ]
      ],
      "caption": null,
      "columns": [
        {

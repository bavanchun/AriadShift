# Environment for the self-hosted stack in infra/compose. Copy this file to
# infra/compose/.env and replace every "replace-with" value before you expose
# the stack to anyone. docs/self-hosting.md explains each setting.
#
# Generate each secret with:  openssl rand -hex 32
# Database passwords appear inside connection URLs, so keep them to letters
# and digits (hex output is safe).

# Profiles to start. core is always needed. office adds the LibreOffice
# worker; docling adds the OCR worker and the office worker it builds on.
# List the packs that have running workers in ARIAD_PACKS:
#   core -> core | core,office -> core,office | core,docling -> core,office,docling
COMPOSE_PROFILES=core
ARIAD_PACKS=core

# Host address the published ports bind to. 127.0.0.1 keeps the stack local;
# put a reverse proxy with TLS in front before you change it.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8080
AUTH_PORT=3001
S3_PORT=8333

# Public URLs, as a browser reaches each service.
ARIAD_WEB_ORIGIN=http://localhost:3000
ARIAD_PUBLIC_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:3001
ARIAD_S3_PUBLIC_ENDPOINT=http://localhost:8333

# PostgreSQL. The superuser runs migrations and grants only; each runtime
# service connects with its own login.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32-postgres
ARIAD_API_DB_PASSWORD=replace-with-openssl-rand-hex-32-api
ARIAD_WORKER_DB_PASSWORD=replace-with-openssl-rand-hex-32-worker
AUTH_DB_PASSWORD=replace-with-openssl-rand-hex-32-auth

# SeaweedFS S3. The key may only use the one bucket.
S3_BUCKET=ariadshift
S3_ACCESS_KEY_ID=ariadshift
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32-s3

# API signing secret, at least 32 bytes.
ARIAD_SECRET=replace-with-openssl-rand-hex-32-ariad-secret

# Better Auth signing and encryption secret, at least 32 characters.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32-better-auth
# WebAuthn relying-party id for passkeys. Leave empty to use the host of
# ARIAD_WEB_ORIGIN; set a parent domain to share passkeys across subdomains.
AUTH_PASSKEY_RP_ID=

# Optional sign-in providers. Leave empty to keep email and password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anonymous small-file conversions. Set a Cloudflare Turnstile secret to
# require a challenge on anonymous uploads (needs outbound internet).
ARIAD_ANONYMOUS=true
ARIAD_TURNSTILE_SECRET=
# Set only behind a proxy that overwrites this header, e.g. CF-Connecting-IP.
# The API and the auth service both read the client address from it.
ARIAD_TRUSTED_CLIENT_IP_HEADER=

# Container sizing. Docling needs the most; see docs/server.md.
API_MEMORY=1g
WORKER_CORE_MEMORY=4g
WORKER_CORE_WORK_SIZE=2g
WORKER_OFFICE_MEMORY=8g
WORKER_OFFICE_WORK_SIZE=4g
WORKER_DOCLING_MEMORY=20g
WORKER_DOCLING_WORK_SIZE=12g

RUST_LOG=info

# Published images instead of local builds (then run `pull` and `up --no-build`).
# ARIADSHIFT_SERVER_IMAGE=ghcr.io/OWNER/ariadshift-api:vX.Y.Z
# ARIADSHIFT_WORKER_OFFICE_IMAGE=ghcr.io/OWNER/ariadshift-worker-office:vX.Y.Z
# ARIADSHIFT_WORKER_DOCLING_IMAGE=ghcr.io/OWNER/ariadshift-worker-docling:vX.Y.Z
# ARIADSHIFT_AUTH_IMAGE=ghcr.io/OWNER/ariadshift-auth:vX.Y.Z
# ARIADSHIFT_WEB_IMAGE=ghcr.io/OWNER/ariadshift-web:vX.Y.Z
